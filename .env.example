# =================================================================
# HOUSTON WEB SERVICES - ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env and update with your actual values.
# Never commit the actual .env file to version control.
# =================================================================

# =================================================================
# GOOGLE ANALYTICS 4
# =================================================================
# Your GA4 Measurement ID (format: G-XXXXXXXXXX)
# Get this from Google Analytics: Admin > Data Streams > Web Stream
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# =================================================================
# SITE CONFIGURATION
# =================================================================
# Production site URL (used for canonical URLs and social sharing)
PUBLIC_SITE_URL=https://houston-web-services.com

# =================================================================
# CONTACT INFORMATION (Optional - for structured data)
# =================================================================
# PUBLIC_CONTACT_EMAIL=hello@houston-web-services.com
# PUBLIC_CONTACT_PHONE=+1-713-555-0123

# =================================================================
# FORMSPREE CONTACT FORM
# =================================================================
# Your Formspree form endpoint ID (format: xyzabcde or full URL)
# Get this from Formspree: https://formspree.io/forms
# Example: PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xyzabcde
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# =================================================================
# SOCIAL MEDIA (Optional)
# =================================================================
# PUBLIC_TWITTER_HANDLE=@houstonweb
# PUBLIC_FACEBOOK_URL=https://facebook.com/houstonwebservices
# PUBLIC_LINKEDIN_URL=https://linkedin.com/company/houston-web-services

# =================================================================
# BOOKING CALENDAR
# =================================================================
# Third-party scheduling widget for appointment booking
# Supported providers: calendly, acuity, custom
#
# Calendly: Use your Calendly scheduling page URL
# Example: https://calendly.com/your-username
#
# Acuity: Use your Acuity scheduling page URL
# Example: https://app.acuityscheduling.com/schedule.php?owner=YOUR_ID
#
PUBLIC_BOOKING_CALENDAR_PROVIDER=calendly
PUBLIC_BOOKING_CALENDAR_URL=https://calendly.com/your-username

# =================================================================
# NEWSLETTER SIGNUP
# =================================================================
# Enable/disable newsletter functionality
# Set to 'false' to disable newsletter signup forms entirely
PUBLIC_NEWSLETTER_ENABLED=true

# Newsletter provider: mailchimp, convertkit, or formspree
# Choose your preferred email service provider
PUBLIC_NEWSLETTER_PROVIDER=formspree

# Formspree endpoint for newsletter signups
# Get this from Formspree: https://formspree.io/forms
# Example: PUBLIC_NEWSLETTER_ENDPOINT=https://formspree.io/f/xyzabcde
PUBLIC_NEWSLETTER_ENDPOINT=https://formspree.io/f/YOUR_NEWSLETTER_FORM_ID

# ConvertKit Configuration (if using ConvertKit)
# PUBLIC_CONVERTKIT_FORM_ID=your_form_id

# Mailchimp Configuration (if using Mailchimp)
# Note: Mailchimp requires server-side API calls
# MAILCHIMP_API_KEY=your_api_key
# MAILCHIMP_AUDIENCE_ID=your_audience_id
# MAILCHIMP_SERVER_PREFIX=us1

# =================================================================
# GOOGLE BUSINESS REVIEWS
# =================================================================
# Configuration for displaying Google Business reviews on the website
#
# Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# Note: Fetching live reviews requires a Google Places API key and server-side implementation
#
PUBLIC_GOOGLE_PLACE_ID=YOUR_GOOGLE_PLACE_ID
PUBLIC_GOOGLE_BUSINESS_URL=https://g.page/your-business

# =================================================================
# FACEBOOK PAGE PLUGIN
# =================================================================
# Embed Facebook Page plugin showing recent posts, page likes,
# and social proof. Helps build community connection and
# cross-platform engagement.
#
# To get started:
# 1. Create a Facebook Page for your business (if you haven't already)
# 2. Copy your Facebook Page URL below
# 3. Optionally create a Facebook App for enhanced features
#
# Facebook Page URL (required)
# Example: https://www.facebook.com/YourPageName
PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/YourPageName

# Facebook App ID (optional - for enhanced analytics and features)
# Create an app at: https://developers.facebook.com/
# PUBLIC_FACEBOOK_APP_ID=your_app_id

# Enable/disable Facebook Page plugin (default: true)
# Set to 'false' to disable the Facebook Page plugin entirely
# PUBLIC_FACEBOOK_PAGE_ENABLED=true

# =================================================================
# INSTAGRAM FEED
# =================================================================
# Display recent Instagram posts in a grid gallery format.
# Showcases behind-the-scenes work and builds visual brand presence.
#
# The Instagram Basic Display API is used to fetch posts.
# Access tokens must be refreshed periodically (every 60 days).
#
# To obtain an access token:
# 1. Create a Facebook Developer App: https://developers.facebook.com/
# 2. Add Instagram Basic Display product to your app
# 3. Add yourself as an Instagram Test User
# 4. Generate a User Token
# 5. Exchange for a Long-Lived Token (valid for 60 days)
#
# Documentation: https://developers.facebook.com/docs/instagram-basic-display-api
#
# Instagram Basic Display API Access Token (required for live feed)
# PUBLIC_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
#
# Instagram username for profile link (without @)
# Example: houstonwebservices
PUBLIC_INSTAGRAM_USERNAME=your_instagram_username
#
# Enable/disable Instagram Feed (default: true)
# Set to 'false' to disable the Instagram Feed entirely
# PUBLIC_INSTAGRAM_FEED_ENABLED=true
