        var(--color-primary-900) 0%,
        var(--color-primary-700) 35%,
        var(--color-primary-800) 65%,
        var(--color-primary-900) 100%
      );
    overflow: hidden;
  }

  /* Subtle radial overlays for depth */
  .services-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 100% 80% at 80% 20%,
        rgba(14, 165, 233, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 80% 60% at 20% 80%,
        rgba(6, 182, 212, 0.1) 0%,
