    </section>

    <!-- Services Overview Section - Enhanced Cards -->
    <section id="services" class="services-overview" aria-labelledby="services-overview-heading">
      <div class="services-overview__container">
        <header class="services-overview__header">
          <div class="services-overview__header-wrapper">
            <h2 id="services-overview-heading" class="services-overview__heading">
              Our Plumbing Services
