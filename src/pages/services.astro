---
/**
 * Services Page
 * A comprehensive page showcasing the services offered.
 *
 * Sections:
 * 1. Hero Section - Value proposition and overview
 * 2. Services Overview - Service cards grid
 * 3. Service Detail Sections - Individual service breakdowns
 * 4. CTA Section - Contact for custom needs
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import type { ServiceSchema, ServiceArea, OpeningHoursSpecification } from '../types/seo';
import { localBusinessSchema } from '../config/seo.config';

/**
 * Consolidated service data for the unified services page.
 * Each service includes condensed content extracted from the individual service pages.
 */

interface ServiceData {
  id: string;
  name: string;
  slug: string;
  shortDescription: string;
  benefits: string[];
  startingPrice: string;
  priceNote: string;
  icon: string;
  ctaText: string;
  ctaHref: string;
}

const services: ServiceData[] = [
  {
    id: 'service-one',
    name: 'Service One',
    slug: 'service-one',
    shortDescription: 'A brief description of Service One and how it helps your customers. Explain the value proposition and key outcomes clients can expect from this service.',
    benefits: [
      'Key benefit or feature of Service One',
      'Another important advantage for clients',
      'A third reason to choose this service',
      'Additional value this service provides',
    ],
    startingPrice: '$99',
    priceNote: 'Starting at',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`,
    ctaText: 'Get Started',
    ctaHref: '/contact?service=service-one',
  },
  {
    id: 'service-two',
    name: 'Service Two',
    slug: 'service-two',
    shortDescription: 'A brief description of Service Two and the problems it solves. Highlight what makes this service unique and the results clients can achieve.',
    benefits: [
      'Key benefit or feature of Service Two',
      'Another important advantage for clients',
      'A third reason to choose this service',
      'Additional value this service provides',
    ],
    startingPrice: '$199',
    priceNote: '/month',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>`,
    ctaText: 'Learn More',
    ctaHref: '/contact?service=service-two',
  },
  {
    id: 'service-three',
    name: 'Service Three',
    slug: 'service-three',
    shortDescription: 'A brief description of Service Three and its core offering. Describe who this service is for and the transformation it delivers.',
    benefits: [
      'Key benefit or feature of Service Three',
      'Another important advantage for clients',
      'A third reason to choose this service',
      'Additional value this service provides',
    ],
    startingPrice: '$499',
    priceNote: 'One-time',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>`,
    ctaText: 'Get Started',
    ctaHref: '/contact?service=service-three',
  },
];


// Service area configuration (shared across all services)
// TODO: Configure with your actual service areas
const serviceAreaConfig: ServiceArea[] = [];

// Service availability/hours (shared across all services)
const serviceHoursConfig: OpeningHoursSpecification[] = [
  { dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
];

// Provider information (from LocalBusiness schema)
const providerInfo = {
  type: 'ProfessionalService' as const,
  name: localBusinessSchema.name,
  url: localBusinessSchema.url,
  telephone: localBusinessSchema.telephone,
  address: localBusinessSchema.address,
  priceRange: localBusinessSchema.priceRange,
};

/**
 * Generate Service schemas for all services on this page
 * Each service gets its own structured data for rich search results
 */
const serviceSchemas: ServiceSchema[] = services.map((service) => {
  // Parse the price from the startingPrice string (e.g., "$499" -> 499)
  const priceMatch = service.startingPrice.match(/[\d,.]+/);
  const priceValue = priceMatch ? parseFloat(priceMatch[0].replace(/,/g, '')) : undefined;

  // Get related services (all services except the current one)
  const relatedServices = services
    .filter((s) => s.id !== service.id)
    .map((s) => s.name);

  return {
    type: 'Service',
    name: service.name,
    description: service.shortDescription,
    url: `/services#${service.id}`,
    serviceType: service.name,
    provider: providerInfo,
    offers: {
      price: priceValue,
      priceCurrency: 'USD',
      priceSpecification: service.priceNote,
      availability: 'InStock',
      url: service.ctaHref,
    },
    areaServed: serviceAreaConfig,
    hoursAvailable: serviceHoursConfig,
    hasOfferCatalog: service.benefits.length > 0
      ? {
          name: `${service.name} Features`,
          itemListElement: service.benefits,
        }
      : undefined,
    isRelatedTo: relatedServices,
    audience: {
      type: 'BusinessAudience',
      name: 'Small Businesses',
      audienceType: 'Small Business Owners',
    },
  } as ServiceSchema;
});
---

<Layout
  title="Our Services"
  description="Professional services for your business. Get the expert support and solutions your business needs to succeed."
  openGraph={{
    type: 'website',
  }}
  jsonLd={serviceSchemas}
>
  <main>
    <!-- Services Hero Section - Unique to Services Page -->
    <section class="services-hero" aria-labelledby="services-hero-heading">
      <div class="services-hero__container">
        <div class="services-hero__content">
          <div class="services-hero__badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>Transparent Pricing • No Hidden Costs</span>
          </div>
          <h1 id="services-hero-heading" class="services-hero__title">
            Professional Services<br/>
            <span class="services-hero__title-highlight">For Your Business</span>
          </h1>
          <p class="services-hero__description">
            We provide a full range of professional services designed to help your business succeed and grow.
          </p>
          <div class="services-hero__cta-group">
            <Button
              text="Explore Services"
              href="#services"
              variant="primary"
              size="large"
            />
            <Button
              text="Get in Touch"
              href="/service-business/contact"
              variant="secondary"
              size="large"
            />
          </div>
          <div class="services-hero__stats">
            <div class="services-hero__stat">
              <span class="services-hero__stat-value">3+</span>
              <span class="services-hero__stat-label">Services</span>
            </div>
            <div class="services-hero__stat-divider"></div>
            <div class="services-hero__stat">
              <span class="services-hero__stat-value">Local</span>
              <span class="services-hero__stat-label">Locally Based</span>
            </div>
            <div class="services-hero__stat-divider"></div>
            <div class="services-hero__stat">
              <span class="services-hero__stat-value">100%</span>
              <span class="services-hero__stat-label">Satisfaction</span>
            </div>
          </div>
        </div>
        <div class="services-hero__visual" aria-hidden="true">
          <div class="services-hero__cards-preview">
            <div class="services-hero__preview-card services-hero__preview-card--1">
              <div class="services-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </div>
              <span class="services-hero__preview-label">Service One</span>
              <span class="services-hero__preview-price">From $99</span>
            </div>
            <div class="services-hero__preview-card services-hero__preview-card--2">
              <div class="services-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                </svg>
              </div>
              <span class="services-hero__preview-label">Service Two</span>
              <span class="services-hero__preview-price">From $199/mo</span>
            </div>
            <div class="services-hero__preview-card services-hero__preview-card--3">
              <div class="services-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
              </div>
              <span class="services-hero__preview-label">Service Three</span>
              <span class="services-hero__preview-price">From $499</span>
            </div>
          </div>
        </div>
      </div>
      <div class="services-hero__decoration" aria-hidden="true"></div>
    </section>

    <!-- Services Overview Section -->
    <section id="services" class="services-overview" aria-labelledby="services-overview-heading">
      <div class="services-overview__container">
        <header class="services-overview__header">
          <div class="services-overview__header-wrapper">
            <h2 id="services-overview-heading" class="services-overview__heading">
              What We Offer
            </h2>
          </div>
          <p class="services-overview__description">
            We provide a full range of professional services for businesses. Every project includes personalized service, expert execution, and solutions built to last.
          </p>
        </header>

        <!-- Services Cards Grid -->
        <div class="services-overview__cards">
          {services.map((service) => (
            <ServiceCard
              id={service.id}
              title={service.name}
              description={service.shortDescription}
              icon={service.icon}
              cta={{
                text: service.ctaText,
                href: service.ctaHref,
              }}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Service One Detail Section -->
    <section id="service-one" class="service-detail" aria-labelledby="service-one-heading">
      <div class="service-detail__container">
        <div class="service-detail__content">
          <div class="service-detail__icon" aria-hidden="true" set:html={services[0].icon} />
          <h2 id="service-one-heading" class="service-detail__heading">
            {services[0].name}
          </h2>
          <p class="service-detail__description">
            {services[0].shortDescription}
          </p>
          <ul class="service-detail__benefits">
            {services[0].benefits.map((benefit) => (
              <li class="service-detail__benefit">
                <svg class="service-detail__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
                {benefit}
              </li>
            ))}
          </ul>
          <div class="service-detail__pricing">
            <span class="service-detail__price">{services[0].startingPrice}</span>
            <span class="service-detail__price-note">{services[0].priceNote}</span>
          </div>
          <div class="service-detail__cta">
            <Button
              text={services[0].ctaText}
              href={services[0].ctaHref}
              variant="primary"
              size="large"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Service Two Detail Section -->
    <section id="service-two" class="service-detail" aria-labelledby="service-two-heading">
      <div class="service-detail__container">
        <div class="service-detail__content">
          <div class="service-detail__icon" aria-hidden="true" set:html={services[1].icon} />
          <h2 id="service-two-heading" class="service-detail__heading">
            {services[1].name}
          </h2>
          <p class="service-detail__description">
            {services[1].shortDescription}
          </p>
          <ul class="service-detail__benefits">
            {services[1].benefits.map((benefit) => (
              <li class="service-detail__benefit">
                <svg class="service-detail__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
                {benefit}
              </li>
            ))}
          </ul>
          <div class="service-detail__pricing">
            <span class="service-detail__price">{services[1].startingPrice}</span>
            <span class="service-detail__price-note">{services[1].priceNote}</span>
          </div>
          <div class="service-detail__cta">
            <Button
              text={services[1].ctaText}
              href={services[1].ctaHref}
              variant="primary"
              size="large"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Service Three Detail Section -->
    <section id="service-three" class="service-detail" aria-labelledby="service-three-heading">
      <div class="service-detail__container">
        <div class="service-detail__content">
          <div class="service-detail__icon" aria-hidden="true" set:html={services[2].icon} />
          <h2 id="service-three-heading" class="service-detail__heading">
            {services[2].name}
          </h2>
          <p class="service-detail__description">
            {services[2].shortDescription}
          </p>
          <ul class="service-detail__benefits">
            {services[2].benefits.map((benefit) => (
              <li class="service-detail__benefit">
                <svg class="service-detail__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
                {benefit}
              </li>
            ))}
          </ul>
          <div class="service-detail__pricing">
            <span class="service-detail__price">{services[2].startingPrice}</span>
            <span class="service-detail__price-note">{services[2].priceNote}</span>
          </div>
          <div class="service-detail__cta">
            <Button
              text={services[2].ctaText}
              href={services[2].ctaHref}
              variant="primary"
              size="large"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" aria-labelledby="cta-heading">
      <div class="cta-section__container">
        <div class="cta-section__content">
          <h2 id="cta-heading" class="cta-section__heading">
            Ready to Get Started?
          </h2>
          <p class="cta-section__description">
            Let's discuss your project and find the perfect solution for your business. Schedule a free consultation today.
          </p>
          <div class="cta-section__buttons">
            <Button
              text="Get Your Free Consultation"
              href="/service-business/contact"
              variant="primary"
              size="large"
            />
            <Button
              text="Call Us Today"
              href="/service-business/contact"
              variant="secondary"
              size="large"
            />
          </div>
          <p class="cta-section__reassurance">
            No obligation. No pressure. Just a friendly conversation about your goals.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * SERVICES PAGE STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention
   */

  /* =================================================================
   * SERVICES HERO SECTION - Unique to Services Page
   * ================================================================= */

  .services-hero {
    position: relative;
    padding: var(--spacing-16) var(--spacing-4) var(--spacing-20);
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-primary-50) 50%,
      var(--color-background) 100%
    );
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
    overflow: hidden;
  }

  .services-hero__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-10);
    align-items: center;
  }

  .services-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-5);
  }

  .services-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    background-color: var(--color-success-50);
    border: 1px solid var(--color-success-200);
    border-radius: var(--radius-full);
    color: var(--color-success-700);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .services-hero__badge svg {
    color: var(--color-success-600);
  }

  .services-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .services-hero__title-highlight {
    color: var(--color-primary);
    display: block;
  }

  .services-hero__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 50ch;
    margin: 0;
  }

  .services-hero__cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    width: 100%;
    max-width: 20rem;
  }

  .services-hero__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4) var(--spacing-6);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-top: var(--spacing-2);
  }

  .services-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
  }

  .services-hero__stat-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .services-hero__stat-label {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .services-hero__stat-divider {
    width: 1px;
    height: var(--spacing-8);
    background-color: var(--color-border);
  }

  /* Visual/Cards Preview */
  .services-hero__visual {
    display: none;
  }

  .services-hero__cards-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
    overflow: hidden;
  }

  /* Gradient border glow effect on hover */
  .services-hero__cards-preview::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(
      135deg,
      var(--color-primary-400) 0%,
      var(--color-accent) 50%,
      var(--color-accent-alt) 100%
    );
    border-radius: inherit;
    opacity: 0;
    z-index: -1;
    transition: opacity var(--duration-300) var(--ease-out);
    filter: blur(8px);
  }

  .services-hero__cards-preview:hover::before {
    opacity: 0.4;
  }

  /* Shine sweep effect */
  .services-hero__cards-preview::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
