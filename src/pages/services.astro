---
/**
 * Services Page - HTX Plumbing Co.
 * Comprehensive plumbing services for Houston and the Energy Corridor
 *
 * Sections:
 * 1. Hero Section - Plumbing expertise and trust signals
 * 2. Services Overview - Service cards grid
 * 3. Service Detail Sections - Individual service breakdowns
 * 4. Testimonials Section - Customer testimonials
 * 5. Trust Badges Section - Credentials and certifications
 * 6. CTA Section - Schedule service
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import type { ServiceSchema, ServiceArea, OpeningHoursSpecification } from '../types/seo';
import type { Testimonial } from '../types/testimonial';
import { localBusinessSchema } from '../config/seo.config';

/**
 * Plumbing Service data for HTX Plumbing Co.
 */

interface ServiceData {
  id: string;
  name: string;
  slug: string;
  shortDescription: string;
  benefits: string[];
  startingPrice: string;
  priceNote: string;
  icon: string;
  ctaText: string;
  ctaHref: string;
}

// Wrench icon for Drain Cleaning
const wrenchIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>`;

// Water icon for Water Heaters
const waterIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8zm0 18c-3.35 0-6-2.57-6-6.2 0-2.34 1.95-5.44 6-9.14 4.05 3.7 6 6.79 6 9.14 0 3.63-2.65 6.2-6 6.2z"/></svg>`;

// Shield icon for Leak Detection
const shieldIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`;

// Flame icon for Gas Lines
const flameIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 23c-3.6 0-7-2.4-7-7 0-2.1.8-4 2.2-5.5.4-.4 1-.5 1.5-.1.2.2.4.4.4.7.1.3 0 .6-.1.8-1 1.1-1.5 2.5-1.5 4.1 0 2.7 2 4.5 4.5 4.5s4.5-1.8 4.5-4.5c0-3.8-3.2-7-6.1-9.4-.5-.4-.5-1.1-.1-1.5.2-.2.5-.3.8-.3.2 0 .5.1.7.2C15.9 7.5 21 12.3 21 17c0 4.1-3.9 6-9 6zM9.5 16c0 1.4 1.1 2.5 2.5 2.5s2.5-1.1 2.5-2.5c0-1.8-1.7-3.5-2.5-4.2-.8.7-2.5 2.4-2.5 4.2z"/></svg>`;

const services: ServiceData[] = [
  {
    id: 'drain-cleaning',
    name: 'Drain Cleaning & Repair',
    slug: 'drain-cleaning',
    shortDescription: 'Clogged drains slowing you down? We clear blockages fast with professional-grade equipment. From simple clogs to stubborn roots, we\'ll get your drains flowing again.',
    benefits: [
      'Same-day drain cleaning available',
      'Hydro-jetting for tough blockages',
      'Video inspection to find the problem',
      'Backed by our 100% satisfaction guarantee',
    ],
    startingPrice: '$99',
    priceNote: 'Starting price for drain cleaning',
    icon: wrenchIcon,
    ctaText: 'Clear My Drain',
    ctaHref: '/service-business/contact?service=drain-cleaning',
  },
  {
    id: 'water-heaters',
    name: 'Water Heater Services',
    slug: 'water-heaters',
    shortDescription: 'No hot water? We repair and install traditional tank and tankless water heaters. Same-day service available for most repairs—because cold showers shouldn\'t happen.',
    benefits: [
      'Tank and tankless water heaters',
      'Same-day repairs available',
      'Energy-efficient upgrades',
      'Financing options available',
    ],
    startingPrice: '$89',
    priceNote: 'Diagnostic fee (waived with repair)',
    icon: waterIcon,
    ctaText: 'Fix My Hot Water',
    ctaHref: '/service-business/contact?service=water-heaters',
  },
  {
    id: 'leak-detection',
    name: 'Leak Detection & Repair',
    slug: 'leak-detection',
    shortDescription: 'Hidden leaks can cause serious damage. We use advanced technology to locate leaks in walls, under slabs, anywhere—and fix them right the first time.',
    benefits: [
      'Non-invasive leak detection',
      'Slab leak specialists',
      'Water damage prevention',
      'Insurance claim assistance',
    ],
    startingPrice: '$149',
    priceNote: 'Starting price for leak detection',
    icon: shieldIcon,
    ctaText: 'Find My Leak',
    ctaHref: '/service-business/contact?service=leak-detection',
  },
  {
    id: 'sewer-gas-lines',
    name: 'Sewer & Gas Lines',
    slug: 'sewer-gas-lines',
    shortDescription: 'From sewer line repairs and replacements to gas line installation and leak detection. We handle the big jobs safely and professionally. Licensed and insured.',
    benefits: [
      'Sewer line repair & replacement',
      'Gas line installation & repair',
      'Trenchless sewer options',
      'Licensed gas work',
    ],
    startingPrice: '$199',
    priceNote: 'Starting price for inspections',
    icon: flameIcon,
    ctaText: 'Schedule Service',
    ctaHref: '/service-business/contact?service=sewer-gas',
  },
];

// Customer testimonials for services page
const testimonials: Testimonial[] = [
  {
    id: 'testimonial-sarah',
    name: 'Sarah M.',
    location: 'Katy, TX',
    quote: 'HTX Plumbing Co. came out same-day when our water heater died. Fair price, fixed fast. Highly recommend!',
  },
  {
    id: 'testimonial-mike',
    name: 'Mike T.',
    location: 'Energy Corridor',
    quote: 'Been using them for years. Always professional, always on time, always honest about what needs fixing.',
  },
  {
    id: 'testimonial-johnson',
    name: 'The Johnson Family',
    location: 'Memorial',
    quote: 'They found and fixed a slab leak that another company missed. Saved us thousands in potential damage.',
  },
];

// Service area configuration - Houston metro area
const serviceAreaConfig: ServiceArea[] = [
  { type: 'City', name: 'Houston' },
  { type: 'City', name: 'Katy' },
  { type: 'City', name: 'Sugar Land' },
  { type: 'City', name: 'Memorial' },
];

// Service availability/hours - Including emergency availability
const serviceHoursConfig: OpeningHoursSpecification[] = [
  { dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '19:00' },
  { dayOfWeek: ['Saturday'], opens: '08:00', closes: '17:00' },
];

// Provider information (from LocalBusiness schema)
const providerInfo = {
  type: 'LocalBusiness' as const,
  name: localBusinessSchema.name,
  url: localBusinessSchema.url,
  telephone: '(832) 555-FLOW',
  address: localBusinessSchema.address,
  priceRange: '$$',
};

/**
 * Generate Service schemas for all services on this page
 */
const serviceSchemas: ServiceSchema[] = services.map((service) => {
  const priceMatch = service.startingPrice.match(/[\d,.]+/);
  const priceValue = priceMatch ? parseFloat(priceMatch[0].replace(/,/g, '')) : undefined;

  const relatedServices = services
    .filter((s) => s.id !== service.id)
    .map((s) => s.name);

  return {
    type: 'Service',
    name: service.name,
    description: service.shortDescription,
    url: `/services#${service.id}`,
    serviceType: service.name,
    provider: providerInfo,
    offers: {
      price: priceValue,
      priceCurrency: 'USD',
      priceSpecification: service.priceNote,
      availability: 'InStock',
      url: service.ctaHref,
    },
    areaServed: serviceAreaConfig,
    hoursAvailable: serviceHoursConfig,
    hasOfferCatalog: service.benefits.length > 0
      ? {
          name: `${service.name} Features`,
          itemListElement: service.benefits,
        }
      : undefined,
    isRelatedTo: relatedServices,
    audience: {
      type: 'Audience',
      name: 'Homeowners',
      audienceType: 'Houston Area Homeowners',
    },
  } as ServiceSchema;
});
---

