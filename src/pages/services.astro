        </div>
      </div>
    </section>

    <!-- Indoor Air Quality Detail Section -->
    <section id="air-quality" class="service-detail service-detail--right" aria-labelledby="air-quality-heading">
      <div class="service-detail__container">
        <div class="service-detail__content">
          <div class="service-detail__icon service-detail__icon--cold" aria-hidden="true" set:html={services[3].icon} />
