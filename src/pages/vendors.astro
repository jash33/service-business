---
/**
 * Vendor Directory Page
 * A page showcasing recommended vendors, suppliers, and complementary
 * service providers with descriptions and contact information.
 *
 * Features:
 * - Hero section with page introduction
 * - Category filtering with URL parameters
 * - Grid of vendor cards with responsive layout
 * - Featured vendors highlighted
 * - Full SEO optimization with structured data
 * - WCAG 2.1 AA accessible
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import VendorCard from '../components/VendorCard.astro';
import {
  VENDORS,
  VENDOR_CATEGORIES,
  VENDOR_PAGE_CONFIG,
  getVendorsByCategory,
  getVendorCountByCategory,
} from '../config/vendors.config';

// Get filter from URL params
const url = Astro.url;
const selectedCategory = url.searchParams.get('category') || 'all';

// Get filtered vendors
const filteredVendors = getVendorsByCategory(selectedCategory);

// Sort vendors: featured first, then alphabetically
const sortedVendors = [...filteredVendors].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return a.name.localeCompare(b.name);
});

// Count featured vendors
const featuredCount = filteredVendors.filter(v => v.featured).length;
---

<Layout
  title="Vendor Directory"
  description={VENDOR_PAGE_CONFIG.metaDescription}
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'WebPage',
    name: 'Vendor Directory',
    description: VENDOR_PAGE_CONFIG.metaDescription,
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="vendors-hero" aria-labelledby="vendors-hero-heading">
      <div class="vendors-hero__container">
        <span class="vendors-hero__eyebrow reveal reveal--up">Partner Directory</span>
        <h1 id="vendors-hero-heading" class="vendors-hero__title reveal reveal--up reveal--delay-1">
          {VENDOR_PAGE_CONFIG.heroHeading}
        </h1>
        <p class="vendors-hero__subtitle reveal reveal--up reveal--delay-2">
          {VENDOR_PAGE_CONFIG.heroSubheading}
        </p>

        <!-- Stats -->
        <div class="vendors-hero__stats reveal reveal--up reveal--delay-3">
          <div class="vendors-hero__stat">
            <span class="vendors-hero__stat-number">{VENDORS.length}</span>
            <span class="vendors-hero__stat-label">Trusted Partners</span>
          </div>
          <div class="vendors-hero__stat">
            <span class="vendors-hero__stat-number">{VENDOR_CATEGORIES.length - 1}</span>
            <span class="vendors-hero__stat-label">Categories</span>
          </div>
          <div class="vendors-hero__stat">
            <span class="vendors-hero__stat-number">{featuredCount}</span>
            <span class="vendors-hero__stat-label">Featured Vendors</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="vendors-intro" aria-labelledby="vendors-intro-heading">
      <div class="vendors-intro__container">
        <div class="vendors-intro__content reveal reveal--up">
          <h2 id="vendors-intro-heading" class="vendors-intro__heading">
            {VENDOR_PAGE_CONFIG.sectionHeading}
          </h2>
          <p class="vendors-intro__description">
            {VENDOR_PAGE_CONFIG.sectionDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Filter Section -->
    <section class="vendors-filter" aria-labelledby="vendors-filter-heading">
      <div class="vendors-filter__container">
        <h2 id="vendors-filter-heading" class="sr-only">Filter vendors by category</h2>
        <nav class="vendors-filter__nav" aria-label="Vendor categories">
          <ul class="vendors-filter__list" role="list">
            {VENDOR_CATEGORIES.map((category) => {
              const isActive = selectedCategory === category.value;
              const count = getVendorCountByCategory(category.value);
              return (
                <li class="vendors-filter__item">
                  <a
                    href={category.value === 'all' ? '/vendors' : `/vendors?category=${category.value}`}
                    class={`vendors-filter__button ${isActive ? 'vendors-filter__button--active' : ''}`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {category.label}
                    <span class="vendors-filter__count">({count})</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </section>

    <!-- Vendors Grid Section -->
    <section class="vendors-grid-section" aria-labelledby="vendors-listing-heading">
      <div class="vendors-grid-section__container">
        <div class="vendors-grid-section__header">
          <h2 id="vendors-listing-heading" class="vendors-grid-section__title">
            {selectedCategory === 'all' ? 'All Partners' : VENDOR_CATEGORIES.find(c => c.value === selectedCategory)?.label || 'Partners'}
          </h2>
          <p class="vendors-grid-section__count">
            Showing {sortedVendors.length} {sortedVendors.length === 1 ? 'vendor' : 'vendors'}
          </p>
        </div>

        {sortedVendors.length > 0 ? (
          <div class="vendors-grid">
            {sortedVendors.map((vendor, index) => (
              <div class={`vendors-grid__item reveal reveal--up reveal--delay-${Math.min(index % 6 + 1, 4)}`}>
                <VendorCard {...vendor} />
              </div>
            ))}
          </div>
        ) : (
          <div class="vendors-empty">
            <div class="vendors-empty__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M16 16s-1.5-2-4-2-4 2-4 2"/>
                <line x1="9" y1="9" x2="9.01" y2="9"/>
                <line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
            </div>
            <h3 class="vendors-empty__heading">No vendors found</h3>
            <p class="vendors-empty__text">
              We don't have any vendors in this category yet.
              Check out our other categories or view all partners.
            </p>
            <Button
              text="View All Partners"
              href="/vendors"
              variant="secondary"
            />
          </div>
        )}
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="vendors-cta" aria-labelledby="vendors-cta-heading">
      <div class="vendors-cta__container">
        <h2 id="vendors-cta-heading" class="vendors-cta__title reveal reveal--up">
          Want to Become a Partner?
        </h2>
        <p class="vendors-cta__description reveal reveal--up reveal--delay-1">
          If you provide quality services that complement our offerings,
          we'd love to hear from you. Join our network of trusted partners.
        </p>
        <div class="vendors-cta__buttons reveal reveal--up reveal--delay-2">
          <Button
            text="Contact Us"
            href="/contact"
            variant="primary"
            size="large"
          />
          <Button
            text="View Our Services"
            href="/services"
            variant="secondary"
            size="large"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .vendors-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-16);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    text-align: center;
  }

  .vendors-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .vendors-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-4);
  }

  .vendors-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .vendors-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 auto var(--spacing-8);
    line-height: var(--line-height-relaxed);
  }

  .vendors-hero__stats {
    display: flex;
    justify-content: center;
    gap: var(--spacing-8);
    flex-wrap: wrap;
  }

  .vendors-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
  }

  .vendors-hero__stat-number {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .vendors-hero__stat-label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  /* =================================================================
   * INTRODUCTION SECTION
   * ================================================================= */
  .vendors-intro {
    padding: var(--spacing-12) var(--spacing-4) var(--spacing-8);
    background-color: var(--color-background);
  }

  .vendors-intro__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
    text-align: center;
  }

  .vendors-intro__content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .vendors-intro__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .vendors-intro__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* =================================================================
   * FILTER SECTION
   * ================================================================= */
  .vendors-filter {
    padding: var(--spacing-4) var(--spacing-4) var(--spacing-8);
    background-color: var(--color-background);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .vendors-filter__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  .vendors-filter__nav {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .vendors-filter__nav::-webkit-scrollbar {
    display: none;
  }

  .vendors-filter__list {
    display: flex;
    gap: var(--spacing-2);
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: center;
    flex-wrap: wrap;
  }

  .vendors-filter__item {
    flex-shrink: 0;
  }

  .vendors-filter__button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-2) var(--spacing-4);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-150) var(--ease-out),
      border-color var(--duration-150) var(--ease-out),
      color var(--duration-150) var(--ease-out);
  }

  .vendors-filter__button:hover {
    background-color: var(--color-primary-50);
    border-color: var(--color-primary-200);
    color: var(--color-primary);
  }

  .vendors-filter__button--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .vendors-filter__button--active:hover {
    background-color: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: var(--color-text-inverse);
  }

  .vendors-filter__button:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .vendors-filter__count {
    font-size: var(--font-size-xs);
    opacity: 0.8;
  }

  /* =================================================================
   * VENDORS GRID SECTION
   * ================================================================= */
  .vendors-grid-section {
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-20);
    background-color: var(--color-background);
  }

  .vendors-grid-section__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  .vendors-grid-section__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-8);
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .vendors-grid-section__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .vendors-grid-section__count {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .vendors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  .vendors-grid__item {
    display: flex;
  }

  /* Ensure cards stretch to fill grid cell */
  .vendors-grid__item :global(.vendor-card) {
    flex: 1;
  }

  /* =================================================================
   * EMPTY STATE
   * ================================================================= */
  .vendors-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-16) var(--spacing-4);
  }

  .vendors-empty__icon {
    width: 64px;
    height: 64px;
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-4);
  }

  .vendors-empty__icon svg {
    width: 100%;
    height: 100%;
  }

  .vendors-empty__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2);
  }

  .vendors-empty__text {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 24rem;
    margin: 0 0 var(--spacing-6);
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * CALL TO ACTION SECTION
   * ================================================================= */
  .vendors-cta {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-primary);
    text-align: center;
  }

  .vendors-cta__container {
    max-width: var(--container-3xl);
    margin: 0 auto;
  }

  .vendors-cta__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .vendors-cta__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-primary-100);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-8);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .vendors-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    justify-content: center;
    align-items: center;
  }

  /* Override secondary button colors for dark background */
  .vendors-cta :global(.btn--secondary) {
    color: var(--color-text-inverse);
    border-color: var(--color-text-inverse);
  }

  .vendors-cta :global(.btn--secondary:hover:not(.btn--disabled)) {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--color-text-inverse);
    color: var(--color-text-inverse);
  }

  /* =================================================================
   * SCREEN READER ONLY
   * ================================================================= */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */

  /* Small tablets (640px) */
  @media screen and (min-width: 640px) {
    .vendors-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vendors-cta__buttons {
      flex-direction: row;
    }
  }

  /* Large tablets and small desktops (1024px) */
  @media screen and (min-width: 1024px) {
    .vendors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .vendors-hero {
      padding: var(--spacing-12) var(--spacing-4) var(--spacing-10);
    }

    .vendors-hero__title {
      font-size: var(--font-size-3xl);
    }

    .vendors-hero__subtitle {
      font-size: var(--font-size-base);
    }

    .vendors-hero__stats {
      gap: var(--spacing-6);
    }

    .vendors-hero__stat-number {
      font-size: var(--font-size-2xl);
    }

    .vendors-intro {
      padding: var(--spacing-10) var(--spacing-4) var(--spacing-6);
    }

    .vendors-intro__heading {
      font-size: var(--font-size-2xl);
    }

    .vendors-filter {
      padding: var(--spacing-4);
    }

    .vendors-filter__list {
      justify-content: flex-start;
      flex-wrap: nowrap;
    }

    .vendors-grid-section {
      padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
    }

    .vendors-grid-section__header {
      flex-direction: column;
      gap: var(--spacing-1);
    }

    .vendors-cta {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .vendors-cta__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
