---
/**
 * About Page
 * A professional about page establishing credibility and expertise.
 *
 * Features:
 * - Professional introduction
 * - Skills and expertise showcase
 * - Call to action
 * - Full SEO optimization with structured data
 * - WCAG 2.1 AA accessible
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

/**
 * Skills organized by category for the expertise section
 */
// TODO: Replace with your actual skill categories and capabilities
const skillCategories = [
  {
    title: 'Skill Category One',
    skills: [
      { name: 'Capability 1' },
      { name: 'Capability 2' },
      { name: 'Capability 3' },
      { name: 'Capability 4' },
    ],
  },
  {
    title: 'Skill Category Two',
    skills: [
      { name: 'Capability 1' },
      { name: 'Capability 2' },
      { name: 'Capability 3' },
      { name: 'Capability 4' },
    ],
  },
  {
    title: 'Skill Category Three',
    skills: [
      { name: 'Capability 1' },
      { name: 'Capability 2' },
      { name: 'Capability 3' },
      { name: 'Capability 4' },
    ],
  },
];
---

<Layout
  title="About"
  description="Learn about our expertise and how we help businesses succeed with professional services and dedicated support."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'AboutPage',
    name: 'About Us',
    description: 'Learn about the experience and expertise behind our services — helping businesses succeed.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="about-hero" aria-labelledby="about-hero-heading">
      <div class="about-hero__container">
        <span class="about-hero__eyebrow reveal reveal--up">About Us</span>
        <h1 id="about-hero-heading" class="about-hero__title reveal reveal--up reveal--delay-1">
          About<br />Our Team
        </h1>
        <p class="about-hero__subtitle reveal reveal--up reveal--delay-2">
          Dedicated professionals committed to delivering quality results.
          We're not just service providers — we're your partners in growth.
        </p>
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="about-intro" aria-labelledby="about-intro-heading">
      <div class="about-intro__container">
        <div class="about-intro__text reveal reveal--up">
          <h2 id="about-intro-heading" class="about-intro__heading">
            Helping Businesses Succeed
          </h2>

          <div class="about-intro__bio">
            <p>
              We started with one simple goal: to give businesses
              the same quality service that large enterprises enjoy, but with the personal
              attention and care that only a dedicated partner can provide.
            </p>

            <p>
              Our passion isn't just delivering services — it's
              helping business owners like you achieve meaningful results.
              Quality work combined with a genuine understanding of your needs creates something truly special.
            </p>
          </div>

          <div class="about-intro__cta">
            <Button
              text="Let's Talk About Your Project"
              href="/service-business/contact"
              variant="primary"
              size="large"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Skills & Expertise Section -->
    <section class="about-skills" aria-labelledby="about-skills-heading">
      <div class="about-skills__container">
        <div class="about-skills__header section-heading--decorated reveal reveal--up">
          <h2 id="about-skills-heading" class="about-skills__title">
            How We Help Your Business
          </h2>
          <p class="about-skills__subtitle">
            We focus on what actually matters for business owners —
            delivering results that make a real difference for your bottom line.
          </p>
        </div>

        <div class="about-skills__grid">
          {skillCategories.map((category, index) => (
            <div class={`about-skills__category reveal reveal--up reveal--delay-${index + 1}`}>
              <h3 class="about-skills__category-title">{category.title}</h3>
              <ul class="about-skills__list" role="list">
                {category.skills.map((skill) => (
                  <li class="about-skills__item">
                    <span class="about-skills__item-name">{skill.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="about-cta" aria-labelledby="about-cta-heading">
      <div class="about-cta__container">
        <h2 id="about-cta-heading" class="about-cta__title reveal reveal--up">
          Ready to Work Together?
        </h2>
        <p class="about-cta__description reveal reveal--up reveal--delay-1">
          Let's discuss how we can help your business grow.
          The first consultation is always free.
        </p>
        <div class="about-cta__buttons reveal reveal--up reveal--delay-2">
          <Button
            text="Schedule a Free Consultation"
            href="/service-business/contact"
            variant="primary"
            size="large"
          />
          <Button
            text="View Our Work"
            href="/service-business/portfolio"
            variant="secondary"
            size="large"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .about-hero {
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-16);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background) 100%
    );
    text-align: center;
  }

  .about-hero__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .about-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-4);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .about-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * INTRODUCTION SECTION
   * ================================================================= */
  .about-intro {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-background);
  }

  .about-intro__container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .about-intro__text {
    padding-top: var(--spacing-4);
  }

  .about-intro__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-6);
    line-height: var(--line-height-snug);
  }

  .about-intro__bio {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .about-intro__bio p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .about-intro__cta {
    margin-top: var(--spacing-8);
  }

  /* =================================================================
   * SKILLS & EXPERTISE SECTION
   * ================================================================= */
  .about-skills {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-background-subtle);
  }

  .about-skills__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .about-skills__header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }

  .about-skills__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .about-skills__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .about-skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 768px) {
    .about-skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .about-skills__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-skills__category {
    background-color: var(--color-background);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-200) var(--ease-in-out);
  }

  .about-skills__category:hover {
    box-shadow: var(--shadow-md);
  }

  .about-skills__category-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    margin: 0 0 var(--spacing-4);
    padding-bottom: var(--spacing-3);
    border-bottom: 2px solid var(--color-primary-100);
  }

  .about-skills__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .about-skills__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-2) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .about-skills__item:last-child {
    border-bottom: none;
  }

  .about-skills__item-name {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-medium);
  }

  /* =================================================================
   * CALL TO ACTION SECTION
   * ================================================================= */
  .about-cta {
    padding: var(--spacing-20) var(--spacing-4);
    background-color: var(--color-primary);
    text-align: center;
  }

  .about-cta__container {
    max-width: var(--container-3xl);
    margin: 0 auto;
  }

  .about-cta__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .about-cta__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-primary-100);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-8);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .about-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .about-cta__buttons {
      flex-direction: row;
    }
  }

  /* Override secondary button colors for dark background */
  .about-cta :global(.btn--secondary) {
    color: var(--color-text-inverse);
    border-color: var(--color-text-inverse);
  }

  .about-cta :global(.btn--secondary:hover:not(.btn--disabled)) {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--color-text-inverse);
    color: var(--color-text-inverse);
  }

  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */
  @media (max-width: 767px) {
    .about-hero {
      padding: var(--spacing-12) var(--spacing-4) var(--spacing-10);
    }

    .about-hero__title {
      font-size: var(--font-size-3xl);
    }

    .about-hero__subtitle {
      font-size: var(--font-size-base);
    }

    .about-intro {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .about-intro__heading {
      font-size: var(--font-size-xl);
    }

    .about-skills {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .about-skills__title {
      font-size: var(--font-size-2xl);
    }

    .about-cta {
      padding: var(--spacing-12) var(--spacing-4);
    }

    .about-cta__title {
      font-size: var(--font-size-2xl);
    }
  }

  /* =================================================================
   * SCROLL-REVEAL ANIMATION ENHANCEMENTS
   * ================================================================= */

  /* Override decoration positioning for About page headers that use section-heading--decorated */
  .about-skills__header.section-heading--decorated {
    padding-top: var(--spacing-4);
  }

  /* Ensure the title and subtitle within decorated headers display properly */
  .about-skills__header.section-heading--decorated .about-skills__title,
  .about-skills__header.section-heading--decorated .about-skills__subtitle {
    position: relative;
    z-index: 1;
  }

  /* Add subtle hover lift to skill categories */
  .about-skills__category {
    transition:
      box-shadow var(--duration-200) var(--ease-in-out),
      transform var(--duration-300) var(--ease-out);
  }

  .about-skills__category:hover {
    transform: translateY(-4px);
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .about-skills__category {
      transition: none;
    }

    .about-skills__category:hover {
      transform: none;
    }

    /* Ensure reveal elements are visible without animation */
    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .about-hero {
      background: none;
      padding: var(--spacing-8) 0;
    }

    .about-cta {
      display: none;
    }
  }
</style>
