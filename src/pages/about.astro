---
/**
 * About Page
 * A visually engaging about page with warm, family-friendly design.
 *
 * Features:
 * - Gradient hero section with image
 * - Split-layout story section
 * - Value cards with icons
 * - Animated stats section
 * - Service area showcase
 * - Gradient CTA section
 */

import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

/**
 * Company values for the values section
 */
const values = [
  {
    icon: 'heart',
    title: 'Family Values',
    description: 'We treat your home like our own. Every technician on our team is someone we\'d trust in our own family\'s home.',
  },
  {
    icon: 'badge',
    title: 'Expert Technicians',
    description: 'NATE-certified, EPA licensed, and continuously trained. Our team knows HVAC systems inside and out.',
  },
  {
    icon: 'dollar',
    title: 'Fair Pricing',
    description: 'Upfront quotes, no surprises. We\'ll never pressure you into services you don\'t need.',
  },
  {
    icon: 'map',
    title: 'Local Roots',
    description: 'Your Energy Corridor neighbors since 2010. We live here, work here, and raise our families here.',
  },
];

/**
 * Service areas
 */
const serviceAreas = [
  'Houston',
  'Energy Corridor',
  'Katy',
  'Sugar Land',
  'Memorial',
  'The Woodlands',
  'Cypress',
  'Spring',
];
---

<Layout
  title="About"
  description="Coolside Comfort is a family-owned Houston HVAC company serving the Energy Corridor area since 2010. Trusted AC repair, heating, and maintenance services."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'AboutPage',
    name: 'About Coolside Comfort',
    description: 'Family-owned Houston HVAC company serving the Energy Corridor area since 2010. Trusted AC repair, heating, and maintenance services.',
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="about-hero" aria-labelledby="about-hero-heading">
      <div class="about-hero__background" aria-hidden="true"></div>
      <div class="about-hero__skyline" aria-hidden="true">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,120 L0,100 L50,100 L50,80 L70,80 L70,90 L90,90 L90,70 L100,70 L100,85 L120,85 L120,60 L140,60 L140,75 L160,75 L160,50 L170,50 L170,40 L180,40 L180,50 L190,50 L190,65 L210,65 L210,45 L220,45 L220,55 L240,55 L240,70 L260,70 L260,55 L280,55 L280,65 L300,65 L300,50 L310,50 L310,35 L320,35 L320,25 L330,25 L330,35 L340,35 L340,50 L360,50 L360,60 L380,60 L380,45 L400,45 L400,55 L420,55 L420,40 L430,40 L430,30 L440,30 L440,20 L450,20 L450,15 L460,15 L460,20 L470,20 L470,30 L480,30 L480,45 L500,45 L500,55 L520,55 L520,65 L540,65 L540,50 L560,50 L560,60 L580,60 L580,45 L590,45 L590,35 L600,35 L600,25 L610,25 L610,35 L620,35 L620,50 L640,50 L640,60 L660,60 L660,70 L680,70 L680,55 L700,55 L700,45 L720,45 L720,55 L740,55 L740,40 L750,40 L750,30 L760,30 L760,25 L770,25 L770,30 L780,30 L780,45 L800,45 L800,55 L820,55 L820,65 L840,65 L840,50 L860,50 L860,60 L880,60 L880,70 L900,70 L900,55 L920,55 L920,65 L940,65 L940,75 L960,75 L960,60 L980,60 L980,70 L1000,70 L1000,80 L1020,80 L1020,90 L1040,90 L1040,75 L1060,75 L1060,85 L1080,85 L1080,95 L1100,95 L1100,85 L1120,85 L1120,90 L1140,90 L1140,100 L1160,100 L1160,95 L1180,95 L1180,100 L1200,100 L1200,120 Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="about-hero__container">
        <div class="about-hero__grid">
          <div class="about-hero__content">
            <span class="about-hero__eyebrow reveal reveal--up">About Us</span>
            <h1 id="about-hero-heading" class="about-hero__title reveal reveal--up reveal--delay-1">
              Your Neighborhood<br />HVAC Experts
            </h1>
            <p class="about-hero__subtitle reveal reveal--up reveal--delay-2">
              Family-owned and operated since 2010, Coolside Comfort has been keeping
              Houston's Energy Corridor comfortable through every season.
            </p>
            <div class="about-hero__badges reveal reveal--up reveal--delay-3">
              <div class="hero-badge">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>Energy Corridor Based</span>
              </div>
              <div class="hero-badge">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                  <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
                <span>Family-Owned</span>
              </div>
            </div>
          </div>
          <div class="about-hero__image-wrapper reveal reveal--up reveal--delay-2">
            <img
              src="/service-business/images/family-comfort.jpg"
              alt="Happy family enjoying comfortable home temperature"
              class="about-hero__image"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="about-stats" aria-label="Company statistics">
      <div class="about-stats__container">
        <div class="about-stats__grid">
          <div class="about-stats__item reveal reveal--up">
            <span class="about-stats__number" data-count="15">15+</span>
            <span class="about-stats__label">Years Serving Houston</span>
          </div>
          <div class="about-stats__item reveal reveal--up reveal--delay-1">
            <span class="about-stats__number" data-count="5000">5,000+</span>
            <span class="about-stats__label">Homes Served</span>
          </div>
          <div class="about-stats__item reveal reveal--up reveal--delay-2">
            <span class="about-stats__number" data-count="4.9">4.9</span>
            <span class="about-stats__label">Google Rating (280+ Reviews)</span>
          </div>
          <div class="about-stats__item reveal reveal--up reveal--delay-3">
            <span class="about-stats__number">24/7</span>
            <span class="about-stats__label">Emergency Service</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="about-story" aria-labelledby="about-story-heading">
      <div class="about-story__container">
        <div class="about-story__grid">
          <div class="about-story__image reveal reveal--left">
            <img
              src="/service-business/images/family-comfort.jpg"
              alt="The Coolside Comfort team"
              class="about-story__img"
              loading="lazy"
              decoding="async"
            />
            <div class="about-story__image-accent" aria-hidden="true"></div>
          </div>
          <div class="about-story__content reveal reveal--right">
            <span class="about-story__eyebrow">Our Story</span>
            <h2 id="about-story-heading" class="about-story__heading">
              Keeping Houston Cool Since 2010
            </h2>
            <div class="about-story__text">
              <p>
                Coolside Comfort started with one simple goal: to give Houston homeowners
                the same quality HVAC service that big companies offer, but with the personal
                attention and honest pricing that only a family-owned business can provide.
              </p>
              <p>
                From our home base at 12847 Westheimer Rd in the Energy Corridor, we've grown
                to serve over 5,000 families across Houston, Katy, Sugar Land, Memorial, and
                The Woodlands. But no matter how much we grow, we never forget our roots.
              </p>
              <p>
                Our NATE-certified technicians treat every home like their own — because we're
                your neighbors, not just your contractors. When you call Coolside, you're not
                just getting a service technician. You're getting a neighbor who cares.
              </p>
            </div>
            <div class="about-story__signature">
              <span class="about-story__signature-text">— The Coolside Family</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values / Why Us Section -->
    <section class="about-values" aria-labelledby="about-values-heading">
      <div class="about-values__container">
        <div class="about-values__header reveal reveal--up">
          <span class="about-values__eyebrow">Why Choose Us</span>
          <h2 id="about-values-heading" class="about-values__title">
            The Coolside Difference
          </h2>
          <p class="about-values__subtitle">
            What sets us apart from every other HVAC company in Houston.
          </p>
        </div>

        <div class="about-values__grid">
          {values.map((value, index) => (
            <div class={`about-values__card about-values__card--${value.icon} reveal reveal--up reveal--delay-${index + 1}`}>
              <div class="about-values__icon">
                {value.icon === 'heart' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                )}
                {value.icon === 'badge' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                  </svg>
                )}
                {value.icon === 'dollar' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
                  </svg>
                )}
                {value.icon === 'map' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                )}
              </div>
              <h3 class="about-values__card-title">{value.title}</h3>
              <p class="about-values__card-description">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Service Area Section -->
    <section class="about-area" aria-labelledby="about-area-heading">
      <div class="about-area__container">
        <div class="about-area__grid">
          <div class="about-area__content reveal reveal--left">
            <span class="about-area__eyebrow">Service Area</span>
            <h2 id="about-area-heading" class="about-area__title">
              Proudly Serving Greater Houston
            </h2>
            <p class="about-area__description">
              From Katy to The Woodlands, Sugar Land to Memorial — if you're in the
              Houston area, we've got you covered. Same-day service available in all
              our service areas.
            </p>
            <div class="about-area__locations">
              {serviceAreas.map((area) => (
                <div class="about-area__location">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span>{area}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="about-area__map reveal reveal--right">
            <div class="about-area__map-graphic">
              <!-- Stylized Houston area map -->
              <svg viewBox="0 0 300 250" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-area__map-svg">
                <!-- Houston area outline -->
                <path d="M50 80 L90 60 L150 50 L210 55 L260 70 L270 120 L265 170 L250 210 L200 230 L140 235 L80 225 L40 190 L30 140 L50 80" 
                      stroke="currentColor" stroke-width="2" fill="rgba(14, 165, 233, 0.1)" stroke-linecap="round"/>
                <!-- Center point (Houston) -->
                <circle cx="150" cy="130" r="8" fill="#0ea5e9"/>
                <circle cx="150" cy="130" r="16" fill="rgba(14, 165, 233, 0.3)"/>
                <circle cx="150" cy="130" r="24" fill="rgba(14, 165, 233, 0.15)"/>
                <!-- Service area dots -->
                <circle cx="90" cy="110" r="5" fill="#f97316" opacity="0.8"/>
                <circle cx="180" cy="170" r="5" fill="#f97316" opacity="0.8"/>
                <circle cx="130" cy="80" r="5" fill="#f97316" opacity="0.8"/>
                <circle cx="200" cy="100" r="5" fill="#f97316" opacity="0.8"/>
                <circle cx="100" cy="160" r="5" fill="#f97316" opacity="0.8"/>
                <circle cx="170" cy="60" r="5" fill="#f97316" opacity="0.8"/>
                <!-- Connecting lines -->
                <line x1="150" y1="130" x2="90" y2="110" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
                <line x1="150" y1="130" x2="180" y2="170" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
                <line x1="150" y1="130" x2="130" y2="80" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
                <line x1="150" y1="130" x2="200" y2="100" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
                <line x1="150" y1="130" x2="100" y2="160" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
                <line x1="150" y1="130" x2="170" y2="60" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="4" opacity="0.5"/>
              </svg>
              <div class="about-area__map-label">
                <span class="about-area__map-label-icon">📍</span>
                <span>Energy Corridor HQ</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="about-cta" aria-labelledby="about-cta-heading">
      <div class="about-cta__background" aria-hidden="true"></div>
      <div class="about-cta__container">
        <span class="about-cta__eyebrow reveal reveal--up">Get Started Today</span>
        <h2 id="about-cta-heading" class="about-cta__title reveal reveal--up reveal--delay-1">
          Ready to Experience the<br />Coolside Difference?
        </h2>
        <p class="about-cta__description reveal reveal--up reveal--delay-2">
          Join over 5,000 Houston families who trust Coolside Comfort for their HVAC needs.
          Schedule your free estimate or give us a call — we're here to help.
        </p>
        <div class="about-cta__buttons reveal reveal--up reveal--delay-3">
          <Button
            text="Schedule Service"
            href="/service-business/contact"
            variant="primary"
            size="large"
          />
          <Button
            text="Call (832) 555-COOL"
            href="tel:+18325552665"
            variant="secondary"
            size="large"
          />
        </div>
        <div class="about-cta__trust reveal reveal--up reveal--delay-4">
          <span>✓ Free Estimates</span>
          <span>✓ Same-Day Service</span>
          <span>✓ 24/7 Emergency</span>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================================================================
   * HERO SECTION
   * ================================================================= */
  .about-hero {
    position: relative;
    padding: var(--spacing-20) var(--spacing-4) var(--spacing-16);
    background: linear-gradient(
      135deg,
      var(--color-primary-900) 0%,
      var(--color-primary-700) 35%,
      var(--color-primary-800) 65%,
      var(--color-primary-900) 100%
    );
    overflow: hidden;
  }

  .about-hero__background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        ellipse 80% 50% at 50% -20%,
        rgba(255, 255, 255, 0.1) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 60% 40% at 100% 100%,
        rgba(54, 83, 149, 0.3) 0%,
        transparent 50%
      );
  }

  .about-hero__skyline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    color: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .about-hero__skyline svg {
    width: 100%;
    height: 100%;
  }

  .about-hero__container {
    position: relative;
    z-index: 1;
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-12);
    }
  }

  .about-hero__content {
    text-align: center;
  }

  @media (min-width: 1024px) {
    .about-hero__content {
      text-align: left;
    }
  }

  .about-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-200);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-4);
    padding: var(--spacing-2) var(--spacing-4);
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  @media (min-width: 768px) {
    .about-hero__title {
      font-size: var(--font-size-5xl);
    }
  }

  .about-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-primary-100);
    max-width: 36rem;
    margin: 0 auto var(--spacing-6);
    line-height: var(--line-height-relaxed);
  }

  @media (min-width: 1024px) {
    .about-hero__subtitle {
      margin: 0 0 var(--spacing-6);
    }
  }

  .about-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .about-hero__badges {
      justify-content: flex-start;
    }
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-inverse);
  }

  .hero-badge svg {
    color: var(--color-primary-300);
  }

  .about-hero__image-wrapper {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .about-hero__image-wrapper {
      display: block;
    }
  }

  .about-hero__image-wrapper::before {
    content: '';
    position: absolute;
    inset: -10px;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.3), rgba(14, 165, 233, 0.3));
    border-radius: var(--radius-2xl);
    z-index: -1;
    filter: blur(20px);
  }

  .about-hero__image {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* =================================================================
   * STATS SECTION
   * ================================================================= */
  .about-stats {
    padding: var(--spacing-16) var(--spacing-4);
    background: linear-gradient(
      135deg,
      var(--color-primary-700) 0%,
      var(--color-primary-600) 50%,
      var(--color-primary-700) 100%
    );
  }

  .about-stats__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .about-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .about-stats__item {
    text-align: center;
    padding: var(--spacing-6);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(10px);
    transition: transform var(--duration-300) var(--ease-out), box-shadow var(--duration-300) var(--ease-out);
  }

  .about-stats__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .about-stats__number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    line-height: 1;
    margin-bottom: var(--spacing-2);
  }

  @media (min-width: 768px) {
    .about-stats__number {
      font-size: var(--font-size-5xl);
    }
  }

  .about-stats__label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-primary-100);
    font-weight: var(--font-weight-medium);
