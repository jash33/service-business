---
/**
 * Portfolio Page
 * Showcases completed projects with filtering capabilities.
 */

import Layout from '../layouts/Layout.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import type { Project } from '../types/portfolio';
import type { BeforeAfterComparison } from '../types/before-after';

/**
 * Before/After transformations
 * Replace with real project transformation data
 */
const transformations: BeforeAfterComparison[] = [];

/**
 * Portfolio projects
 * Replace with real project data
 */
const projects: Project[] = [];
---

<Layout
  title="Portfolio"
  description="Browse our portfolio of completed projects. See examples of our work and the results we deliver for our clients."
  openGraph={{
    type: 'website',
  }}
  jsonLd={{
    type: 'CollectionPage',
    name: 'Our Portfolio',
    description: 'Portfolio of completed projects showcasing our work and results.',
  }}
>
  <main>
    <!-- Portfolio Hero Section -->
    <section class="portfolio-hero" aria-labelledby="portfolio-hero-heading">
      <div class="portfolio-hero__container">
        <div class="portfolio-hero__content">
          <div class="portfolio-hero__badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>Real Results • Local Businesses</span>
          </div>
          <h1 id="portfolio-hero-heading" class="portfolio-hero__title">
            Our Work<br/>
            <span class="portfolio-hero__title-highlight">Speaks for Itself</span>
          </h1>
          <p class="portfolio-hero__description">
            Explore our portfolio of completed projects. We've helped businesses achieve their goals
            and deliver results that speak for themselves.
          </p>
          <div class="portfolio-hero__cta-group">
            <Button
              text="Start Your Project"
              href="/service-business/contact"
              variant="primary"
              size="large"
            />
            <Button
              text="View Services"
              href="/service-business/services"
              variant="secondary"
              size="large"
            />
          </div>
          <div class="portfolio-hero__stats">
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">5,000+</span>
              <span class="portfolio-hero__stat-label">Homes Served</span>
            </div>
            <div class="portfolio-hero__stat-divider"></div>
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">4.9★</span>
              <span class="portfolio-hero__stat-label">Google Rating</span>
            </div>
            <div class="portfolio-hero__stat-divider"></div>
            <div class="portfolio-hero__stat">
              <span class="portfolio-hero__stat-value">100%</span>
              <span class="portfolio-hero__stat-label">Satisfaction Guarantee</span>
            </div>
          </div>
        </div>
        <div class="portfolio-hero__visual" aria-hidden="true">
          <div class="portfolio-hero__cards-preview">
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--1">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M4 4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h16v9H4V6zm0 11h16v1H4v-1z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Category One</span>
              <span class="portfolio-hero__preview-price">Projects</span>
            </div>
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--2">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Category Two</span>
              <span class="portfolio-hero__preview-price">Projects</span>
            </div>
            <div class="portfolio-hero__preview-card portfolio-hero__preview-card--3">
              <div class="portfolio-hero__preview-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                  <path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                </svg>
              </div>
              <span class="portfolio-hero__preview-label">Category Three</span>
              <span class="portfolio-hero__preview-price">Projects</span>
            </div>
          </div>
        </div>
      </div>
      <div class="portfolio-hero__decoration" aria-hidden="true"></div>
    </section>

    <!-- Before/After Gallery Section -->
    <BeforeAfterGallery
      id="transformations"
      heading="Project Transformations"
      subheading="Drag the slider to see the dramatic before and after results of our projects. Experience the difference professional work makes."
      comparisons={transformations}
      enableFiltering={true}
      columns={2}
    />

    <!-- Portfolio Grid Section -->
    <PortfolioSection
      heading="Featured Projects"
      subheading="Browse through our recent work to see the quality and diversity of our projects."
      projects={projects}
      columns={3}
      enableFiltering={true}
      showFeaturedFirst={true}
    />

    <!-- Contact CTA Section -->
    <ContactCTA
      headline="Ready to Start Your Project?"
      supportingText="We have the expertise to bring your vision to life. Our clients trust us to deliver results that exceed expectations."
      primaryCTA={{
        text: "Start Your Project",
        href: "/contact",
      }}
      secondaryCTA={{
        text: "View Services & Pricing",
        href: "/services",
      }}
    />
  </main>
</Layout>

<style>
  /* =================================================================
   * PORTFOLIO HERO SECTION - Matching Services Page Style
   * ================================================================= */

  .portfolio-hero {
    position: relative;
    padding: var(--spacing-16) var(--spacing-4) var(--spacing-20);
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-primary-50) 50%,
      var(--color-background) 100%
    );
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
    overflow: hidden;
  }

  .portfolio-hero__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-10);
    align-items: center;
  }

  .portfolio-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-5);
  }

  .portfolio-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    background-color: var(--color-success-50);
    border: 1px solid var(--color-success-200);
    border-radius: var(--radius-full);
    color: var(--color-success-700);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .portfolio-hero__badge svg {
    color: var(--color-success-600);
  }

  .portfolio-hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .portfolio-hero__title-highlight {
    color: var(--color-primary);
    display: block;
  }

  .portfolio-hero__description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 50ch;
    margin: 0;
  }

  .portfolio-hero__cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    width: 100%;
    max-width: 20rem;
  }

  .portfolio-hero__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4) var(--spacing-6);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-top: var(--spacing-2);
  }

  .portfolio-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
  }

  .portfolio-hero__stat-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .portfolio-hero__stat-label {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portfolio-hero__stat-divider {
    width: 1px;
    height: var(--spacing-8);
    background-color: var(--color-border);
  }

  /* Visual/Cards Preview */
  .portfolio-hero__visual {
    display: none;
  }

  .portfolio-hero__cards-preview {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background: var(--color-background-elevated);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
  }

  .portfolio-hero__preview-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-200) var(--ease-out),
                box-shadow var(--duration-200) var(--ease-out);
  }

  .portfolio-hero__preview-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .portfolio-hero__preview-card--1 .portfolio-hero__preview-icon {
    background-color: var(--color-primary-100);
    color: var(--color-primary-600);
  }

  .portfolio-hero__preview-card--2 .portfolio-hero__preview-icon {
    background-color: var(--color-success-100);
    color: var(--color-success-600);
  }

  .portfolio-hero__preview-card--3 .portfolio-hero__preview-icon {
    background-color: var(--color-warning-100);
    color: var(--color-warning-600);
  }

  .portfolio-hero__preview-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-12);
    height: var(--spacing-12);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .portfolio-hero__preview-label {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    flex: 1;
  }

  .portfolio-hero__preview-price {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
  }

  /* Decorative element */
  .portfolio-hero__decoration {
    position: absolute;
    bottom: -50%;
    right: -20%;
    width: 60%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      var(--color-primary-100) 0%,
      transparent 70%
    );
    opacity: 0.5;
    pointer-events: none;
  }

  /* =================================================================
   * RESPONSIVE STYLES - Tablet (640px+)
   * ================================================================= */

  @media screen and (min-width: 640px) {
    .portfolio-hero {
      padding: var(--spacing-20) var(--spacing-6) var(--spacing-24);
    }

    .portfolio-hero__title {
      font-size: var(--font-size-4xl);
    }

    .portfolio-hero__cta-group {
      flex-direction: row;
      max-width: none;
      width: auto;
    }

    .portfolio-hero__stats {
      gap: var(--spacing-6);
    }

    .portfolio-hero__stat-value {
      font-size: var(--font-size-2xl);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES - Tablet (768px+)
   * ================================================================= */

  @media screen and (min-width: 768px) {
    .portfolio-hero__title {
      font-size: var(--font-size-5xl);
    }

    .portfolio-hero__description {
      font-size: var(--font-size-xl);
    }
  }

  /* =================================================================
   * RESPONSIVE STYLES - Desktop (1024px+)
   * ================================================================= */

  @media screen and (min-width: 1024px) {
    .portfolio-hero {
      padding: var(--spacing-24) var(--spacing-8) var(--spacing-28);
    }

    .portfolio-hero__container {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-12);
    }

    .portfolio-hero__content {
      align-items: flex-start;
      text-align: left;
    }

    .portfolio-hero__visual {
      display: block;
    }

    .portfolio-hero__stats {
      align-self: flex-start;
    }
  }

  /* =================================================================
   * ANIMATIONS
   * ================================================================= */

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cardsSlideIn {
    from {
      opacity: 0;
      transform: translateX(40px) perspective(1000px) rotateY(-5deg) rotateX(2deg);
    }
    to {
      opacity: 1;
      transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
    }
  }

  /* Hero section staggered animations */
  .portfolio-hero__badge {
    animation: heroFadeIn 0.6s ease-out 0.1s backwards;
  }

  .portfolio-hero__title {
    animation: heroFadeIn 0.6s ease-out 0.2s backwards;
  }

  .portfolio-hero__description {
    animation: heroFadeIn 0.6s ease-out 0.3s backwards;
  }

  .portfolio-hero__cta-group {
    animation: heroFadeIn 0.6s ease-out 0.4s backwards;
  }

  .portfolio-hero__stats {
    animation: heroFadeIn 0.6s ease-out 0.5s backwards;
  }

  .portfolio-hero__cards-preview {
    animation: cardsSlideIn 0.8s ease-out 0.3s backwards;
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */

  @media (prefers-reduced-motion: reduce) {
    .portfolio-hero {
      animation: none;
    }

    .portfolio-hero__badge,
    .portfolio-hero__title,
    .portfolio-hero__description,
    .portfolio-hero__cta-group,
    .portfolio-hero__stats,
    .portfolio-hero__cards-preview {
      animation: none;
    }

    .portfolio-hero__preview-card {
      transition: none;
    }

    .portfolio-hero__preview-card:hover {
      transform: none;
    }

    .portfolio-hero__cards-preview {
      transform: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */

  @media print {
    .portfolio-hero {
      background: none;
      padding: var(--spacing-8) 0;
    }

    .portfolio-hero__visual,
    .portfolio-hero__decoration {
      display: none;
    }

    .portfolio-hero__cta-group {
      display: none;
    }
  }
</style>
