---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DifferentiatorsSection from '../components/DifferentiatorsSection.astro';
import SocialProofCounterSection from '../components/SocialProofCounterSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';
import TrustBadgesSection from '../components/TrustBadgesSection.astro';
import LicenseInsuranceSection from '../components/LicenseInsuranceSection.astro';
import PartnerLogosSection from '../components/PartnerLogosSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactCTA from '../components/ContactCTA.astro';
import type { Service } from '../types/service';
import type { Differentiator } from '../types/differentiator';
import type { Testimonial } from '../types/testimonial';
import { DEFAULT_FAQ_ITEMS } from '../types/faq';
import { localBusinessSchema } from '../config/seo.config';
import { ACCREDITATION_BADGES, ACCREDITATION_BADGES_CONFIG } from '../config/accreditations.config';
import { CREDENTIALS, LICENSE_INSURANCE_CONFIG } from '../config/license-insurance.config';
import {
	SAMPLE_GOOGLE_REVIEWS,
	BUSINESS_RATING,
	GOOGLE_REVIEWS_SECTION_CONFIG,
	GOOGLE_REVIEWS_CONFIG,
} from '../config/google-reviews.config';
import { SOCIAL_PROOF_METRICS, SOCIAL_PROOF_COUNTER_CONFIG } from '../config/social-proof-counter.config';
import { PARTNER_LOGOS, PARTNER_LOGOS_CONFIG } from '../config/partner-logos.config';

/**
 * Homepage
 * Main landing page showcasing services and value proposition.
 */

// SVG Icons for services (optimized inline SVGs)
const icons = {
	wrench: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>`,
	water: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8zm0 18c-3.35 0-6-2.57-6-6.2 0-2.34 1.95-5.44 6-9.14 4.05 3.7 6 6.79 6 9.14 0 3.63-2.65 6.2-6 6.2z"/></svg>`,
	shield: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
	flame: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>`,
};

// SVG Icons for differentiators (optimized inline SVGs)
const differentiatorIcons = {
	clock: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`,
	dollarSign: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>`,
	mapPin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
	shield: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
};

// Service offerings for the homepage
const services: Service[] = [
	{
		id: 'drain-cleaning',
		title: 'Drain Cleaning & Repair',
		description: "Clogged drain? Slow sink? We'll have it flowing again fast. Our technicians use professional-grade equipment to clear even the toughest blockages — roots, grease, buildup, you name it.",
		icon: icons.wrench,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/drain-cleaning',
		},
	},
	{
		id: 'water-heaters',
		title: 'Water Heater Services',
		description: "No hot water? We repair and install traditional tank and tankless water heaters. Same-day service available — because cold showers shouldn't be a thing.",
		icon: icons.water,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/water-heaters',
		},
	},
	{
		id: 'leak-detection',
		title: 'Leak Detection & Repair',
		description: "Hidden leaks can cause serious damage. We use advanced detection technology to find leaks fast — in walls, under slabs, anywhere — and fix them right the first time.",
		icon: icons.shield,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/leak-detection',
		},
	},
	{
		id: 'sewer-gas-lines',
		title: 'Sewer & Gas Lines',
		description: "From sewer line repairs and replacements to gas line installation and leak detection, we handle the big jobs safely and professionally. Licensed and insured.",
		icon: icons.flame,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/sewer-gas-lines',
		},
	},
];

// Differentiators - unique selling points
const differentiators: Differentiator[] = [
	{
		id: 'same-day-service',
		title: 'Same-Day Service',
		description: "Plumbing emergency? We're ready to leap into action. Our trucks are fully stocked and our technicians are standing by — we'll be there fast.",
		icon: differentiatorIcons.clock,
	},
	{
		id: 'upfront-pricing',
		title: 'Flat-Rate Pricing',
		description: "We price by the job, not by the hour — so there are no surprises. You'll know exactly what you're paying before we start. Transparent and guaranteed.",
		icon: differentiatorIcons.dollarSign,
	},
	{
		id: 'local-family-owned',
		title: 'Local & Family-Owned',
		description: "We're your neighbors in the Energy Corridor, not some out-of-town franchise. Our family has served Houston for 20 years — your satisfaction is our reputation.",
		icon: differentiatorIcons.mapPin,
	},
	{
		id: 'licensed-insured',
		title: '100% Satisfaction Guarantee',
		description: 'All technicians are licensed and background-checked. We do the job right the first time, every time — or we make it right at no extra cost.',
		icon: differentiatorIcons.shield,
	},
];

// Customer testimonials
const testimonials: Testimonial[] = [
	{
		id: 'testimonial-1',
		name: 'Maria G.',
		location: 'Katy, TX',
		quote: 'Had a major leak on a Saturday night. HTX Plumbing Co. had someone here within the hour and fixed it fast. They explained everything, gave us an upfront quote, and the technician was professional and courteous. They\'re our go-to now!',
		title: 'Verified Customer',
	},
	{
		id: 'testimonial-2',
		name: 'David C.',
		location: 'Memorial, TX',
		quote: 'I\'ve used a lot of plumbing companies over the years. HTX is the only one that shows up on time, explains the problem clearly, and doesn\'t try to upsell me stuff I don\'t need. Honest, reliable service — exactly what you want.',
		title: 'Verified Customer',
	},
	{
		id: 'testimonial-3',
		name: 'Jennifer W.',
		location: 'Sugar Land, TX',
		quote: 'They replaced our ancient water heater with a tankless unit. The crew was fast, clean, and professional. Gave us a fair price and even cleaned up after themselves. Highly recommend!',
		title: 'Verified Customer',
	},
];
---

<Layout
	title="HTX Plumbing Co."
	description="Houston's trusted plumbers. Same-day service, flat-rate pricing, and 24/7 emergency calls. Family-owned, serving the Energy Corridor for 20 years. Call (832) 555-FLOW."
	noTitleTemplate
	openGraph={{
		type: 'website',
	}}
	jsonLd={localBusinessSchema}
>
	<main>
		<!-- Hero Section -->
		<HeroSection
			headline="Houston's Trusted Plumbers — Fast, Fair & Always There"
			subheadline="No shortcuts, no surprises — just expert plumbing done right the first time. We price by the job, not the hour, and offer 24/7 emergency service for immediate peace of mind."
			primaryCTA={{
				text: "Schedule Service",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Call (832) 555-FLOW",
				href: "tel:+18325553569",
			}}
			trustBadges={[
				{ icon: 'experience', text: '20+ Years Experience' },
				{ icon: 'projects', text: '10,000+ Jobs Completed' },
				{ icon: 'tech', text: '24/7 Emergency Service' },
			]}
			heroImage="/service-business/images/hero-plumber.jpg"
			heroImageAlt="Professional plumber working on pipe fittings"
		/>

		<!-- Services Section -->
		<ServicesSection
			id="services"
			heading="Our Services"
			subheading="Plumbing solutions you can count on"
			services={services}
			columns={4}
		/>

		<!-- Why Choose Us / Differentiators Section -->
		<DifferentiatorsSection
			id="why-choose-us"
			heading="Why Choose Us"
			subheading="Here's what sets us apart from the competition."
			differentiators={differentiators}
		/>

		<!-- Social Proof Counter Section -->
		<SocialProofCounterSection
			id={SOCIAL_PROOF_COUNTER_CONFIG.id}
			heading={SOCIAL_PROOF_COUNTER_CONFIG.heading}
			subheading={SOCIAL_PROOF_COUNTER_CONFIG.subheading}
			metrics={SOCIAL_PROOF_METRICS}
			columns={SOCIAL_PROOF_COUNTER_CONFIG.columns}
			animationDuration={SOCIAL_PROOF_COUNTER_CONFIG.animationDuration}
		/>

		<!-- Brands We Service Section -->
		<PartnerLogosSection
			id={PARTNER_LOGOS_CONFIG.id}
			heading={PARTNER_LOGOS_CONFIG.heading}
			subheading={PARTNER_LOGOS_CONFIG.subheading}
			logos={PARTNER_LOGOS}
			autoScroll={PARTNER_LOGOS_CONFIG.autoScroll}
			scrollSpeed={PARTNER_LOGOS_CONFIG.scrollSpeed}
			pauseOnHover={PARTNER_LOGOS_CONFIG.pauseOnHover}
		/>

		<!-- FAQ Section -->
		<FAQAccordion
			items={DEFAULT_FAQ_ITEMS}
			heading="Frequently Asked Questions"
			subheading="Find answers to common questions about our services, pricing, and process."
			allowMultiple={false}
			initialExpanded={null}
		/>

		<!-- Contact CTA Section -->
		<ContactCTA
			id="contact-cta"
			heading="Ready to Get Comfortable?"
			subheading="Schedule your service today and experience the Coolside difference."
			primaryCTA={{
				text: "Schedule Service",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Call (832) 555-FLOW",
				href: "tel:+18325553569",
			}}
			trustBadges={[
				"Licensed & Insured",
				"BBB A+ Rated",
				"24/7 Emergency"
			]}
		/>
	</main>
</Layout>

