---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DifferentiatorsSection from '../components/DifferentiatorsSection.astro';
import SocialProofCounterSection from '../components/SocialProofCounterSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';
import TrustBadgesSection from '../components/TrustBadgesSection.astro';
import LicenseInsuranceSection from '../components/LicenseInsuranceSection.astro';
import PartnerLogosSection from '../components/PartnerLogosSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactCTA from '../components/ContactCTA.astro';
import type { Service } from '../types/service';
import type { Differentiator } from '../types/differentiator';
import type { Testimonial } from '../types/testimonial';
import { DEFAULT_FAQ_ITEMS } from '../types/faq';
import { localBusinessSchema } from '../config/seo.config';
import { ACCREDITATION_BADGES, ACCREDITATION_BADGES_CONFIG } from '../config/accreditations.config';
import { CREDENTIALS, LICENSE_INSURANCE_CONFIG } from '../config/license-insurance.config';
import {
	SAMPLE_GOOGLE_REVIEWS,
	BUSINESS_RATING,
	GOOGLE_REVIEWS_SECTION_CONFIG,
	GOOGLE_REVIEWS_CONFIG,
} from '../config/google-reviews.config';
import { SOCIAL_PROOF_METRICS, SOCIAL_PROOF_COUNTER_CONFIG } from '../config/social-proof-counter.config';
import { PARTNER_LOGOS, PARTNER_LOGOS_CONFIG } from '../config/partner-logos.config';

/**
 * Homepage
 * Main landing page showcasing services and value proposition.
 */

// SVG Icons for services (optimized inline SVGs)
const icons = {
	snowflake: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22 11h-4.17l3.24-3.24-1.41-1.42L15 11h-2V9l4.66-4.66-1.42-1.41L13 6.17V2h-2v4.17L7.76 2.93 6.34 4.34 11 9v2H9L4.34 6.34 2.93 7.76 6.17 11H2v2h4.17l-3.24 3.24 1.41 1.42L9 13h2v2l-4.66 4.66 1.42 1.41L11 17.83V22h2v-4.17l3.24 3.24 1.42-1.41L13 15v-2h2l4.66 4.66 1.41-1.42L17.83 13H22z"/></svg>`,
	flame: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>`,
	shield: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
	wind: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 17c0 1.65-1.35 3-3 3s-3-1.35-3-3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1H2v-2h9.5c1.65 0 3 1.35 3 3zM19 6.5C19 4.57 17.43 3 15.5 3S12 4.57 12 6.5h2c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5S16.33 8 15.5 8H2v2h13.5c1.93 0 3.5-1.57 3.5-3.5zm-.5 4.5H2v2h16.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5H15c0 1.93 1.57 3.5 3.5 3.5s3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5z"/></svg>`,
};

// SVG Icons for differentiators (optimized inline SVGs)
const differentiatorIcons = {
	clock: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`,
	dollarSign: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>`,
	mapPin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
	shield: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
};

// Service offerings for the homepage
const services: Service[] = [
	{
		id: 'ac-repair-installation',
		title: 'AC Repair & Installation',
		description: "When your AC goes out in Houston, you need it fixed fast. Our certified technicians diagnose and repair all makes and models — usually same-day. Need a new system? We'll help you choose the right fit for your home and budget.",
		icon: icons.snowflake,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/ac-repair-installation',
		},
	},
	{
		id: 'heating-services',
		title: 'Heating Services',
		description: "Don't let those rare Texas cold snaps catch you off guard. From furnace repairs to full system replacements, we keep your family warm when temperatures drop.",
		icon: icons.flame,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/heating-services',
		},
	},
	{
		id: 'maintenance-plans',
		title: 'Maintenance Plans',
		description: 'Prevent breakdowns before they happen. Our Comfort Club members get priority scheduling, 20% off repairs, and two annual tune-ups to keep your system running efficiently year-round.',
		icon: icons.shield,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/maintenance-plans',
		},
	},
	{
		id: 'indoor-air-quality',
		title: 'Indoor Air Quality',
		description: 'Houston humidity breeds allergens and mold. We offer air purification systems, duct cleaning, and humidity control solutions to keep your indoor air fresh and healthy.',
		icon: icons.wind,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/indoor-air-quality',
		},
	},
];

// Differentiators - unique selling points
const differentiators: Differentiator[] = [
	{
		id: 'same-day-service',
		title: 'Same-Day Service',
		description: "AC out? We'll be there today. No waiting around in the Houston heat — our trucks are stocked and ready to roll.",
		icon: differentiatorIcons.clock,
	},
	{
		id: 'upfront-pricing',
		title: 'Upfront Pricing',
		description: "No surprises, no hidden fees. We quote the job before we start, so you know exactly what you're paying.",
		icon: differentiatorIcons.dollarSign,
	},
	{
		id: 'local-family-owned',
		title: 'Local & Family-Owned',
		description: "We're your neighbors in the Energy Corridor. Our family has served Houston for 15 years — your comfort is our reputation.",
		icon: differentiatorIcons.mapPin,
	},
	{
		id: 'licensed-epa-certified',
		title: 'Licensed & EPA Certified',
		description: 'All our technicians are NATE-certified and EPA-licensed. We do the job right, every time, guaranteed.',
		icon: differentiatorIcons.shield,
	},
];

// Customer testimonials
const testimonials: Testimonial[] = [
	{
		id: 'testimonial-1',
		name: 'Maria Gonzalez',
		location: 'Katy, TX',
		quote: 'Our AC died on the hottest day of July. Coolside had a tech here in 2 hours and got us running the same day. Fair price, friendly service. They\'re our go-to now.',
		title: 'Homeowner',
	},
	{
		id: 'testimonial-2',
		name: 'David Chen',
		location: 'Memorial, TX',
		quote: 'I\'ve used a lot of HVAC companies over the years. Coolside is the only one that shows up on time, explains everything clearly, and doesn\'t try to upsell me stuff I don\'t need.',
		title: 'Homeowner',
	},
	{
		id: 'testimonial-3',
		name: 'Jennifer & Marcus Williams',
		location: 'Sugar Land, TX',
		quote: 'The Comfort Club membership has saved us twice now. Both times we got priority service and the repairs were discounted. Absolutely worth it for peace of mind.',
		title: 'Homeowners',
	},
];
---

<Layout
	title="Coolside Comfort"
	description="Professional services for your business. Quality solutions, expert support, and results you can count on."
	noTitleTemplate
	openGraph={{
		type: 'website',
	}}
	jsonLd={localBusinessSchema}
>
	<main>
		<!-- Hero Section -->
		<HeroSection
			headline="Houston's Trusted HVAC Experts — Fast, Fair & Always There"
			subheadline="Same-day AC repair, upfront pricing, and 24/7 emergency service. Keeping Houston families comfortable since 2010."
			primaryCTA={{
				text: "Schedule Service",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Call (832) 555-COOL",
				href: "tel:+18325552665",
			}}
			trustBadges={[
				{ icon: 'experience', text: '15+ Years Experience' },
				{ icon: 'projects', text: '5,000+ Homes Served' },
				{ icon: 'tech', text: '24/7 Emergency Service' },
			]}
			heroImage="/service-business/images/technician-hero.jpg"
			heroImageAlt="Professional HVAC technician servicing equipment"
		/>

		<!-- Services Section -->
		<ServicesSection
			id="services"
			heading="Our Services"
			subheading="Keeping Houston homes comfortable year-round"
			services={services}
			columns={4}
		/>

		<!-- Why Choose Us / Differentiators Section -->
		<DifferentiatorsSection
			id="why-choose-us"
			heading="Why Choose Us"
			subheading="Here's what sets us apart from the competition."
			differentiators={differentiators}
		/>

		<!-- Social Proof Counter Section -->
		<SocialProofCounterSection
			id={SOCIAL_PROOF_COUNTER_CONFIG.id}
			heading={SOCIAL_PROOF_COUNTER_CONFIG.heading}
			subheading={SOCIAL_PROOF_COUNTER_CONFIG.subheading}
			metrics={SOCIAL_PROOF_METRICS}
			columns={SOCIAL_PROOF_COUNTER_CONFIG.columns}
			animationDuration={SOCIAL_PROOF_COUNTER_CONFIG.animationDuration}
		/>

		<!-- Brands We Service Section -->
		<PartnerLogosSection
			id={PARTNER_LOGOS_CONFIG.id}
			heading={PARTNER_LOGOS_CONFIG.heading}
			subheading={PARTNER_LOGOS_CONFIG.subheading}
			logos={PARTNER_LOGOS}
			autoScroll={PARTNER_LOGOS_CONFIG.autoScroll}
			scrollSpeed={PARTNER_LOGOS_CONFIG.scrollSpeed}
			pauseOnHover={PARTNER_LOGOS_CONFIG.pauseOnHover}
		/>

		<!-- FAQ Section -->
		<FAQAccordion
			items={DEFAULT_FAQ_ITEMS}
			heading="Frequently Asked Questions"
			subheading="Find answers to common questions about our services, pricing, and process."
			allowMultiple={false}
			initialExpanded={null}
		/>

		<!-- Contact CTA Section -->
		<ContactCTA
			id="contact-cta"
			heading="Ready to Get Comfortable?"
			subheading="Schedule your service today and experience the Coolside difference."
			primaryCTA={{
				text: "Schedule Service",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Call (832) 555-COOL",
				href: "tel:+18325552665",
			}}
			trustBadges={[
				"Licensed & Insured",
				"BBB A+ Rated",
				"24/7 Emergency"
			]}
		/>
	</main>
</Layout>

