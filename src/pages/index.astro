---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DifferentiatorsSection from '../components/DifferentiatorsSection.astro';
import SocialProofCounterSection from '../components/SocialProofCounterSection.astro';
import FeaturedProjectsPreview from '../components/FeaturedProjectsPreview.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';
import TrustBadgesSection from '../components/TrustBadgesSection.astro';
import LicenseInsuranceSection from '../components/LicenseInsuranceSection.astro';
import PartnerLogosSection from '../components/PartnerLogosSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactCTA from '../components/ContactCTA.astro';
import type { Service } from '../types/service';
import type { Differentiator } from '../types/differentiator';
import type { Testimonial } from '../types/testimonial';
import { DEFAULT_FAQ_ITEMS } from '../types/faq';
import { localBusinessSchema } from '../config/seo.config';
import { FEATURED_PROJECTS, FEATURED_PROJECTS_CONFIG } from '../config/featured-projects.config';
import { ACCREDITATION_BADGES, ACCREDITATION_BADGES_CONFIG } from '../config/accreditations.config';
import { CREDENTIALS, LICENSE_INSURANCE_CONFIG } from '../config/license-insurance.config';
import {
	SAMPLE_GOOGLE_REVIEWS,
	BUSINESS_RATING,
	GOOGLE_REVIEWS_SECTION_CONFIG,
	GOOGLE_REVIEWS_CONFIG,
} from '../config/google-reviews.config';
import { SOCIAL_PROOF_METRICS, SOCIAL_PROOF_COUNTER_CONFIG } from '../config/social-proof-counter.config';
import { PARTNER_LOGOS, PARTNER_LOGOS_CONFIG } from '../config/partner-logos.config';

/**
 * Homepage
 * Main landing page showcasing services and value proposition.
 */

// SVG Icons for services (optimized inline SVGs)
// TODO: Replace with icons that match your actual services
const icons = {
	clipboard: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h16v9H4V6zm0 11h16v1H4v-1z"/><path d="M6 8h3v3H6V8zm5 0h7v1h-7V8zm0 2h5v1h-5v-1z"/></svg>`,
	wrench: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>`,
	server: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M2 5a2 2 0 012-2h16a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm18 0H4v4h16V5zM2 15a2 2 0 012-2h16a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4zm18 0H4v4h16v-4z"/><circle cx="6" cy="7" r="1"/><circle cx="6" cy="17" r="1"/></svg>`,
	refresh: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>`,
	gear: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>`,
};

// SVG Icons for differentiators (optimized inline SVGs)
// TODO: Replace with icons that match your actual differentiators
const differentiatorIcons = {
	mapPin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
	dollarSign: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>`,
	clock: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`,
	user: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>`,
};

// Service offerings for the homepage
// TODO: Replace with your actual services
const services: Service[] = [
	{
		id: 'service-1',
		title: 'Service One',
		description: 'Description of your first service offering. Explain the value and benefits your customers will receive.',
		icon: icons.clipboard,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/service-one',
		},
	},
	{
		id: 'service-2',
		title: 'Service Two',
		description: 'Description of your second service offering. Highlight what makes this service valuable to your customers.',
		icon: icons.wrench,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/service-two',
		},
	},
	{
		id: 'service-3',
		title: 'Service Three',
		description: 'Description of your third service offering. Focus on the outcomes and results your customers can expect.',
		icon: icons.server,
		cta: {
			text: 'Learn More',
			href: '/service-business/services/service-three',
		},
	},
];

// Differentiators - unique selling points
// TODO: Replace with your actual differentiators
const differentiators: Differentiator[] = [
	{
		id: 'differentiator-1',
		title: 'Your First Differentiator',
		description: 'Describe what sets you apart from the competition. Focus on the unique value you bring to your customers.',
		icon: differentiatorIcons.mapPin,
	},
	{
		id: 'differentiator-2',
		title: 'Your Second Differentiator',
		description: 'Highlight another key advantage of working with your business. Be specific about the benefit.',
		icon: differentiatorIcons.dollarSign,
	},
	{
		id: 'differentiator-3',
		title: 'Your Third Differentiator',
		description: 'Share another reason customers should choose you. What promise do you make to every client?',
		icon: differentiatorIcons.clock,
	},
	{
		id: 'differentiator-4',
		title: 'Your Fourth Differentiator',
		description: 'Add one more compelling reason to choose your business. What makes the customer experience special?',
		icon: differentiatorIcons.user,
	},
];

// Customer testimonials
// TODO: Replace with your actual customer testimonials
const testimonials: Testimonial[] = [
	{
		id: 'testimonial-1',
		name: 'Customer Name',
		location: 'City, ST',
		quote: 'Replace this with a real testimonial from one of your satisfied customers. Authentic quotes build trust and credibility with potential clients.',
		company: 'Company Name',
		title: 'Title',
	},
	{
		id: 'testimonial-2',
		name: 'Customer Name',
		location: 'City, ST',
		quote: 'Add another genuine testimonial here. Focus on specific results or experiences that highlight the value of your services.',
		company: 'Company Name',
		title: 'Title',
	},
	{
		id: 'testimonial-3',
		name: 'Customer Name',
		location: 'City, ST',
		quote: 'Include a third testimonial that showcases a different aspect of your business. Variety in testimonials helps address different customer concerns.',
		company: 'Company Name',
		title: 'Title',
	},
];
---

<Layout
	title="Your Business Name"
	description="Professional services for your business. Quality solutions, expert support, and results you can count on."
	noTitleTemplate
	openGraph={{
		type: 'website',
	}}
	jsonLd={localBusinessSchema}
>
	<main>
		<!-- Hero Section -->
		<HeroSection
			headline="Your Compelling Headline Goes Here."
			valueProposition="A brief value proposition that communicates your core benefit."
			subheadline="A supporting statement that expands on your headline and encourages visitors to take action. Customize this to match your business."
			primaryCTA={{
				text: "Get Started",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Learn More",
				href: "#services",
			}}
			trustBadges={[
				{ icon: 'experience', text: 'Years of Experience' },
				{ icon: 'projects', text: 'Customers Served' },
				{ icon: 'tech', text: 'Your Key Differentiator' },
			]}
		/>

		<!-- Services Section -->
		<ServicesSection
			id="services"
			heading="Our Services"
			subheading="Explore our range of professional services designed to help your business succeed."
			services={services}
			columns={3}
		/>

		<!-- Why Choose Us / Differentiators Section -->
		<DifferentiatorsSection
			id="why-choose-us"
			heading="Why Choose Us"
			subheading="Here's what sets us apart from the competition."
			differentiators={differentiators}
		/>

		<!-- Social Proof Counter Section -->
		<SocialProofCounterSection
			id={SOCIAL_PROOF_COUNTER_CONFIG.id}
			heading={SOCIAL_PROOF_COUNTER_CONFIG.heading}
			subheading={SOCIAL_PROOF_COUNTER_CONFIG.subheading}
			metrics={SOCIAL_PROOF_METRICS}
			columns={SOCIAL_PROOF_COUNTER_CONFIG.columns}
			animationDuration={SOCIAL_PROOF_COUNTER_CONFIG.animationDuration}
		/>

		<!-- Featured Projects Preview Section -->
		<FeaturedProjectsPreview
			id={FEATURED_PROJECTS_CONFIG.id}
			heading={FEATURED_PROJECTS_CONFIG.heading}
			subheading={FEATURED_PROJECTS_CONFIG.subheading}
			projects={FEATURED_PROJECTS}
			viewAllText={FEATURED_PROJECTS_CONFIG.viewAllText}
			viewAllHref={FEATURED_PROJECTS_CONFIG.viewAllHref}
		/>

		<!-- Testimonials Section -->
		<TestimonialsSection
			id="testimonials"
			heading="What Our Clients Say"
			subheading="Hear from customers who trust us with their business."
			testimonials={testimonials}
		/>

		<!-- Google Reviews Section -->
		<GoogleReviewsSection
			id={GOOGLE_REVIEWS_SECTION_CONFIG.id}
			heading={GOOGLE_REVIEWS_SECTION_CONFIG.heading}
			subheading={GOOGLE_REVIEWS_SECTION_CONFIG.subheading}
			reviews={SAMPLE_GOOGLE_REVIEWS}
			businessRating={BUSINESS_RATING}
			maxReviews={6}
			showGoogleLink={GOOGLE_REVIEWS_SECTION_CONFIG.showGoogleLink}
			googleReviewsUrl={GOOGLE_REVIEWS_CONFIG.googleBusinessUrl}
		/>

		<!-- Accreditation Badges Section -->
		<TrustBadgesSection
			id={ACCREDITATION_BADGES_CONFIG.id}
			heading={ACCREDITATION_BADGES_CONFIG.heading}
			subheading={ACCREDITATION_BADGES_CONFIG.subheading}
			badges={ACCREDITATION_BADGES}
			columns={ACCREDITATION_BADGES_CONFIG.columns}
			layout={ACCREDITATION_BADGES_CONFIG.layout}
		/>

		<!-- License & Insurance Verification Section -->
		<LicenseInsuranceSection
			id={LICENSE_INSURANCE_CONFIG.id}
			heading={LICENSE_INSURANCE_CONFIG.heading}
			subheading={LICENSE_INSURANCE_CONFIG.subheading}
			credentials={CREDENTIALS}
			columns={LICENSE_INSURANCE_CONFIG.columns}
		/>

		<!-- Partner Logos Section -->
		<PartnerLogosSection
			id={PARTNER_LOGOS_CONFIG.id}
			heading={PARTNER_LOGOS_CONFIG.heading}
			subheading={PARTNER_LOGOS_CONFIG.subheading}
			logos={PARTNER_LOGOS}
			autoScroll={PARTNER_LOGOS_CONFIG.autoScroll}
			scrollSpeed={PARTNER_LOGOS_CONFIG.scrollSpeed}
			pauseOnHover={PARTNER_LOGOS_CONFIG.pauseOnHover}
		/>

		<!-- FAQ Section -->
		<FAQAccordion
			items={DEFAULT_FAQ_ITEMS}
			heading="Frequently Asked Questions"
			subheading="Find answers to common questions about our services, pricing, and process."
			allowMultiple={false}
			initialExpanded={null}
		/>

		<!-- Contact CTA Section -->
		<ContactCTA
			headline="Ready to Get Started?"
			supportingText="Contact us today to learn how we can help your business succeed. We're here to answer your questions and provide a personalized solution for your needs."
			primaryCTA={{
				text: "Get Your Free Quote",
				href: "/contact",
			}}
			secondaryCTA={{
				text: "Call Us Today",
				href: "tel:+15555555555",
			}}
		/>
	</main>
</Layout>
