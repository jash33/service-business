---
/**
 * Case Study Template
 * Long-form case study page with problem-solution-results format,
 * project timeline, customer quotes, and multiple images.
 *
 * Features:
 * - Problem-solution-results structure
 * - Project timeline visualization
 * - Customer quotes/testimonials
 * - Image gallery
 * - Results metrics
 * - Related case studies
 * - Full SEO support with schema markup
 */

import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import CaseStudyTimeline from '../../components/CaseStudyTimeline.astro';
import CaseStudyResults from '../../components/CaseStudyResults.astro';
import CustomerQuote from '../../components/CustomerQuote.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { CASE_STUDIES, getRelatedCaseStudies } from '../../config/case-studies.config';
import { seoConfig } from '../../config/seo.config';
import type { CaseStudy, CaseStudyImage, CustomerQuote as CustomerQuoteType } from '../../types/case-study';

// Generate static paths for all case studies
export function getStaticPaths() {
  return CASE_STUDIES.filter(cs => cs.published).map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;

// Get current URL for sharing
const currentUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).toString();

// Get related case studies
const relatedCaseStudies = getRelatedCaseStudies(caseStudy);

// Get images by placement
function getImagesByPlacement(placement: CaseStudyImage['placement']): CaseStudyImage[] {
  return caseStudy.images
    .filter(img => img.placement === placement)
    .sort((a, b) => (a.order || 0) - (b.order || 0));
}

// Get quotes by placement
function getQuotesByPlacement(placement: CustomerQuoteType['placement']): CustomerQuoteType[] {
  return caseStudy.quotes.filter(q => q.placement === placement);
}

const problemImages = getImagesByPlacement('problem');
const solutionImages = getImagesByPlacement('solution');
const resultsImages = getImagesByPlacement('results');
const galleryImages = getImagesByPlacement('gallery');

const heroQuotes = getQuotesByPlacement('hero');
const problemQuotes = getQuotesByPlacement('problem');
const solutionQuotes = getQuotesByPlacement('solution');
const resultsQuotes = getQuotesByPlacement('results');

// Format dates
const formattedStartDate = new Date(caseStudy.projectStartDate).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

const formattedEndDate = new Date(caseStudy.projectEndDate).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title={`${caseStudy.title} | Case Study`}
  description={caseStudy.metaDescription || caseStudy.summary}
  image={caseStudy.heroImage.src}
  hideBreadcrumbs={true}
  jsonLd={{
    type: 'Article',
    headline: caseStudy.title,
    description: caseStudy.summary,
    image: caseStudy.heroImage.src,
    datePublished: caseStudy.projectEndDate,
    author: seoConfig.siteName,
  }}
>
  <!-- Breadcrumb Navigation -->
  <Breadcrumb
    items={[
      { name: 'Home', url: '/' },
      { name: 'Portfolio', url: '/portfolio' },
      { name: 'Case Studies', url: '/portfolio#case-studies' },
      { name: caseStudy.title }
    ]}
    class="case-study__breadcrumb"
  />

  <article class="case-study" itemscope itemtype="https://schema.org/Article">
    <!-- Hero Section -->
    <header class="case-study__hero">
      <div class="case-study__hero-container">
        <div class="case-study__hero-content">
          <div class="case-study__category-badge">
            {caseStudy.category.replace('-', ' ')}
          </div>
          <h1 class="case-study__title" itemprop="headline">{caseStudy.title}</h1>
          {caseStudy.subtitle && (
            <p class="case-study__subtitle">{caseStudy.subtitle}</p>
          )}

          <!-- Client & Project Info -->
          <div class="case-study__meta">
            <div class="case-study__meta-item">
              <span class="case-study__meta-label">Client</span>
              <span class="case-study__meta-value">{caseStudy.client.name}</span>
            </div>
            <div class="case-study__meta-item">
              <span class="case-study__meta-label">Industry</span>
              <span class="case-study__meta-value">{caseStudy.client.industry}</span>
            </div>
            <div class="case-study__meta-item">
              <span class="case-study__meta-label">Duration</span>
              <span class="case-study__meta-value">{caseStudy.projectDuration}</span>
            </div>
            <div class="case-study__meta-item">
              <span class="case-study__meta-label">Completed</span>
              <span class="case-study__meta-value">{formattedEndDate}</span>
            </div>
          </div>

          <!-- Services & Technologies -->
          <div class="case-study__tags">
            <div class="case-study__tags-group">
              <span class="case-study__tags-label">Services:</span>
              <div class="case-study__tags-list">
                {caseStudy.services.map((service) => (
                  <span class="case-study__tag case-study__tag--service">{service}</span>
                ))}
              </div>
            </div>
            <div class="case-study__tags-group">
              <span class="case-study__tags-label">Technologies:</span>
              <div class="case-study__tags-list">
                {caseStudy.technologies.map((tech) => (
                  <span class="case-study__tag case-study__tag--tech">{tech.name}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="case-study__hero-image">
          <picture>
            <img
              src={caseStudy.heroImage.src}
              alt={caseStudy.heroImage.alt}
              width={caseStudy.heroImage.width || 1200}
              height={caseStudy.heroImage.height || 630}
              class="case-study__featured-image"
              loading="eager"
              itemprop="image"
            />
          </picture>
        </div>
      </div>

      <!-- Hero Quote -->
      {heroQuotes.length > 0 && (
        <div class="case-study__hero-quote">
          <CustomerQuote quote={heroQuotes[0]} variant="featured" />
        </div>
      )}
    </header>

    <!-- Problem Section -->
    <section class="case-study__section case-study__section--problem" aria-labelledby="problem-heading">
      <div class="case-study__section-container">
        <div class="case-study__section-header">
          <span class="case-study__section-number">01</span>
          <h2 id="problem-heading" class="case-study__section-title">The Challenge</h2>
        </div>

        <div class="case-study__section-content">
          <p class="case-study__overview">{caseStudy.problem.overview}</p>

          {problemImages.length > 0 && (
            <div class="case-study__images case-study__images--problem">
              {problemImages.map((img) => (
                <figure class="case-study__figure">
                  <img
                    src={img.src}
                    alt={img.alt}
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    class="case-study__image"
                  />
                  {img.caption && (
                    <figcaption class="case-study__caption">{img.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}

          <ul class="case-study__challenges" role="list">
            {caseStudy.problem.challenges.map((challenge) => (
              <li class="case-study__challenge">
                <div class="case-study__challenge-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="24" height="24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <div class="case-study__challenge-content">
                  <h3 class="case-study__challenge-title">{challenge.title}</h3>
                  <p class="case-study__challenge-description">{challenge.description}</p>
                </div>
              </li>
            ))}
          </ul>

          {problemQuotes.length > 0 && (
            <div class="case-study__section-quote">
              <CustomerQuote quote={problemQuotes[0]} variant="inline" />
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="case-study__section case-study__section--solution" aria-labelledby="solution-heading">
      <div class="case-study__section-container">
        <div class="case-study__section-header">
          <span class="case-study__section-number">02</span>
          <h2 id="solution-heading" class="case-study__section-title">Our Solution</h2>
        </div>

        <div class="case-study__section-content">
          <p class="case-study__overview">{caseStudy.solution.overview}</p>

          <div class="case-study__solutions">
            {caseStudy.solution.approaches.map((approach) => (
              <div class="case-study__solution-item">
                <div class="case-study__solution-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="24" height="24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="case-study__solution-content">
                  <h3 class="case-study__solution-title">{approach.title}</h3>
                  <p class="case-study__solution-description">{approach.description}</p>
                  {approach.technologies && approach.technologies.length > 0 && (
                    <div class="case-study__solution-tech">
                      {approach.technologies.map((tech) => (
                        <span class="case-study__solution-tech-tag">{tech}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>

          {solutionImages.length > 0 && (
            <div class="case-study__images case-study__images--solution">
              {solutionImages.map((img) => (
                <figure class="case-study__figure">
                  <img
                    src={img.src}
                    alt={img.alt}
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    class="case-study__image"
                  />
                  {img.caption && (
                    <figcaption class="case-study__caption">{img.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}

          {solutionQuotes.length > 0 && (
            <div class="case-study__section-quote">
              <CustomerQuote quote={solutionQuotes[0]} variant="inline" />
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="case-study__section case-study__section--timeline" aria-labelledby="timeline-heading">
      <div class="case-study__section-container">
        <div class="case-study__section-header case-study__section-header--centered">
          <span class="case-study__section-number">03</span>
          <h2 id="timeline-heading" class="case-study__section-title">Project Timeline</h2>
          <p class="case-study__section-subtitle">
            From {formattedStartDate} to {formattedEndDate} ({caseStudy.projectDuration})
          </p>
        </div>

        <CaseStudyTimeline milestones={caseStudy.timeline} orientation="vertical" />
      </div>
    </section>

    <!-- Results Section -->
    <section class="case-study__section case-study__section--results" aria-labelledby="results-heading">
      <CaseStudyResults
        metrics={caseStudy.results.metrics}
        overview={caseStudy.results.overview}
        columns={3}
      />

      {resultsImages.length > 0 && (
        <div class="case-study__results-images">
          <div class="case-study__section-container">
            {resultsImages.map((img) => (
              <figure class="case-study__figure case-study__figure--results">
                <img
                  src={img.src}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                  class="case-study__image"
                />
                {img.caption && (
                  <figcaption class="case-study__caption">{img.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      )}

      {resultsQuotes.length > 0 && (
        <div class="case-study__results-quote">
          <div class="case-study__section-container">
            <CustomerQuote quote={resultsQuotes[0]} variant="featured" />
          </div>
        </div>
      )}
    </section>

    <!-- Gallery Section -->
    {galleryImages.length > 0 && (
      <section class="case-study__section case-study__section--gallery" aria-labelledby="gallery-heading">
        <div class="case-study__section-container">
          <div class="case-study__section-header case-study__section-header--centered">
            <h2 id="gallery-heading" class="case-study__section-title">Project Gallery</h2>
          </div>

          <div class="case-study__gallery">
            {galleryImages.map((img) => (
              <figure class="case-study__gallery-item">
                <img
                  src={img.src}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                  class="case-study__gallery-image"
                />
                {img.caption && (
                  <figcaption class="case-study__caption">{img.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA Section -->
    {caseStudy.cta && (
      <section class="case-study__section case-study__section--cta">
        <ContactCTA
          headline={caseStudy.cta.headline}
          supportingText={caseStudy.cta.description}
          primaryCTA={{
            text: caseStudy.cta.primaryButtonText || 'Get Started',
            href: caseStudy.cta.primaryButtonUrl || '/contact',
          }}
          secondaryCTA={caseStudy.cta.secondaryButtonText ? {
            text: caseStudy.cta.secondaryButtonText,
            href: caseStudy.cta.secondaryButtonUrl || '/services',
          } : undefined}
        />
      </section>
    )}

    <!-- Related Case Studies -->
    {relatedCaseStudies.length > 0 && (
      <section class="case-study__section case-study__section--related" aria-labelledby="related-heading">
        <div class="case-study__section-container">
          <div class="case-study__section-header case-study__section-header--centered">
            <h2 id="related-heading" class="case-study__section-title">Related Case Studies</h2>
          </div>

          <div class="case-study__related-grid">
            {relatedCaseStudies.map((related) => (
              <a href={`/service-business/case-studies/${related.slug}`} class="case-study__related-card">
                <img
                  src={related.heroImage.src}
                  alt={related.heroImage.alt}
                  width="400"
                  height="250"
                  loading="lazy"
                  class="case-study__related-image"
                />
                <div class="case-study__related-content">
                  <span class="case-study__related-category">
                    {related.category.replace('-', ' ')}
                  </span>
                  <h3 class="case-study__related-title">{related.title}</h3>
                  <p class="case-study__related-summary">{related.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  /* =================================================================
   * CASE STUDY PAGE STYLES
   * ================================================================= */

  .case-study {
    width: 100%;
  }

  /* =================================================================
   * BREADCRUMB
   * ================================================================= */

  .case-study__breadcrumb {
    max-width: var(--container-7xl);
    margin: 0 auto;
    padding: var(--spacing-4);
  }

  /* =================================================================
   * HERO SECTION
   * ================================================================= */

  .case-study__hero {
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-12);
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-primary-50) 100%
    );
  }

  .case-study__hero-container {
    max-width: var(--container-7xl);
    margin: 0 auto;
    display: grid;
    gap: var(--spacing-8);
  }

  .case-study__hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .case-study__category-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--spacing-1) var(--spacing-3);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-md);
  }

  .case-study__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .case-study__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .case-study__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .case-study__meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .case-study__meta-label {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study__meta-value {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .case-study__tags {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .case-study__tags-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
  }

  .case-study__tags-label {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .case-study__tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .case-study__tag {
    padding: var(--spacing-1) var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-md);
  }

  .case-study__tag--service {
    background-color: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .case-study__tag--tech {
    background-color: var(--color-background-muted);
    color: var(--color-text-secondary);
  }

  .case-study__hero-image {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .case-study__featured-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-study__hero-quote {
    max-width: var(--container-4xl);
    margin: var(--spacing-10) auto 0;
  }

  /* =================================================================
   * SECTION STYLES
   * ================================================================= */

  .case-study__section {
    padding: var(--spacing-12) var(--spacing-4);
  }

  .case-study__section--problem,
  .case-study__section--gallery {
    background-color: var(--color-background);
  }

  .case-study__section--solution {
    background-color: var(--color-background-subtle);
  }

  .case-study__section--timeline {
    background-color: var(--color-background);
  }

  .case-study__section--results {
    padding: 0;
  }

  .case-study__section--related {
    background-color: var(--color-background-subtle);
    padding-bottom: var(--spacing-16);
  }

  .case-study__section-container {
    max-width: var(--container-5xl);
    margin: 0 auto;
  }

  .case-study__section-header {
    margin-bottom: var(--spacing-8);
  }

  .case-study__section-header--centered {
    text-align: center;
  }

  .case-study__section-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-3);
  }

  .case-study__section-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .case-study__section-subtitle {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: var(--spacing-2) 0 0;
  }

  .case-study__overview {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-8);
  }

  /* =================================================================
   * CHALLENGES
   * ================================================================= */

  .case-study__challenges {
    display: grid;
    gap: var(--spacing-4);
    list-style: none;
    margin: 0 0 var(--spacing-8);
    padding: 0;
  }

  .case-study__challenge {
    display: flex;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-warning-500);
    border-radius: var(--radius-lg);
  }

  .case-study__challenge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-10);
    height: var(--spacing-10);
    background-color: var(--color-warning-100);
    color: var(--color-warning-600);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .case-study__challenge-content {
    flex: 1;
  }

  .case-study__challenge-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-1);
  }

  .case-study__challenge-description {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* =================================================================
   * SOLUTIONS
   * ================================================================= */

  .case-study__solutions {
    display: grid;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-8);
  }

  .case-study__solution-item {
    display: flex;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-success-500);
    border-radius: var(--radius-lg);
  }

  .case-study__solution-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-10);
    height: var(--spacing-10);
    background-color: var(--color-success-100);
    color: var(--color-success-600);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .case-study__solution-content {
    flex: 1;
  }

  .case-study__solution-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-1);
  }

  .case-study__solution-description {
    font-family: var(--font-body);
