---
/**
 * Hero Section Component
 * A conversion-optimized hero section for the homepage that immediately
 * communicates value to local small business owners.
 *
 * Features:
 * - Mobile-first responsive design
 * - Clear visual hierarchy: headline → value prop → subheadline → CTA
 * - WCAG 2.1 AA compliant contrast and touch targets
 * - Semantic HTML structure for accessibility and SEO
 * - Smooth responsive scaling without horizontal scroll
 * - Optional secondary CTA button
 * - Animated grid background with moving glow effect
 * - Floating gradient orbs background animation
 *
 * Background Animation:
 * The hero features two layered background animations:
 *
 * 1. Animated Grid:
 *    - Subtle grid lines that slowly move diagonally
 *    - A glowing highlight that travels across the grid
 *    - Responsive grid sizing (50px mobile → 80px desktop)
 *    - Creates a modern tech/digital aesthetic
 *
 * 2. Floating Gradient Orbs:
 *    - 5 large, soft, blurred gradient circles in purple/blue/cyan tones
 *    - Each orb has a unique slow floating path for organic movement
 *    - Orbs scale up on larger screens for a richer visual experience
 *    - GPU-accelerated transforms for smooth 60fps performance
 *
 * Accessibility:
 * - Animation respects `prefers-reduced-motion` (static fallback)
 * - Hidden in Windows High Contrast mode (`forced-colors: active`)
 * - Hidden when printing
 * - All animation elements marked `aria-hidden="true"`
 *
 * @example Basic usage
 * ```astro
 * <HeroSection
 *   headline="Your Trusted Local Service Professionals"
 *   valueProposition="Reliable, expert service for homes and businesses"
 *   subheadline="Professional solutions tailored to your community's needs."
 *   primaryCTA={{ text: "Get Your Free Estimate", href: "/contact" }}
 * />
 * ```
 */

import type { HeroSectionProps } from '../types/hero';
import Button from './Button.astro';
import TrustBadges from './TrustBadges.astro';

interface Props extends HeroSectionProps {
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  headline,
  valueProposition,
  subheadline,
  primaryCTA,
  secondaryCTA,
  id = 'hero',
  class: className = '',
  heroImage,
  heroImageAlt = 'Professional service technician',
} = Astro.props;

const sectionClasses = ['hero', className].filter(Boolean).join(' ');
---

<section class={sectionClasses} id={id} aria-labelledby={`${id}-headline`}>
  <div class="hero__container">
    <div class="hero__grid">
      <div class="hero__content">
        <h1 id={`${id}-headline`} class="hero__headline">{headline}</h1>

        {valueProposition && (
          <p class="hero__value-prop">{valueProposition}</p>
        )}

        {subheadline && (
          <p class="hero__subheadline">
            <svg class="hero__subheadline-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
            </svg>
            <span>{subheadline}</span>
          </p>
        )}

        {(primaryCTA || secondaryCTA) && (
          <div class="hero__cta-wrapper">
            <div class="hero__cta-group">
              {primaryCTA && (
                <div class="hero__cta-primary-wrapper">
                  <Button text={primaryCTA.text} href={primaryCTA.href} variant={primaryCTA.variant || 'primary'} size="large" class="hero__cta hero__cta--primary" />
                </div>
              )}
              {secondaryCTA && (
                <Button text={secondaryCTA.text} href={secondaryCTA.href} variant={secondaryCTA.variant || 'secondary'} size="large" class="hero__cta hero__cta--secondary" />
              )}
            </div>
            {/* Inline trust badges removed - consolidated into TrustBadges component */}
          </div>
        )}

        <TrustBadges />

        <div class="hero__location-cue">
          <svg class="hero__location-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <span class="hero__location-text">Serving the Greater Houston Area</span>
          <span class="hero__coordinates">Houston, TX</span>
        </div>
      </div>

      {heroImage && (
        <div class="hero__image-wrapper">
          <img 
            src={heroImage} 
            alt={heroImageAlt}
            class="hero__image"
            loading="eager"
            decoding="async"
          />
        </div>
      )}

    </div>
  </div>

  <div class="hero__background" aria-hidden="true"></div>

  <!-- Animated backgrounds removed for performance and brand fit -->

  <div class="hero__skyline" aria-hidden="true">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,120 L0,100 L50,100 L50,80 L70,80 L70,90 L90,90 L90,70 L100,70 L100,85 L120,85 L120,60 L140,60 L140,75 L160,75 L160,50 L170,50 L170,40 L180,40 L180,50 L190,50 L190,65 L210,65 L210,45 L220,45 L220,55 L240,55 L240,70 L260,70 L260,55 L280,55 L280,65 L300,65 L300,50 L310,50 L310,35 L320,35 L320,25 L330,25 L330,35 L340,35 L340,50 L360,50 L360,60 L380,60 L380,45 L400,45 L400,55 L420,55 L420,40 L430,40 L430,30 L440,30 L440,20 L450,20 L450,15 L460,15 L460,20 L470,20 L470,30 L480,30 L480,45 L500,45 L500,55 L520,55 L520,65 L540,65 L540,50 L560,50 L560,60 L580,60 L580,45 L590,45 L590,35 L600,35 L600,25 L610,25 L610,35 L620,35 L620,50 L640,50 L640,60 L660,60 L660,70 L680,70 L680,55 L700,55 L700,45 L720,45 L720,55 L740,55 L740,40 L750,40 L750,30 L760,30 L760,25 L770,25 L770,30 L780,30 L780,45 L800,45 L800,55 L820,55 L820,65 L840,65 L840,50 L860,50 L860,60 L880,60 L880,70 L900,70 L900,55 L920,55 L920,65 L940,65 L940,75 L960,75 L960,60 L980,60 L980,70 L1000,70 L1000,80 L1020,80 L1020,90 L1040,90 L1040,75 L1060,75 L1060,85 L1080,85 L1080,95 L1100,95 L1100,85 L1120,85 L1120,90 L1140,90 L1140,100 L1160,100 L1160,95 L1180,95 L1180,100 L1200,100 L1200,120 Z" fill="currentColor"/>
    </svg>
  </div>
  <div class="hero__accent-shape" aria-hidden="true"></div>

  <!-- Interior border removed - too tech-startup for HVAC business -->
</section>

<style>
  /* =================================================================
   * HERO SECTION COMPONENT STYLES
   * =================================================================
   * Mobile-first approach with responsive breakpoints
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--spacing-16) var(--spacing-4);
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        var(--color-primary-900) 0%,
        var(--color-primary-700) 35%,
        var(--color-primary-800) 65%,
        var(--color-primary-900) 100%
      );
    background-size: 100% 100%;
  }

  /* Enhanced gradient overlay for depth */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 100% 80% at 80% 20%,
        rgba(139, 92, 246, 0.12) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 80% 60% at 20% 80%,
        rgba(6, 182, 212, 0.08) 0%,
        transparent 50%
      );
    pointer-events: none;
  }

  /* Decorative background */
  .hero__background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        ellipse 80% 50% at 50% -20%,
        rgba(255, 255, 255, 0.1) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 60% 40% at 100% 100%,
        rgba(54, 83, 149, 0.3) 0%,
        transparent 50%
      );
  }

  .hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
    align-items: center;
  }

  /* Hero image styles */
  .hero__image-wrapper {
    display: none;
  }

  .hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    object-fit: cover;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-6);
  }

  /* =================================================================
   * TYPOGRAPHY - Mobile First
   * =================================================================
   */

  /* Main Headline - H1 */
  .hero__headline {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-inverse);
    margin: 0;
    max-width: 20ch;
  }

  /* Value Proposition */
  .hero__value-prop {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    color: var(--color-primary-100);
    margin: 0;
    max-width: 35ch;
    padding: var(--spacing-3) var(--spacing-4);
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Subheadline with icon */
  .hero__subheadline {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-inverse);
    margin: 0;
    max-width: 50ch;
    padding: var(--spacing-3) var(--spacing-4);
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary-300);
  }

  .hero__subheadline-icon {
    flex-shrink: 0;
    color: var(--color-primary-300);
    margin-top: 2px;
  }

  /* =================================================================
   * CTA SECTION
   * =================================================================
   */

  .hero__cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-6);
    margin-top: var(--spacing-2);
  }

  .hero__cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-4);
    width: 100%;
  }

  .hero__cta-primary-wrapper {
    position: relative;
  }

  .hero__cta-primary-wrapper::before {
    content: '';
    position: absolute;
    inset: -8px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.25) 0%,
      transparent 70%
    );
    border-radius: var(--radius-xl);
    filter: blur(12px);
    z-index: -1;
    opacity: 0.8;
  }

  /* Full width CTAs on mobile */
  .hero__cta {
    width: 100%;
    max-width: 20rem;
  }

  /* Override button styles for better contrast in hero */
  .hero :global(.btn--primary) {
    background-color: var(--color-background);
    color: var(--color-primary-700);
    box-shadow: var(--shadow-lg);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero :global(.btn--primary:hover:not(.btn--disabled)) {
    background-color: var(--color-primary-50);
    color: var(--color-primary-800);
    box-shadow:
      var(--shadow-xl),
      0 0 30px rgba(255, 255, 255, 0.3);
    transform: translateY(-3px) scale(1.02);
  }

  .hero :global(.btn--primary:active:not(.btn--disabled)) {
    background-color: var(--color-primary-100);
    transform: translateY(0) scale(1);
  }

  .hero :global(.btn--primary:focus-visible) {
    box-shadow:
      0 0 0 var(--focus-ring-offset) var(--color-primary-800),
      0 0 0 calc(var(--focus-ring-offset) + var(--focus-ring-width)) var(--color-background);
  }

  .hero :global(.btn--secondary) {
    background-color: transparent;
    color: var(--color-text-inverse);
    border-color: rgba(255, 255, 255, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero :global(.btn--secondary:hover:not(.btn--disabled)) {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.8);
    color: var(--color-text-inverse);
    transform: translateY(-2px);
  }

  /* Inline trust badges CSS removed - now using TrustBadges component only */

  /* =================================================================
   * LOCATION CUE
   * =================================================================
   */

  .hero__location-cue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-4);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.06) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    margin-top: var(--spacing-4);
  }

  .hero__location-icon {
    color: var(--color-primary-200);
  }

  .hero__location-text {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
  }

  .hero__coordinates {
    font-size: var(--font-size-xs);
    font-family: var(--font-body);
    color: var(--color-primary-200);
    padding: var(--spacing-1) var(--spacing-2);
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
  }

  /* Interior border CSS removed - element no longer in use */

  /* =================================================================
   * DECORATIVE SKYLINE
   * =================================================================
   */

  .hero__skyline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    color: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .hero__skyline svg {
    width: 100%;
    height: 100%;
  }

  /* =================================================================
   * ANIMATED GRID BACKGROUND
   * =================================================================
   * A subtle, animated grid pattern that creates depth and tech aesthetic.
   * Features a pulsing glow effect that travels across the grid.
   * Uses CSS gradients for performance and GPU-accelerated animations.
   */

  .hero__grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    opacity: 0.75;
  }

  .hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 8s linear infinite, gridPulse 2s ease-in-out infinite;
  }

  /* Glowing highlight that moves across the grid
   * Uses multiple layered gradients with staggered animations
   * for smoother, more organic movement */
  .hero__grid-glow {
    position: absolute;
    inset: 0;
  }

  /* Primary glow - moves in a smooth circular path */
  .hero__grid-glow::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 500px 350px at 50% 50%,
        rgba(139, 92, 246, 0.28) 0%,
        rgba(59, 130, 246, 0.18) 40%,
        transparent 70%
      );
    animation: gridGlowFloat1 12s ease-in-out infinite;
    opacity: 0.9;
  }

  /* Secondary glow - moves in opposite direction for depth */
  .hero__grid-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 400px 300px at 50% 50%,
        rgba(99, 102, 241, 0.25) 0%,
        rgba(139, 92, 246, 0.15) 40%,
        transparent 70%
      );
    animation: gridGlowFloat2 15s ease-in-out infinite;
    opacity: 0.85;
  }

  @keyframes gridMove {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(50px, 50px);
    }
  }

  @keyframes gridPulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* Smooth circular motion for primary glow */
  @keyframes gridGlowFloat1 {
    0% {
      transform: translate(-20%, -15%);
    }
    25% {
      transform: translate(25%, -10%);
    }
    50% {
      transform: translate(20%, 20%);
    }
    75% {
      transform: translate(-15%, 15%);
    }
    100% {
      transform: translate(-20%, -15%);
    }
  }

  /* Counter-rotating motion for secondary glow */
  @keyframes gridGlowFloat2 {
    0% {
      transform: translate(15%, 20%);
    }
    33% {
      transform: translate(-20%, 5%);
    }
    66% {
      transform: translate(10%, -20%);
    }
    100% {
      transform: translate(15%, 20%);
    }
  }

  /* Responsive grid sizing */
  @media screen and (min-width: 640px) {
    .hero__grid-lines {
      background-size: 60px 60px;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.2) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.2) 1px, transparent 1px);
    }

    @keyframes gridMove {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(60px, 60px);
      }
    }
  }

  @media screen and (min-width: 1024px) {
    .hero__grid-bg {
      opacity: 0.85;
    }

    .hero__grid-lines {
      background-size: 80px 80px;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.22) 1px, transparent 1px);
    }

    @keyframes gridMove {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(80px, 80px);
      }
    }

    /* Larger glows on desktop */
    .hero__grid-glow::before {
      background:
        radial-gradient(
          ellipse 700px 450px at 50% 50%,
          rgba(139, 92, 246, 0.32) 0%,
          rgba(59, 130, 246, 0.2) 40%,
          transparent 70%
        );
    }

    .hero__grid-glow::after {
      background:
        radial-gradient(
          ellipse 550px 400px at 50% 50%,
          rgba(99, 102, 241, 0.28) 0%,
          rgba(139, 92, 246, 0.18) 40%,
          transparent 70%
        );
    }
  }

  /* =================================================================
   * FLOATING GRADIENT ORBS
   * =================================================================
   * Elegant, large gradient orbs that slowly float and pulse.
   * Creates a modern, calming tech aesthetic without distraction.
   * Uses GPU-accelerated transforms for smooth 60fps animation.
   */

  .hero__orbs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Base orb styles - large, soft, blurred gradient circles */
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.4;
    will-change: transform;
  }

  /* Orb 1 - Large purple/blue orb, top-left area */
  .hero__orb--1 {
    width: 400px;
    height: 400px;
    top: -10%;
    left: -5%;
    background: radial-gradient(
      circle,
      rgba(139, 92, 246, 0.6) 0%,
      rgba(99, 102, 241, 0.4) 40%,
      transparent 70%
    );
    animation: orbFloat1 20s ease-in-out infinite;
  }

  /* Orb 2 - Medium cyan/teal orb, right side */
  .hero__orb--2 {
    width: 300px;
    height: 300px;
    top: 20%;
    right: -5%;
    background: radial-gradient(
      circle,
      rgba(34, 211, 238, 0.5) 0%,
      rgba(59, 130, 246, 0.3) 50%,
      transparent 70%
    );
    animation: orbFloat2 25s ease-in-out infinite;
  }

  /* Orb 3 - Small bright accent orb, center-bottom */
  .hero__orb--3 {
    width: 200px;
    height: 200px;
    bottom: 10%;
    left: 30%;
    background: radial-gradient(
      circle,
      rgba(167, 139, 250, 0.5) 0%,
      rgba(139, 92, 246, 0.3) 50%,
      transparent 70%
    );
    animation: orbFloat3 18s ease-in-out infinite;
  }

  /* Orb 4 - Large soft orb, bottom-right */
  .hero__orb--4 {
    width: 350px;
    height: 350px;
    bottom: -15%;
    right: 10%;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.4) 0%,
      rgba(139, 92, 246, 0.2) 50%,
      transparent 70%
    );
    animation: orbFloat4 22s ease-in-out infinite;
  }

  /* Orb 5 - Extra subtle orb for depth, mid-left */
  .hero__orb--5 {
    width: 250px;
    height: 250px;
    top: 50%;
    left: 5%;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.35) 0%,
      rgba(99, 102, 241, 0.2) 50%,
      transparent 70%
    );
    animation: orbFloat5 28s ease-in-out infinite;
  }

  /* =================================================================
   * ACCENT SHAPE
   * =================================================================
   */

  .hero__accent-shape {
    position: absolute;
    top: 10%;
    right: -5%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  /* =================================================================
   * RESPONSIVE STYLES - Tablet (640px+)
   * =================================================================
   */

  @media screen and (min-width: 640px) {
    .hero {
      padding: var(--spacing-20) var(--spacing-6);
      min-height: 65vh;
    }

    .hero__content {
      gap: var(--spacing-6);
    }

    .hero__headline {
      font-size: var(--font-size-4xl);
      max-width: 18ch;
    }

    .hero__value-prop {
      font-size: var(--font-size-xl);
      padding: var(--spacing-4) var(--spacing-6);
    }

    .hero__subheadline {
      font-size: var(--font-size-md);
    }

    .hero__cta-group {
      flex-direction: row;
      justify-content: center;
    }

    .hero__cta {
      width: auto;
    }

    /* trust badge gap/sizing removed - using TrustBadges component */

    /* Floating Orbs - Tablet Enhancements */
    .hero__orb {
      filter: blur(70px);
      opacity: 0.45;
    }

    .hero__orb--1 {
      width: 500px;
      height: 500px;
    }

    .hero__orb--2 {
      width: 400px;
      height: 400px;
    }

  }

  /* =================================================================
   * RESPONSIVE STYLES - Desktop (1024px+)
   * =================================================================
