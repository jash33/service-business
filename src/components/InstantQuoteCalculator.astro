---
/**
 * InstantQuoteCalculator Component
 * A client-side calculator that estimates project costs based on selected options.
 * Provides instant pricing transparency and generates qualified leads.
 *
 * Features:
 * - Real-time price calculation as users select options
 * - Multiple option categories (project type, size, features, add-ons, timeline)
 * - Price range display with breakdown
 * - Accessible and responsive design
 * - Analytics tracking for selections
 * - Lead capture integration
 *
 * @example Basic usage
 * ```astro
 * <InstantQuoteCalculator />
 * ```
 *
 * @example With custom props
 * ```astro
 * <InstantQuoteCalculator
 *   title="Get Your Custom Quote"
 *   description="See exactly what your project will cost"
 *   ctaText="Request Full Quote"
 *   ctaHref="/contact"
 * />
 * ```
 */

import Button from './Button.astro';
import {
  CATEGORIES,
  CALCULATOR_OPTIONS,
  getOptionsByCategory,
  getDefaultSelections,
} from '../config/quote-calculator.config';
import type { InstantQuoteCalculatorProps } from '../types/quote-calculator';

interface Props extends InstantQuoteCalculatorProps {}

const {
  title = 'Instant Quote Calculator',
  description = 'Get an instant estimate for your web project. Select your options below to see your personalized quote.',
  ctaText = 'Get Your Full Quote',
  ctaHref = '/contact',
  showRange = true,
  showLeadCapture = false,
  class: className = '',
} = Astro.props;

// Get default selections for initial state
const defaultSelections = getDefaultSelections();

// Sort categories by order
const sortedCategories = [...CATEGORIES].sort((a, b) => a.order - b.order);

// SVG Icons
const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>`;
const infoIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>`;
const calculatorIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2zm4 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2z"/></svg>`;
---

<section
  class:list={['quote-calculator', className]}
  aria-labelledby="quote-calculator-heading"
  data-default-selections={JSON.stringify(defaultSelections)}
>
  <div class="quote-calculator__container">
    <!-- Header -->
    <header class="quote-calculator__header">
      <div class="quote-calculator__icon" aria-hidden="true" set:html={calculatorIcon} />
      <h2 id="quote-calculator-heading" class="quote-calculator__title">{title}</h2>
      <p class="quote-calculator__description">{description}</p>
    </header>

    <div class="quote-calculator__content">
      <!-- Options Panel -->
      <div class="quote-calculator__options">
        {sortedCategories.map((category) => {
          const options = getOptionsByCategory(category.id);
          const isSingleSelect = category.selectionType === 'single';

          return (
            <fieldset
              class="quote-calculator__category"
              data-category={category.id}
              data-selection-type={category.selectionType}
            >
              <legend class="quote-calculator__category-title">
                {category.title}
                {category.required && (
                  <span class="quote-calculator__required" aria-label="required">*</span>
                )}
              </legend>
              <p class="quote-calculator__category-description">{category.description}</p>

              <div class="quote-calculator__options-grid" role={isSingleSelect ? 'radiogroup' : 'group'}>
                {options.map((option) => {
                  const inputType = isSingleSelect ? 'radio' : 'checkbox';
                  const inputName = isSingleSelect ? category.id : `${category.id}-${option.id}`;
                  const isDefault = option.defaultSelected ||
                    (category.id === 'timeline' && option.id === 'timeline-standard');

                  return (
                    <div class="quote-calculator__option" data-option-id={option.id}>
                      <input
                        type={inputType}
                        id={`option-${option.id}`}
                        name={inputName}
                        value={option.id}
                        class="quote-calculator__option-input"
                        data-price={option.price}
                        data-category={category.id}
                        data-has-quantity={option.quantity ? 'true' : 'false'}
                        checked={isDefault}
                        aria-describedby={option.description ? `desc-${option.id}` : undefined}
                      />
                      <label for={`option-${option.id}`} class="quote-calculator__option-label">
                        <span class="quote-calculator__option-check" aria-hidden="true">
                          <span class="quote-calculator__option-check-icon" set:html={checkIcon} />
                        </span>
                        <span class="quote-calculator__option-content">
                          <span class="quote-calculator__option-name">{option.label}</span>
                          {option.description && (
                            <span id={`desc-${option.id}`} class="quote-calculator__option-description">
                              {option.description}
                            </span>
                          )}
                        </span>
                        <span class="quote-calculator__option-price" aria-label={`Price: ${option.price < 0 ? '-' : ''}$${Math.abs(option.price)}`}>
                          {option.price === 0 ? (
                            <span class="quote-calculator__option-price--included">Included</span>
                          ) : option.price < 0 ? (
                            <span class="quote-calculator__option-price--discount">-${Math.abs(option.price)}</span>
                          ) : (
                            <span>+${option.price}</span>
                          )}
                        </span>
                      </label>

                      {option.quantity && (
                        <div class="quote-calculator__quantity" data-option-id={option.id}>
                          <label for={`qty-${option.id}`} class="quote-calculator__quantity-label">
                            Quantity:
                          </label>
                          <div class="quote-calculator__quantity-controls">
                            <button
                              type="button"
                              class="quote-calculator__quantity-btn quote-calculator__quantity-btn--minus"
                              aria-label="Decrease quantity"
                              data-action="decrease"
                              data-option-id={option.id}
                            >
                              -
                            </button>
                            <input
                              type="number"
                              id={`qty-${option.id}`}
                              name={`qty-${option.id}`}
                              class="quote-calculator__quantity-input"
                              value={option.defaultQuantity || 1}
                              min="1"
                              max={option.maxQuantity || 10}
                              data-option-id={option.id}
                            />
                            <button
                              type="button"
                              class="quote-calculator__quantity-btn quote-calculator__quantity-btn--plus"
                              aria-label="Increase quantity"
                              data-action="increase"
                              data-option-id={option.id}
                            >
                              +
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </fieldset>
          );
        })}
      </div>

      <!-- Quote Summary Panel (Sticky) -->
      <aside class="quote-calculator__summary" aria-live="polite" aria-atomic="true">
        <div class="quote-calculator__summary-inner">
          <h3 class="quote-calculator__summary-title">Your Estimate</h3>

          <!-- Price Display -->
          <div class="quote-calculator__price-display">
            <div class="quote-calculator__price-main">
              <span class="quote-calculator__price-label">Estimated Total</span>
              <span class="quote-calculator__price-value" id="quote-total">$0</span>
            </div>
            {showRange && (
              <div class="quote-calculator__price-range" id="quote-range">
                <span class="quote-calculator__price-range-label">Price Range:</span>
                <span class="quote-calculator__price-range-value">$0 - $0</span>
              </div>
            )}
          </div>

          <!-- Breakdown -->
          <div class="quote-calculator__breakdown">
            <h4 class="quote-calculator__breakdown-title">Price Breakdown</h4>
            <ul class="quote-calculator__breakdown-list" id="quote-breakdown" role="list">
              <li class="quote-calculator__breakdown-empty">
                Select options to see breakdown
              </li>
            </ul>
          </div>

          <!-- Discount Notice -->
          <div class="quote-calculator__discount" id="quote-discount" hidden>
            <span class="quote-calculator__discount-icon" aria-hidden="true" set:html={infoIcon} />
            <span class="quote-calculator__discount-text"></span>
          </div>

          <!-- Notes -->
          <div class="quote-calculator__notes" id="quote-notes" hidden>
            <ul class="quote-calculator__notes-list" role="list"></ul>
          </div>

          <!-- CTA -->
          <div class="quote-calculator__cta">
            <Button
              text={ctaText}
              href={ctaHref}
              variant="primary"
              size="large"
              fullWidth={true}
              id="quote-cta-button"
            />
            <p class="quote-calculator__cta-note">
              No commitment required. We'll review your selections and provide a detailed proposal.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* =================================================================
   * QUOTE CALCULATOR SECTION
   * ================================================================= */
  .quote-calculator {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background-subtle);
  }

  .quote-calculator__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  /* =================================================================
   * HEADER
   * ================================================================= */
  .quote-calculator__header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }

  .quote-calculator__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--spacing-4);
  }

  .quote-calculator__icon :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  .quote-calculator__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
    line-height: var(--line-height-tight);
  }

  .quote-calculator__description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* =================================================================
   * CONTENT LAYOUT
   * ================================================================= */
  .quote-calculator__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 1024px) {
    .quote-calculator__content {
      grid-template-columns: 1fr 380px;
      align-items: start;
    }
  }

  /* =================================================================
   * OPTIONS PANEL
   * ================================================================= */
  .quote-calculator__options {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .quote-calculator__category {
    background-color: var(--color-background);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    margin: 0;
  }

  .quote-calculator__category-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
    padding: 0;
  }

  .quote-calculator__required {
    color: var(--color-error);
    margin-left: var(--spacing-1);
  }

  .quote-calculator__category-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-4) 0;
  }

  /* =================================================================
   * OPTIONS GRID
   * ================================================================= */
  .quote-calculator__options-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
  }

  @media (min-width: 640px) {
    .quote-calculator__options-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* =================================================================
   * INDIVIDUAL OPTION
   * ================================================================= */
  .quote-calculator__option {
    position: relative;
  }

  .quote-calculator__option-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .quote-calculator__option-label {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    background-color: var(--color-background);
    border: var(--border-width-2) solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition:
      border-color var(--duration-150) var(--ease-in-out),
      background-color var(--duration-150) var(--ease-in-out),
      box-shadow var(--duration-150) var(--ease-in-out);
  }

  .quote-calculator__option-label:hover {
    border-color: var(--color-primary-300);
    background-color: var(--color-primary-50);
  }

  .quote-calculator__option-input:focus-visible + .quote-calculator__option-label {
    outline: none;
    box-shadow: var(--focus-ring);
    border-color: var(--color-primary);
  }

  .quote-calculator__option-input:checked + .quote-calculator__option-label {
    border-color: var(--color-primary);
    background-color: var(--color-primary-50);
  }

  /* Check/Radio Indicator */
  .quote-calculator__option-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border: var(--border-width-2) solid var(--color-border-dark);
    border-radius: var(--radius-md);
    background-color: var(--color-background);
    transition:
      background-color var(--duration-150) var(--ease-in-out),
      border-color var(--duration-150) var(--ease-in-out);
  }

  /* Radio button style for single select */
  [data-selection-type="single"] .quote-calculator__option-check {
    border-radius: var(--radius-full);
  }

  .quote-calculator__option-check-icon {
    display: none;
    width: 1rem;
    height: 1rem;
    color: var(--color-text-inverse);
  }

  .quote-calculator__option-check-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .quote-calculator__option-input:checked + .quote-calculator__option-label .quote-calculator__option-check {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .quote-calculator__option-input:checked + .quote-calculator__option-label .quote-calculator__option-check-icon {
    display: block;
  }

  /* Option Content */
  .quote-calculator__option-content {
    flex: 1;
    min-width: 0;
  }

  .quote-calculator__option-name {
    display: block;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    line-height: var(--line-height-snug);
  }

  .quote-calculator__option-description {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--spacing-1);
    line-height: var(--line-height-normal);
  }

  /* Price Display */
  .quote-calculator__option-price {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .quote-calculator__option-price--included {
    color: var(--color-success);
  }

  .quote-calculator__option-price--discount {
    color: var(--color-success-dark);
  }

  /* =================================================================
   * QUANTITY CONTROLS
   * ================================================================= */
  .quote-calculator__quantity {
    display: none;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-4);
    margin-top: var(--spacing-2);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-md);
  }

  .quote-calculator__option-input:checked ~ .quote-calculator__quantity {
    display: flex;
  }

  .quote-calculator__quantity-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .quote-calculator__quantity-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
  }

  .quote-calculator__quantity-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    background-color: var(--color-background);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color var(--duration-150) var(--ease-in-out);
  }

  .quote-calculator__quantity-btn:hover {
    background-color: var(--color-primary-50);
  }

  .quote-calculator__quantity-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .quote-calculator__quantity-input {
    width: 3rem;
    text-align: center;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    background-color: var(--color-background);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-1) var(--spacing-2);
  }

  .quote-calculator__quantity-input::-webkit-inner-spin-button,
  .quote-calculator__quantity-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .quote-calculator__quantity-input[type='number'] {
    -moz-appearance: textfield;
  }

  /* =================================================================
   * SUMMARY PANEL
   * ================================================================= */
  .quote-calculator__summary {
    background-color: var(--color-background);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .quote-calculator__summary {
      position: sticky;
      top: var(--spacing-6);
    }
  }

  .quote-calculator__summary-inner {
    padding: var(--spacing-6);
  }

  .quote-calculator__summary-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-6) 0;
    padding-bottom: var(--spacing-4);
    border-bottom: var(--border-width-1) solid var(--color-border);
  }

  /* =================================================================
   * PRICE DISPLAY
   * ================================================================= */
  .quote-calculator__price-display {
    text-align: center;
    padding: var(--spacing-6);
    background: var(--gradient-primary);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-6);
  }

  .quote-calculator__price-main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .quote-calculator__price-label {
    font-size: var(--font-size-sm);
    color: var(--color-primary-100);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
  }

  .quote-calculator__price-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    line-height: var(--line-height-none);
  }

  .quote-calculator__price-range {
    margin-top: var(--spacing-3);
    padding-top: var(--spacing-3);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .quote-calculator__price-range-label {
    font-size: var(--font-size-xs);
    color: var(--color-primary-100);
    display: block;
  }

  .quote-calculator__price-range-value {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-inverse);
  }

  /* =================================================================
   * BREAKDOWN
   * ================================================================= */
  .quote-calculator__breakdown {
    margin-bottom: var(--spacing-6);
  }

  .quote-calculator__breakdown-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    margin: 0 0 var(--spacing-3) 0;
  }

  .quote-calculator__breakdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    max-height: 200px;
    overflow-y: auto;
  }

  .quote-calculator__breakdown-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    padding: var(--spacing-2) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .quote-calculator__breakdown-item:last-child {
    border-bottom: none;
  }

  .quote-calculator__breakdown-label {
    color: var(--color-text-secondary);
    flex: 1;
  }

  .quote-calculator__breakdown-quantity {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }

  .quote-calculator__breakdown-price {
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  .quote-calculator__breakdown-empty {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    font-style: italic;
    text-align: center;
    padding: var(--spacing-4) 0;
  }

  /* =================================================================
   * DISCOUNT NOTICE
   * ================================================================= */
  .quote-calculator__discount {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    padding: var(--spacing-3);
    background-color: var(--color-success-light);
    border: var(--border-width-1) solid var(--color-success-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-6);
  }

  .quote-calculator__discount[hidden] {
    display: none;
  }

  .quote-calculator__discount-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-success);
  }

  .quote-calculator__discount-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .quote-calculator__discount-text {
    font-size: var(--font-size-sm);
    color: var(--color-success-text);
  }

  /* =================================================================
   * NOTES
   * ================================================================= */
  .quote-calculator__notes {
    padding: var(--spacing-3);
    background-color: var(--color-info-light);
    border: var(--border-width-1) solid var(--color-info-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-6);
  }

  .quote-calculator__notes[hidden] {
    display: none;
  }

  .quote-calculator__notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quote-calculator__notes-list li {
    font-size: var(--font-size-sm);
    color: var(--color-info-text);
    padding-left: var(--spacing-4);
    position: relative;
  }

  .quote-calculator__notes-list li::before {
    content: '\2022';
    position: absolute;
    left: 0;
    color: var(--color-info);
  }

  /* =================================================================
   * CTA
   * ================================================================= */
  .quote-calculator__cta {
    border-top: var(--border-width-1) solid var(--color-border);
    padding-top: var(--spacing-6);
  }

  .quote-calculator__cta-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-align: center;
    margin: var(--spacing-3) 0 0;
  }

  /* =================================================================
   * RESPONSIVE
   * ================================================================= */
  @media (max-width: 1023px) {
    .quote-calculator {
      padding: var(--spacing-10) var(--spacing-4);
    }

    .quote-calculator__title {
      font-size: var(--font-size-3xl);
    }

    .quote-calculator__price-value {
      font-size: var(--font-size-4xl);
    }
  }

  @media (max-width: 639px) {
    .quote-calculator__category {
      padding: var(--spacing-4);
    }

    .quote-calculator__option-label {
      padding: var(--spacing-3);
    }

    .quote-calculator__summary-inner {
      padding: var(--spacing-4);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .quote-calculator__option-label,
    .quote-calculator__option-check,
    .quote-calculator__quantity-btn {
      transition: none;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */
  @media (forced-colors: active) {
    .quote-calculator__option-label {
      border: 2px solid CanvasText;
    }

    .quote-calculator__option-input:checked + .quote-calculator__option-label {
      border-color: Highlight;
      background-color: transparent;
    }

    .quote-calculator__option-check {
      border: 2px solid CanvasText;
    }

    .quote-calculator__option-input:checked + .quote-calculator__option-label .quote-calculator__option-check {
      background-color: Highlight;
      border-color: Highlight;
    }

    .quote-calculator__price-display {
      background: Highlight;
      color: HighlightText;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .quote-calculator {
      padding: var(--spacing-8) 0;
    }

    .quote-calculator__summary {
      position: static;
      box-shadow: none;
      border: 1px solid var(--color-border);
    }

    .quote-calculator__cta {
      display: none;
    }
  }
</style>

<script>
  /**
   * Instant Quote Calculator Client-Side Logic
   * Handles option selection, quantity changes, and price calculation
   */

  // Types for client-side
  interface CalculatorOption {
    id: string;
    label: string;
    category: string;
    price: number;
    quantity?: boolean;
    maxQuantity?: number;
    defaultQuantity?: number;
  }

  interface Selections {
    projectType: string | null;
    siteSize: string | null;
    features: string[];
    addons: string[];
    timeline: string | null;
    quantities: Record<string, number>;
  }

  interface CalculatorResult {
    total: number;
    rangeLow: number;
    rangeHigh: number;
    breakdown: Array<{
      label: string;
      price: number;
      quantity?: number;
    }>;
    discount: number;
    discountReason?: string;
    notes: string[];
    isComplete: boolean;
  }

  // Calculator configuration (embedded from server)
  const CALCULATOR_OPTIONS: CalculatorOption[] = [
    // Project Types
    { id: 'new-website', label: 'New Website', category: 'projectType', price: 800 },
    { id: 'website-redesign', label: 'Website Redesign', category: 'projectType', price: 600 },
    { id: 'landing-page', label: 'Landing Page', category: 'projectType', price: 400 },
    { id: 'ecommerce', label: 'E-Commerce Store', category: 'projectType', price: 1500 },

    // Site Sizes
    { id: 'size-small', label: '1-5 Pages', category: 'siteSize', price: 0 },
    { id: 'size-medium', label: '6-10 Pages', category: 'siteSize', price: 400 },
    { id: 'size-large', label: '11-20 Pages', category: 'siteSize', price: 800 },
    { id: 'size-enterprise', label: '20+ Pages', category: 'siteSize', price: 1500 },

    // Features
    { id: 'contact-form', label: 'Contact Form', category: 'features', price: 0 },
    { id: 'responsive-design', label: 'Mobile Responsive', category: 'features', price: 0 },
    { id: 'seo-basics', label: 'Basic SEO', category: 'features', price: 0 },
    { id: 'custom-graphics', label: 'Custom Graphics', category: 'features', price: 200 },
    { id: 'blog', label: 'Blog Section', category: 'features', price: 300 },
    { id: 'gallery', label: 'Photo Gallery', category: 'features', price: 150 },
    { id: 'testimonials', label: 'Testimonials Section', category: 'features', price: 100 },
    { id: 'booking-calendar', label: 'Booking Calendar', category: 'features', price: 400 },
    { id: 'payment-integration', label: 'Payment Integration', category: 'features', price: 350 },
    { id: 'product-catalog', label: 'Product Catalog', category: 'features', price: 500 },
    { id: 'newsletter', label: 'Newsletter Signup', category: 'features', price: 100 },
    { id: 'social-integration', label: 'Social Media Integration', category: 'features', price: 100 },
    { id: 'analytics', label: 'Analytics Setup', category: 'features', price: 100 },
    { id: 'live-chat', label: 'Live Chat Widget', category: 'features', price: 150 },

    // Add-ons
    { id: 'logo-design', label: 'Logo Design', category: 'addons', price: 300 },
    { id: 'copywriting', label: 'Website Copywriting', category: 'addons', price: 400 },
    { id: 'seo-advanced', label: 'Advanced SEO Package', category: 'addons', price: 500 },
    { id: 'hosting-annual', label: 'Annual Hosting', category: 'addons', price: 300 },
    { id: 'maintenance-monthly', label: 'Monthly Maintenance', category: 'addons', price: 100, quantity: true, maxQuantity: 12, defaultQuantity: 1 },
    { id: 'training-session', label: 'Training Session', category: 'addons', price: 150, quantity: true, maxQuantity: 4, defaultQuantity: 1 },
    { id: 'ssl-certificate', label: 'SSL Certificate', category: 'addons', price: 0 },
    { id: 'domain-setup', label: 'Domain Setup', category: 'addons', price: 50 },
    { id: 'email-setup', label: 'Business Email Setup', category: 'addons', price: 100 },

    // Timeline
    { id: 'timeline-standard', label: 'Standard (4-6 weeks)', category: 'timeline', price: 0 },
    { id: 'timeline-rush', label: 'Rush (2-3 weeks)', category: 'timeline', price: 500 },
    { id: 'timeline-urgent', label: 'Urgent (1-2 weeks)', category: 'timeline', price: 1000 },
    { id: 'timeline-flexible', label: 'Flexible Timeline', category: 'timeline', price: -100 },
  ];

  const PRICE_VARIANCE = 0.15;

  // State
  let selections: Selections = {
    projectType: null,
    siteSize: null,
    features: [],
    addons: [],
    timeline: 'timeline-standard',
    quantities: {},
  };

  // DOM elements
  const calculatorSection = document.querySelector('.quote-calculator') as HTMLElement;
  const totalDisplay = document.getElementById('quote-total') as HTMLElement;
  const rangeDisplay = document.getElementById('quote-range') as HTMLElement;
  const breakdownList = document.getElementById('quote-breakdown') as HTMLElement;
  const discountNotice = document.getElementById('quote-discount') as HTMLElement;
  const notesSection = document.getElementById('quote-notes') as HTMLElement;
  const ctaButton = document.getElementById('quote-cta-button') as HTMLAnchorElement;

  // Initialize from default selections
  function init(): void {
    // Load default selections from data attribute
    const defaultSelectionsAttr = calculatorSection?.getAttribute('data-default-selections');
    if (defaultSelectionsAttr) {
      try {
        const defaults = JSON.parse(defaultSelectionsAttr);
        selections = { ...selections, ...defaults };
      } catch {
        console.warn('Failed to parse default selections');
      }
    }

    // Set up event listeners
    setupEventListeners();

    // Calculate initial quote
    updateQuote();
  }

  function setupEventListeners(): void {
    // Option inputs (radio/checkbox)
    const inputs = document.querySelectorAll('.quote-calculator__option-input') as NodeListOf<HTMLInputElement>;
    inputs.forEach((input) => {
      input.addEventListener('change', handleOptionChange);
    });

    // Quantity controls
    const quantityButtons = document.querySelectorAll('.quote-calculator__quantity-btn') as NodeListOf<HTMLButtonElement>;
    quantityButtons.forEach((btn) => {
      btn.addEventListener('click', handleQuantityButtonClick);
    });

    const quantityInputs = document.querySelectorAll('.quote-calculator__quantity-input') as NodeListOf<HTMLInputElement>;
    quantityInputs.forEach((input) => {
      input.addEventListener('change', handleQuantityInputChange);
    });
  }

  function handleOptionChange(event: Event): void {
    const input = event.target as HTMLInputElement;
    const category = input.getAttribute('data-category') as string;
    const optionId = input.value;
    const isChecked = input.checked;

    switch (category) {
      case 'projectType':
        selections.projectType = isChecked ? optionId : null;
        break;
      case 'siteSize':
        selections.siteSize = isChecked ? optionId : null;
        break;
      case 'features':
        if (isChecked) {
          if (!selections.features.includes(optionId)) {
            selections.features.push(optionId);
          }
        } else {
          selections.features = selections.features.filter((id) => id !== optionId);
        }
        break;
      case 'addons':
        if (isChecked) {
          if (!selections.addons.includes(optionId)) {
            selections.addons.push(optionId);
            // Set default quantity
            const option = getOptionById(optionId);
            if (option?.quantity && option.defaultQuantity) {
              selections.quantities[optionId] = option.defaultQuantity;
            }
          }
        } else {
          selections.addons = selections.addons.filter((id) => id !== optionId);
          delete selections.quantities[optionId];
        }
        break;
      case 'timeline':
        selections.timeline = isChecked ? optionId : null;
        break;
    }

    updateQuote();
    trackSelection(category, optionId, isChecked);
  }

  function handleQuantityButtonClick(event: Event): void {
    const btn = event.target as HTMLButtonElement;
    const action = btn.getAttribute('data-action');
    const optionId = btn.getAttribute('data-option-id') as string;
    const option = getOptionById(optionId);

    if (!option) return;

    const currentQty = selections.quantities[optionId] || option.defaultQuantity || 1;
    const minQty = 1;
    const maxQty = option.maxQuantity || 10;

    let newQty = currentQty;
    if (action === 'increase' && currentQty < maxQty) {
      newQty = currentQty + 1;
    } else if (action === 'decrease' && currentQty > minQty) {
      newQty = currentQty - 1;
    }

    if (newQty !== currentQty) {
      selections.quantities[optionId] = newQty;
      // Update input display
      const input = document.getElementById(`qty-${optionId}`) as HTMLInputElement;
      if (input) input.value = newQty.toString();
      updateQuote();
    }
  }

  function handleQuantityInputChange(event: Event): void {
    const input = event.target as HTMLInputElement;
    const optionId = input.getAttribute('data-option-id') as string;
    const option = getOptionById(optionId);

    if (!option) return;

    let newQty = parseInt(input.value, 10);
    const minQty = 1;
    const maxQty = option.maxQuantity || 10;

    // Clamp value
    if (isNaN(newQty) || newQty < minQty) {
      newQty = minQty;
    } else if (newQty > maxQty) {
      newQty = maxQty;
    }

    input.value = newQty.toString();
    selections.quantities[optionId] = newQty;
    updateQuote();
  }

  function getOptionById(id: string): CalculatorOption | undefined {
    return CALCULATOR_OPTIONS.find((opt) => opt.id === id);
  }

  function calculateQuote(): CalculatorResult {
    const breakdown: Array<{ label: string; price: number; quantity?: number }> = [];
    const notes: string[] = [];
    let subtotal = 0;

    // Project type
    if (selections.projectType) {
      const option = getOptionById(selections.projectType);
      if (option) {
        breakdown.push({ label: option.label, price: option.price });
        subtotal += option.price;
      }
    }

    // Site size
    if (selections.siteSize) {
      const option = getOptionById(selections.siteSize);
      if (option && option.price > 0) {
        breakdown.push({ label: option.label, price: option.price });
        subtotal += option.price;
      }
    }

    // Features
    for (const featureId of selections.features) {
      const option = getOptionById(featureId);
      if (option && option.price > 0) {
        breakdown.push({ label: option.label, price: option.price });
        subtotal += option.price;
      }
    }

    // Add-ons with quantities
    for (const addonId of selections.addons) {
      const option = getOptionById(addonId);
      if (option && option.price !== 0) {
        const quantity = option.quantity
          ? (selections.quantities[addonId] || option.defaultQuantity || 1)
          : 1;
        const totalPrice = option.price * quantity;
        breakdown.push({
          label: option.label,
          price: totalPrice,
          quantity: option.quantity ? quantity : undefined,
        });
        subtotal += totalPrice;
      }
    }

    // Timeline
    let discount = 0;
    let discountReason: string | undefined;

    if (selections.timeline) {
      const option = getOptionById(selections.timeline);
      if (option) {
        if (option.price > 0) {
          breakdown.push({ label: option.label, price: option.price });
          subtotal += option.price;
          notes.push('Rush fee applied');
        } else if (option.price < 0) {
          discount = Math.abs(option.price);
          discountReason = 'Flexible timeline discount';
        }
      }
    }

    const total = Math.max(0, subtotal - discount);
    const variance = total * PRICE_VARIANCE;
    const rangeLow = Math.max(0, Math.round((total - variance) / 50) * 50);
    const rangeHigh = Math.round((total + variance) / 50) * 50;

    const isComplete = !!(selections.projectType && selections.siteSize);

    if (!isComplete) {
      notes.push('Select a project type and site size for an accurate quote');
    }

    return {
      total,
      rangeLow,
      rangeHigh,
      breakdown,
      discount,
      discountReason,
      notes,
      isComplete,
    };
  }

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(price);
  }

  function updateQuote(): void {
    const result = calculateQuote();

    // Update total
    if (totalDisplay) {
      totalDisplay.textContent = formatPrice(result.total);
    }

    // Update range
    if (rangeDisplay) {
      const rangeValue = rangeDisplay.querySelector('.quote-calculator__price-range-value');
      if (rangeValue) {
        rangeValue.textContent = `${formatPrice(result.rangeLow)} - ${formatPrice(result.rangeHigh)}`;
      }
    }

    // Update breakdown
    if (breakdownList) {
      if (result.breakdown.length > 0) {
        breakdownList.innerHTML = result.breakdown.map((item) => `
          <li class="quote-calculator__breakdown-item">
            <span class="quote-calculator__breakdown-label">
              ${item.label}
              ${item.quantity ? `<span class="quote-calculator__breakdown-quantity">(x${item.quantity})</span>` : ''}
            </span>
            <span class="quote-calculator__breakdown-price">${formatPrice(item.price)}</span>
          </li>
        `).join('');
      } else {
        breakdownList.innerHTML = `
          <li class="quote-calculator__breakdown-empty">
            Select options to see breakdown
          </li>
        `;
      }
    }

    // Update discount notice
    if (discountNotice) {
      if (result.discount > 0 && result.discountReason) {
        const discountText = discountNotice.querySelector('.quote-calculator__discount-text');
        if (discountText) {
          discountText.textContent = `${result.discountReason}: -${formatPrice(result.discount)}`;
        }
        discountNotice.hidden = false;
      } else {
        discountNotice.hidden = true;
      }
    }

    // Update notes
    if (notesSection) {
      if (result.notes.length > 0) {
        const notesList = notesSection.querySelector('.quote-calculator__notes-list');
        if (notesList) {
          notesList.innerHTML = result.notes.map((note) => `<li>${note}</li>`).join('');
        }
        notesSection.hidden = false;
      } else {
        notesSection.hidden = true;
      }
    }

    // Update CTA button with query params
    if (ctaButton) {
      const baseHref = ctaButton.getAttribute('href')?.split('?')[0] || '/contact';
      const params = new URLSearchParams();

      if (selections.projectType) {
        const option = getOptionById(selections.projectType);
        if (option) params.set('projectType', option.label);
      }

      if (selections.siteSize) {
        const option = getOptionById(selections.siteSize);
        if (option) params.set('siteSize', option.label);
      }

      params.set('estimatedBudget', formatPrice(result.total));
      params.set('source', 'quote-calculator');

      ctaButton.setAttribute('href', `${baseHref}?${params.toString()}`);
    }
  }

  function trackSelection(category: string, optionId: string, isSelected: boolean): void {
    // Track selection with analytics if available
    if (typeof window !== 'undefined' && (window as any).gtag) {
      (window as any).gtag('event', 'quote_calculator_selection', {
        category,
        option_id: optionId,
        is_selected: isSelected,
      });
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
