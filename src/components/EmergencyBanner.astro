---
/**
 * Emergency Phone Banner
 * A compact, always-visible sticky banner showing the emergency phone number.
 */
---

<div class="emergency-phone-banner" role="banner" aria-label="Emergency contact">
  <div class="emergency-phone-banner__inner">
    <svg class="emergency-phone-banner__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
      <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
    </svg>
    <span class="emergency-phone-banner__label">24/7 Emergency Service</span>
    <a href="tel:+18325552665" class="emergency-phone-banner__phone" aria-label="Call 24/7 emergency service at (832) 555-COOL">
      (832) 555-COOL
    </a>
  </div>
</div>

<style>
  .emergency-phone-banner {
    position: sticky;
    top: 0;
    z-index: var(--z-max, 9999);
    background: var(--color-accent);
    color: #fff;
    text-align: center;
  }

  .emergency-phone-banner__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2, 0.5rem);
    padding: var(--spacing-2, 0.5rem) var(--spacing-4, 1rem);
    max-width: var(--container-7xl, 1280px);
    margin: 0 auto;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: var(--font-weight-semibold, 600);
    line-height: 1;
  }

  .emergency-phone-banner__icon {
    flex-shrink: 0;
  }

  .emergency-phone-banner__label {
    white-space: nowrap;
  }

  .emergency-phone-banner__phone {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
    font-weight: var(--font-weight-bold, 700);
  }

  .emergency-phone-banner__phone:hover {
    text-decoration-thickness: 2px;
  }

  .emergency-phone-banner__phone:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    border-radius: var(--radius-sm, 2px);
  }

  @media (max-width: 480px) {
    .emergency-phone-banner__inner {
      font-size: var(--font-size-xs, 0.75rem);
      gap: var(--spacing-1-5, 0.375rem);
      padding: var(--spacing-1-5, 0.375rem) var(--spacing-3, 0.75rem);
    }
  }
</style>
