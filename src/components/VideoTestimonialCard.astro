---
/**
 * VideoTestimonialCard Component
 * A card component for displaying video testimonials with embedded video player.
 * Combines video playback with customer information for trust and credibility.
 *
 * Features:
 * - Lazy loading video (iframe only loads on user interaction)
 * - Thumbnail preview with play button overlay
 * - Customer quote, name, and location display
 * - Optional video duration display
 * - Keyboard accessible
 * - Screen reader friendly
 * - Hover animations for enhanced interactivity
 * - Respects reduced motion preferences
 *
 * @example Basic usage
 * ```astro
 * <VideoTestimonialCard
 *   id="video-1"
 *   name="John Smith"
 *   location="Houston, TX"
 *   quote="Their service exceeded all expectations!"
 *   videoProvider="youtube"
 *   videoId="dQw4w9WgXcQ"
 * />
 * ```
 *
 * @example With duration and custom thumbnail
 * ```astro
 * <VideoTestimonialCard
 *   id="video-2"
 *   name="Jane Doe"
 *   location="Sugar Land, TX"
 *   quote="Professional and reliable service."
 *   company="Local Business Co."
 *   title="Owner"
 *   videoProvider="vimeo"
 *   videoId="123456789"
 *   duration={145}
 *   thumbnailUrl="/images/custom-thumb.jpg"
 * />
 * ```
 */

import type { VideoTestimonialCardProps } from '../types/video-testimonial';
import { formatVideoDuration } from '../types/video-testimonial';
import VideoPlayer from './VideoPlayer.astro';

interface Props extends VideoTestimonialCardProps {}

const {
  id,
  name,
  location,
  quote,
  company,
  title,
  videoProvider,
  videoId,
  thumbnailUrl,
  duration,
  lazyLoad = true,
  class: className = '',
} = Astro.props;

// Build CSS classes
const cardClasses = [
  'video-testimonial-card',
  className,
].filter(Boolean).join(' ');

// Build attribution text
const attributionParts = [title, company].filter(Boolean);
const hasAttribution = attributionParts.length > 0;

// Format duration if provided
const formattedDuration = duration ? formatVideoDuration(duration) : null;
---

<article class={cardClasses} id={`video-testimonial-${id}`}>
  <!-- Video Player Section -->
  <div class="video-testimonial-card__video">
    <VideoPlayer
      videoProvider={videoProvider}
      videoId={videoId}
      thumbnailAlt={`Video testimonial from ${name}`}
      thumbnailUrl={thumbnailUrl}
      title={`${name}'s testimonial`}
      lazyLoad={lazyLoad}
    />

    <!-- Duration Badge -->
    {formattedDuration && (
      <div class="video-testimonial-card__duration" aria-label={`Video duration: ${formattedDuration}`}>
        <svg
          class="video-testimonial-card__duration-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
        <span>{formattedDuration}</span>
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="video-testimonial-card__content">
    <!-- Quote Icon -->
    <div class="video-testimonial-card__quote-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
      </svg>
    </div>

    <!-- Quote Text -->
    <blockquote class="video-testimonial-card__quote">
      <p class="video-testimonial-card__quote-text">{quote}</p>
    </blockquote>

    <!-- Customer Info -->
    <footer class="video-testimonial-card__footer">
      <cite class="video-testimonial-card__author">
        <span class="video-testimonial-card__name">{name}</span>
        {hasAttribution && (
          <span class="video-testimonial-card__attribution">
            {attributionParts.join(', ')}
          </span>
        )}
        <span class="video-testimonial-card__location">{location}</span>
      </cite>
    </footer>
  </div>
</article>

<style>
  /* =================================================================
   * VIDEO TESTIMONIAL CARD COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .video-testimonial-card {
    /* Layout */
    display: flex;
    flex-direction: column;
    gap: 0;

    /* Visual */
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);

    /* Overflow for rounded corners and shine effect */
    overflow: hidden;

    /* Positioning for pseudo-elements */
    position: relative;

    /* Animation */
    transition:
      box-shadow var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-out),
      border-color var(--duration-300) var(--ease-out);
  }

  /* Shine sweep effect - diagonal sweep across card on hover */
  .video-testimonial-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
    transition: left var(--duration-700) var(--ease-out);
    pointer-events: none;
    z-index: 1;
  }

  .video-testimonial-card:hover {
    box-shadow: var(--shadow-lg), var(--glow-card-hover);
    transform: translateY(-6px);
    border-color: var(--color-primary-300);
  }

  .video-testimonial-card:hover::after {
    left: 150%;
  }

  /* Video Section */
  .video-testimonial-card__video {
    position: relative;
    width: 100%;
    z-index: 2;
  }

  /* Ensure VideoPlayer fills container properly */
  .video-testimonial-card__video :global(.video-player) {
    border-radius: 0;
    box-shadow: none;
  }

  /* Duration Badge */
  .video-testimonial-card__duration {
    position: absolute;
    bottom: var(--spacing-3);
    left: var(--spacing-3);
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-2);
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: var(--radius-md);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    backdrop-filter: blur(4px);
    z-index: 3;
    pointer-events: none;
  }

  .video-testimonial-card__duration-icon {
    width: var(--spacing-3);
    height: var(--spacing-3);
    flex-shrink: 0;
  }

  /* Content Section */
  .video-testimonial-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-5);
    position: relative;
    z-index: 2;
  }

  /* Quote Icon */
  .video-testimonial-card__quote-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-8);
    height: var(--spacing-8);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-primary-100) 100%
    );
    border-radius: var(--radius-full);
    color: var(--color-primary);
    transition:
      background var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-spring-soft),
      box-shadow var(--duration-300) var(--ease-out);
  }

  .video-testimonial-card:hover .video-testimonial-card__quote-icon {
    background: linear-gradient(
      135deg,
      var(--color-primary-100) 0%,
      var(--color-primary-200) 100%
    );
    transform: scale(1.1);
    box-shadow: var(--glow-primary-sm);
  }

  .video-testimonial-card__quote-icon svg {
    width: var(--spacing-4);
    height: var(--spacing-4);
    transition: transform var(--duration-300) var(--ease-spring-soft);
  }

  .video-testimonial-card:hover .video-testimonial-card__quote-icon svg {
    transform: scale(1.1);
  }

  /* Quote Text */
  .video-testimonial-card__quote {
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .video-testimonial-card__quote-text {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    font-style: italic;
    transition: color var(--duration-200) var(--ease-out);

    /* Clamp to 3 lines for consistent card heights */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-testimonial-card:hover .video-testimonial-card__quote-text {
    color: var(--color-text-primary);
  }

  /* Footer / Author Info */
  .video-testimonial-card__footer {
    padding-top: var(--spacing-3);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .video-testimonial-card__author {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    font-style: normal;
  }

  .video-testimonial-card__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    transition: color var(--duration-200) var(--ease-out);
  }

  .video-testimonial-card:hover .video-testimonial-card__name {
    color: var(--color-primary);
  }

  .video-testimonial-card__attribution {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .video-testimonial-card__location {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    line-height: var(--line-height-normal);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  /* Tablet and up (768px) */
  @media screen and (min-width: 768px) {
    .video-testimonial-card__content {
      padding: var(--spacing-6);
      gap: var(--spacing-4);
    }

    .video-testimonial-card__quote-icon {
      width: var(--spacing-10);
      height: var(--spacing-10);
    }

    .video-testimonial-card__quote-icon svg {
      width: var(--spacing-5);
      height: var(--spacing-5);
    }

    .video-testimonial-card__quote-text {
      font-size: var(--font-size-base);
    }

    .video-testimonial-card__name {
      font-size: var(--font-size-base);
    }

    .video-testimonial-card__attribution,
    .video-testimonial-card__location {
      font-size: var(--font-size-sm);
    }

    .video-testimonial-card__duration {
      font-size: var(--font-size-sm);
      padding: var(--spacing-1) var(--spacing-3);
    }

    .video-testimonial-card__duration-icon {
      width: var(--spacing-4);
      height: var(--spacing-4);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * Respect user preferences for reduced motion
   * =================================================================
   */
  @media (prefers-reduced-motion: reduce) {
    .video-testimonial-card,
    .video-testimonial-card__quote-icon,
    .video-testimonial-card__name,
    .video-testimonial-card__quote-text,
    .video-testimonial-card__quote-icon svg {
      transition: none;
    }

    .video-testimonial-card::after {
      display: none;
    }

    .video-testimonial-card:hover {
      transform: none;
      /* Keep subtle visual feedback without motion */
      box-shadow: var(--shadow-lg);
    }

    .video-testimonial-card:hover .video-testimonial-card__quote-icon {
      transform: none;
      box-shadow: none;
    }

    .video-testimonial-card:hover .video-testimonial-card__quote-icon svg {
      transform: none;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * Windows High Contrast support
   * =================================================================
   */
  @media (forced-colors: active) {
    .video-testimonial-card {
      border: 2px solid CanvasText;
    }

    .video-testimonial-card__quote-icon {
      border: 1px solid CanvasText;
    }

    .video-testimonial-card__footer {
      border-top: 1px solid CanvasText;
    }

    .video-testimonial-card__duration {
      border: 1px solid CanvasText;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */
  @media print {
    .video-testimonial-card {
      box-shadow: none;
      border: 1px solid var(--color-border);
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .video-testimonial-card:hover {
      transform: none;
      box-shadow: none;
    }

    .video-testimonial-card__duration {
      background-color: var(--color-background-muted);
      color: var(--color-text-primary);
    }
  }
</style>
