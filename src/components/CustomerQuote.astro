---
/**
 * CustomerQuote Component
 * Displays customer testimonial quotes with name, title, company, and optional avatar.
 * Supports multiple display variants for different contexts.
 *
 * @example
 * ```astro
 * <CustomerQuote
 *   quote={caseStudyQuote}
 *   variant="featured"
 * />
 * ```
 */

import type { CustomerQuote, CustomerQuoteProps } from '../types/case-study';

interface Props extends CustomerQuoteProps {}

const {
  quote,
  class: className = '',
  variant = 'default',
} = Astro.props;
---

<blockquote class={`customer-quote customer-quote--${variant} ${className}`}>
  <div class="customer-quote__content">
    <svg class="customer-quote__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
    </svg>
    <p class="customer-quote__text">{quote.quote}</p>
  </div>

  <footer class="customer-quote__footer">
    {quote.avatar && (
      <img
        src={quote.avatar}
        alt={`${quote.name}'s photo`}
        class="customer-quote__avatar"
        width="56"
        height="56"
        loading="lazy"
      />
    )}
    <div class="customer-quote__attribution">
      <cite class="customer-quote__name">{quote.name}</cite>
      <span class="customer-quote__title">{quote.title}</span>
      <span class="customer-quote__company">{quote.company}</span>
    </div>
  </footer>
</blockquote>

<style>
  /* =================================================================
   * CUSTOMER QUOTE COMPONENT STYLES
   * ================================================================= */

  .customer-quote {
    position: relative;
    padding: var(--spacing-6);
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    margin: 0;
  }

  .customer-quote__content {
    position: relative;
  }

  .customer-quote__icon {
    position: absolute;
    top: calc(var(--spacing-4) * -1);
    left: 0;
    width: 40px;
    height: 40px;
    color: var(--color-primary-200);
    opacity: 0.5;
  }

  .customer-quote__text {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-text-primary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-6);
    padding-top: var(--spacing-4);
  }

  .customer-quote__footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  .customer-quote__avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--color-primary-100);
    flex-shrink: 0;
  }

  .customer-quote__attribution {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0-5);
  }

  .customer-quote__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    font-style: normal;
    color: var(--color-text-primary);
  }

  .customer-quote__title {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .customer-quote__company {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  /* =================================================================
   * FEATURED VARIANT
   * ================================================================= */

  .customer-quote--featured {
    padding: var(--spacing-8) var(--spacing-6);
    background: var(--gradient-surface);
    border: none;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .customer-quote--featured .customer-quote__icon {
    position: relative;
    top: 0;
    left: auto;
    margin: 0 auto var(--spacing-4);
    width: 48px;
    height: 48px;
    color: var(--color-primary);
    opacity: 0.3;
  }

  .customer-quote--featured .customer-quote__text {
    font-size: var(--font-size-xl);
    padding-top: 0;
  }

  .customer-quote--featured .customer-quote__footer {
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .customer-quote--featured .customer-quote__avatar {
    width: 72px;
    height: 72px;
    border-width: 4px;
  }

  .customer-quote--featured .customer-quote__attribution {
    align-items: center;
  }

  .customer-quote--featured .customer-quote__name {
    font-size: var(--font-size-lg);
  }

  /* =================================================================
   * INLINE VARIANT
   * ================================================================= */

  .customer-quote--inline {
    display: inline-flex;
    flex-direction: column;
    padding: var(--spacing-4);
    background-color: var(--color-primary-50);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .customer-quote--inline .customer-quote__icon {
    display: none;
  }

  .customer-quote--inline .customer-quote__text {
    font-size: var(--font-size-base);
    padding-top: 0;
    margin-bottom: var(--spacing-4);
  }

  .customer-quote--inline .customer-quote__footer {
    gap: var(--spacing-3);
  }

  .customer-quote--inline .customer-quote__avatar {
    width: 40px;
    height: 40px;
    border-width: 2px;
  }

  .customer-quote--inline .customer-quote__name {
    font-size: var(--font-size-sm);
  }

  .customer-quote--inline .customer-quote__title,
  .customer-quote--inline .customer-quote__company {
    font-size: var(--font-size-xs);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */

  @media screen and (min-width: 768px) {
    .customer-quote {
      padding: var(--spacing-8);
    }

    .customer-quote__text {
      font-size: var(--font-size-xl);
    }

    .customer-quote--featured {
      padding: var(--spacing-12) var(--spacing-8);
    }

    .customer-quote--featured .customer-quote__text {
      font-size: var(--font-size-2xl);
      max-width: 50ch;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media screen and (min-width: 1024px) {
    .customer-quote__icon {
      width: 48px;
      height: 48px;
    }
  }

  /* =================================================================
   * ANIMATIONS
   * ================================================================= */

  .customer-quote {
    opacity: 0;
    transform: translateY(20px);
    animation: quoteReveal 0.6s ease-out forwards;
  }

  @keyframes quoteReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */

  @media (prefers-reduced-motion: reduce) {
    .customer-quote {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */

  @media print {
    .customer-quote {
      background: none;
      box-shadow: none;
      border: 1px solid var(--color-border);
      page-break-inside: avoid;
    }

    .customer-quote__icon {
      display: none;
    }

    .customer-quote--featured {
      background: none;
    }
  }
</style>
