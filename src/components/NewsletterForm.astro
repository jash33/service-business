---
/**
 * Newsletter Signup Form Component
 * A compact, accessible newsletter signup form with GDPR compliance.
 *
 * Features:
 * - Email validation with real-time feedback
 * - Optional first name field
 * - GDPR consent checkbox
 * - Honeypot spam prevention
 * - Time-based submission validation
 * - Loading and success/error states
 * - Double opt-in support
 * - WCAG 2.1 AA compliant
 *
 * @example
 * ```astro
 * <NewsletterForm source="footer" variant="inline" />
 * ```
 */

import { newsletterConfig, getNewsletterEndpoint } from '../config/newsletter.config';
import type { NewsletterSource } from '../types/newsletter';

interface Props {
  /** Source identifier for analytics tracking */
  source?: NewsletterSource;
  /** Visual variant */
  variant?: 'inline' | 'stacked' | 'compact';
  /** Show first name field */
  showNameField?: boolean;
  /** Custom headline (overrides config) */
  headline?: string;
  /** Custom description (overrides config) */
  description?: string;
  /** Show headline and description */
  showHeader?: boolean;
  /** Additional CSS class */
  class?: string;
}

const {
  source = 'footer',
  variant = 'stacked',
  showNameField = false,
  headline = newsletterConfig.content.headline,
  description = newsletterConfig.content.description,
  showHeader = true,
  class: className = '',
} = Astro.props;

const content = newsletterConfig.content;
const validation = newsletterConfig.validation;
const endpoint = getNewsletterEndpoint();

// Generate unique ID for this form instance
const formId = `newsletter-form-${source}`;
---

<div
  class:list={['newsletter-form-wrapper', `newsletter-form--${variant}`, className]}
  data-newsletter-form
  data-source={source}
>
  {showHeader && (
    <div class="newsletter-form__header">
      <h3 class="newsletter-form__headline">{headline}</h3>
      <p class="newsletter-form__description">{description}</p>
    </div>
  )}

  <form
    id={formId}
    class="newsletter-form"
    novalidate
    data-endpoint={endpoint}
    data-source={source}
    aria-describedby={`${formId}-description`}
  >
    <!-- Hidden field for spam prevention timing -->
    <input type="hidden" name="formStartTime" value="" class="newsletter-form__start-time" />
    <input type="hidden" name="source" value={source} />

    <!-- Honeypot field - hidden from real users -->
    <div class="newsletter-form__honeypot" aria-hidden="true" tabindex="-1">
      <label for={`${formId}-website`}>Website URL</label>
      <input
        type="text"
        id={`${formId}-website`}
        name="websiteUrl"
        autocomplete="off"
        tabindex="-1"
      />
    </div>

    <p id={`${formId}-description`} class="sr-only">
      Subscribe to our newsletter. Required fields are marked with an asterisk (*).
    </p>

    <div class="newsletter-form__fields">
      {showNameField && (
        <div class="newsletter-form__field newsletter-form__field--name">
          <label for={`${formId}-name`} class="newsletter-form__label">
            <span class="sr-only">First Name (optional)</span>
          </label>
          <input
            type="text"
            id={`${formId}-name`}
            name="firstName"
            class="newsletter-form__input"
            autocomplete="given-name"
            maxlength={validation.maxFirstNameLength}
            placeholder={content.namePlaceholder}
            aria-describedby={`${formId}-name-error`}
            aria-invalid="false"
          />
          <span id={`${formId}-name-error`} class="newsletter-form__error" role="alert" aria-live="polite"></span>
        </div>
      )}

      <div class="newsletter-form__field newsletter-form__field--email">
        <label for={`${formId}-email`} class="newsletter-form__label">
          <span class="sr-only">Email Address (required)</span>
        </label>
        <input
          type="email"
          id={`${formId}-email`}
          name="email"
          class="newsletter-form__input"
          required
          autocomplete="email"
          maxlength={validation.maxEmailLength}
          placeholder={content.emailPlaceholder}
          aria-describedby={`${formId}-email-error`}
          aria-invalid="false"
        />
        <span id={`${formId}-email-error`} class="newsletter-form__error" role="alert" aria-live="polite"></span>
      </div>

      <button
        type="submit"
        class="newsletter-form__submit"
        aria-describedby={`${formId}-submit-hint`}
      >
        <span class="newsletter-form__submit-text">{content.buttonText}</span>
        <span class="newsletter-form__submit-loading" aria-hidden="true">
          <svg class="newsletter-form__spinner" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="31.4 31.4" />
          </svg>
        </span>
      </button>
      <span id={`${formId}-submit-hint`} class="sr-only">
        Subscribe to receive our newsletter
      </span>
    </div>

    <!-- GDPR Consent -->
    {validation.requireGDPRConsent && (
      <div class="newsletter-form__consent">
        <label class="newsletter-form__consent-label">
          <input
            type="checkbox"
            name="gdprConsent"
            class="newsletter-form__consent-checkbox"
            required
            aria-describedby={`${formId}-consent-error`}
          />
          <span class="newsletter-form__consent-checkmark"></span>
          <span class="newsletter-form__consent-text">
            {content.gdprLabel}
            <a href={newsletterConfig.privacyPolicyUrl} class="newsletter-form__link" target="_blank" rel="noopener">
              Privacy Policy
            </a>
          </span>
        </label>
        <span id={`${formId}-consent-error`} class="newsletter-form__error" role="alert" aria-live="polite"></span>
      </div>
    )}

    <!-- Privacy Notice -->
    <p class="newsletter-form__privacy">{content.privacyNotice}</p>

    <!-- Success Message -->
    <div
      class="newsletter-form__message newsletter-form__message--success"
      role="status"
      aria-live="polite"
      hidden
    >
      <svg class="newsletter-form__message-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
      <span class="newsletter-form__message-text">{content.successMessage}</span>
    </div>

    <!-- Error Message -->
    <div
      class="newsletter-form__message newsletter-form__message--error"
      role="alert"
      aria-live="assertive"
      hidden
    >
      <svg class="newsletter-form__message-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
      </svg>
      <span class="newsletter-form__message-text">{content.errorMessage}</span>
    </div>
  </form>
</div>

<style>
  /* =================================================================
   * NEWSLETTER FORM STYLES
   * ================================================================= */

  .newsletter-form-wrapper {
    width: 100%;
  }

  /* -----------------------------------------------------------------
   * Header
   * ----------------------------------------------------------------- */
  .newsletter-form__header {
    margin-bottom: var(--spacing-4);
  }

  .newsletter-form__headline {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: inherit;
    margin: 0 0 var(--spacing-2);
    letter-spacing: var(--letter-spacing-wide);
  }

  .newsletter-form__description {
    font-size: var(--font-size-sm);
    color: inherit;
    opacity: 0.9;
    margin: 0;
    line-height: var(--line-height-relaxed);
  }

  /* -----------------------------------------------------------------
   * Form Layout
   * ----------------------------------------------------------------- */
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .newsletter-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  /* Stacked variant (default) */
  .newsletter-form--stacked .newsletter-form__fields {
    flex-direction: column;
  }

  /* Inline variant */
  @media (min-width: 640px) {
    .newsletter-form--inline .newsletter-form__fields {
      flex-direction: row;
      align-items: flex-start;
    }

    .newsletter-form--inline .newsletter-form__field--email {
      flex: 1;
    }

    .newsletter-form--inline .newsletter-form__submit {
      flex-shrink: 0;
    }
  }

  /* Compact variant */
  .newsletter-form--compact .newsletter-form__header {
    margin-bottom: var(--spacing-3);
  }

  .newsletter-form--compact .newsletter-form__headline {
    font-size: var(--font-size-base);
  }

  .newsletter-form--compact .newsletter-form__description {
    font-size: var(--font-size-xs);
  }

  /* -----------------------------------------------------------------
   * Honeypot (Spam Prevention)
   * ----------------------------------------------------------------- */
  .newsletter-form__honeypot {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
    height: 0;
    width: 0;
    overflow: hidden;
  }

  /* -----------------------------------------------------------------
   * Form Field
   * ----------------------------------------------------------------- */
  .newsletter-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .newsletter-form__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: inherit;
  }

  /* -----------------------------------------------------------------
   * Input
   * ----------------------------------------------------------------- */
  .newsletter-form__input {
    width: 100%;
    padding: var(--spacing-3) var(--spacing-4);
    font-size: var(--font-size-base);
    font-family: var(--font-body);
    color: var(--color-text-primary);
    background-color: var(--color-background);
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-150) var(--ease-in-out),
      box-shadow var(--duration-150) var(--ease-in-out);
  }

  .newsletter-form__input::placeholder {
    color: var(--color-text-placeholder);
  }

  .newsletter-form__input:hover:not(:focus):not([aria-invalid="true"]) {
    border-color: var(--color-border-dark);
  }

  .newsletter-form__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 var(--focus-ring-width) var(--color-primary-100);
  }

  .newsletter-form__input[aria-invalid="true"] {
    border-color: var(--color-error);
    background-color: var(--color-error-light);
  }

  .newsletter-form__input[data-valid="true"] {
    border-color: var(--color-success);
  }

  /* -----------------------------------------------------------------
   * Submit Button
   * ----------------------------------------------------------------- */
  .newsletter-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-6);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-150) var(--ease-in-out),
      transform var(--duration-150) var(--ease-in-out),
      box-shadow var(--duration-150) var(--ease-in-out);
  }

  .newsletter-form__submit:hover:not(:disabled) {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .newsletter-form__submit:active:not(:disabled) {
    background-color: var(--color-primary-active);
    transform: translateY(0);
  }

  .newsletter-form__submit:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 var(--focus-ring-offset) var(--color-background),
      0 0 0 calc(var(--focus-ring-offset) + var(--focus-ring-width)) var(--color-primary);
  }

  .newsletter-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-form__submit-loading {
    display: none;
  }

  .newsletter-form__submit[data-loading="true"] .newsletter-form__submit-text {
    display: none;
  }

  .newsletter-form__submit[data-loading="true"] .newsletter-form__submit-loading {
    display: flex;
  }

  .newsletter-form__spinner {
    width: 1.25rem;
    height: 1.25rem;
    animation: newsletter-spin 1s linear infinite;
  }

  @keyframes newsletter-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* -----------------------------------------------------------------
   * GDPR Consent Checkbox
   * ----------------------------------------------------------------- */
  .newsletter-form__consent {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .newsletter-form__consent-label {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    cursor: pointer;
    font-size: var(--font-size-xs);
    line-height: var(--line-height-relaxed);
    color: inherit;
    opacity: 0.9;
  }

  .newsletter-form__consent-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .newsletter-form__consent-checkmark {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-150) var(--ease-in-out);
  }

  .newsletter-form__consent-checkmark::after {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--color-primary);
    border-radius: 2px;
    opacity: 0;
    transform: scale(0);
    transition: all var(--duration-150) var(--ease-in-out);
  }

  .newsletter-form__consent-checkbox:checked + .newsletter-form__consent-checkmark {
    border-color: var(--color-primary);
  }

  .newsletter-form__consent-checkbox:checked + .newsletter-form__consent-checkmark::after {
    opacity: 1;
    transform: scale(1);
  }

  .newsletter-form__consent-checkbox:focus-visible + .newsletter-form__consent-checkmark {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .newsletter-form__consent-checkbox[aria-invalid="true"] + .newsletter-form__consent-checkmark {
    border-color: var(--color-error);
  }

  .newsletter-form__consent-text {
    flex: 1;
  }

  .newsletter-form__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .newsletter-form__link:hover {
    opacity: 0.8;
  }

  /* -----------------------------------------------------------------
   * Privacy Notice
   * ----------------------------------------------------------------- */
  .newsletter-form__privacy {
    font-size: var(--font-size-xs);
    color: inherit;
    opacity: 0.7;
    margin: 0;
  }

  /* -----------------------------------------------------------------
   * Error Message
   * ----------------------------------------------------------------- */
  .newsletter-form__error {
    font-size: var(--font-size-xs);
    color: var(--color-error-text);
    min-height: 1rem;
  }

  .newsletter-form__error:empty {
    display: none;
  }

  /* -----------------------------------------------------------------
   * Form Messages (Success/Error)
   * ----------------------------------------------------------------- */
  .newsletter-form__message {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    padding: var(--spacing-3);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-sm);
  }

  .newsletter-form__message[hidden] {
    display: none;
  }

  .newsletter-form__message--success {
    background-color: var(--color-success-light);
    border: var(--border-width-1) solid var(--color-success-border);
    color: var(--color-success-text);
  }

  .newsletter-form__message--error {
    background-color: var(--color-error-light);
    border: var(--border-width-1) solid var(--color-error-border);
    color: var(--color-error-text);
  }

  .newsletter-form__message-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* -----------------------------------------------------------------
   * Screen Reader Only
   * ----------------------------------------------------------------- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* -----------------------------------------------------------------
   * Form Submitted State
   * ----------------------------------------------------------------- */
  .newsletter-form[data-submitted="true"] .newsletter-form__fields,
  .newsletter-form[data-submitted="true"] .newsletter-form__consent,
  .newsletter-form[data-submitted="true"] .newsletter-form__privacy {
    display: none;
  }

  /* -----------------------------------------------------------------
   * Reduced Motion
   * ----------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .newsletter-form__submit {
      transition: none;
    }

    .newsletter-form__submit:hover:not(:disabled) {
      transform: none;
    }

    .newsletter-form__spinner {
      animation: none;
    }

    .newsletter-form__input {
      transition: none;
    }

    .newsletter-form__consent-checkmark,
    .newsletter-form__consent-checkmark::after {
      transition: none;
    }
  }

  /* -----------------------------------------------------------------
   * High Contrast Mode
   * ----------------------------------------------------------------- */
  @media (forced-colors: active) {
    .newsletter-form__input {
      border: 2px solid CanvasText;
    }

    .newsletter-form__input:focus {
      outline: 3px solid Highlight;
      outline-offset: 2px;
    }

    .newsletter-form__submit {
      border: 2px solid currentColor;
    }

    .newsletter-form__consent-checkmark {
      border: 2px solid CanvasText;
    }
  }
</style>

<script>
  /**
   * Newsletter Form Client-Side Logic
   * Handles validation, spam prevention, and form submission
   */

  // Email validation regex
  const EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;

  // Validation config
  const VALIDATION = {
    maxEmailLength: 254,
    maxFirstNameLength: 50,
    minSubmitTime: 2000,
  };

  // Initialize all newsletter forms on the page
  function initNewsletterForms(): void {
    const formWrappers = document.querySelectorAll('[data-newsletter-form]');

    formWrappers.forEach((wrapper) => {
      const form = wrapper.querySelector('form') as HTMLFormElement;
      if (!form || form.dataset.initialized === 'true') return;

      form.dataset.initialized = 'true';
      initForm(form);
    });
  }

  function initForm(form: HTMLFormElement): void {
    const startTimeInput = form.querySelector('.newsletter-form__start-time') as HTMLInputElement;
    const honeypotInput = form.querySelector('[name="websiteUrl"]') as HTMLInputElement;
    const emailInput = form.querySelector('[name="email"]') as HTMLInputElement;
    const nameInput = form.querySelector('[name="firstName"]') as HTMLInputElement | null;
    const consentCheckbox = form.querySelector('[name="gdprConsent"]') as HTMLInputElement | null;
    const submitButton = form.querySelector('.newsletter-form__submit') as HTMLButtonElement;
    const successMessage = form.querySelector('.newsletter-form__message--success') as HTMLElement;
    const errorMessage = form.querySelector('.newsletter-form__message--error') as HTMLElement;

    // Set form start time
    let formStartTime = Date.now();
    if (startTimeInput) {
      startTimeInput.value = formStartTime.toString();
    }

    // Email validation
    function validateEmail(value: string): string | null {
      const trimmed = value.trim();
      if (!trimmed) return 'Email is required';
      if (trimmed.length > VALIDATION.maxEmailLength) {
        return `Email must be less than ${VALIDATION.maxEmailLength} characters`;
      }
      if (!EMAIL_REGEX.test(trimmed)) return 'Please enter a valid email address';
      return null;
    }

    // Name validation
    function validateName(value: string): string | null {
      const trimmed = value.trim();
      if (trimmed && trimmed.length > VALIDATION.maxFirstNameLength) {
        return `Name must be less than ${VALIDATION.maxFirstNameLength} characters`;
      }
      return null;
    }

    // Consent validation
    function validateConsent(checked: boolean): string | null {
      if (!checked) return 'Please accept the privacy policy to subscribe';
      return null;
    }

    // Set field error
    function setFieldError(input: HTMLElement | null, error: string | null): void {
      if (!input) return;

      const errorId = input.getAttribute('aria-describedby')?.split(' ').find(id => id.includes('error'));
      const errorElement = errorId ? document.getElementById(errorId) : null;

      if (error) {
        input.setAttribute('aria-invalid', 'true');
        input.removeAttribute('data-valid');
        if (errorElement) errorElement.textContent = error;
      } else {
        input.setAttribute('aria-invalid', 'false');
        if (input instanceof HTMLInputElement && input.value.trim()) {
          input.setAttribute('data-valid', 'true');
        }
        if (errorElement) errorElement.textContent = '';
      }
    }

    // Clear field error
    function clearFieldError(input: HTMLElement | null): void {
      if (!input) return;
      input.setAttribute('aria-invalid', 'false');
      input.removeAttribute('data-valid');

      const errorId = input.getAttribute('aria-describedby')?.split(' ').find(id => id.includes('error'));
      const errorElement = errorId ? document.getElementById(errorId) : null;
      if (errorElement) errorElement.textContent = '';
    }

    // Set loading state
    function setLoadingState(loading: boolean): void {
      submitButton.disabled = loading;
      submitButton.setAttribute('data-loading', loading.toString());
    }

    // Show message
    function showMessage(type: 'success' | 'error', customMessage?: string): void {
      if (type === 'success') {
        successMessage.hidden = false;
        errorMessage.hidden = true;
        form.setAttribute('data-submitted', 'true');
      } else {
        errorMessage.hidden = false;
        successMessage.hidden = true;
        if (customMessage) {
          const textEl = errorMessage.querySelector('.newsletter-form__message-text');
          if (textEl) textEl.textContent = customMessage;
        }
      }
    }

    // Check honeypot
    function isHoneypotFilled(): boolean {
      return honeypotInput?.value.trim() !== '';
    }

    // Check submission time
    function isSubmittedTooQuickly(): boolean {
      const elapsed = Date.now() - formStartTime;
      return elapsed < VALIDATION.minSubmitTime;
    }

    // Event listeners
    emailInput?.addEventListener('blur', () => {
      setFieldError(emailInput, validateEmail(emailInput.value));
    });

    emailInput?.addEventListener('input', () => {
      clearFieldError(emailInput);
    });

    nameInput?.addEventListener('blur', () => {
      setFieldError(nameInput, validateName(nameInput.value));
    });

    nameInput?.addEventListener('input', () => {
      clearFieldError(nameInput);
    });

    consentCheckbox?.addEventListener('change', () => {
      if (consentCheckbox.checked) {
        clearFieldError(consentCheckbox);
      }
    });

    // Form submission
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Reset messages
      successMessage.hidden = true;
      errorMessage.hidden = true;

      // Check honeypot
      if (isHoneypotFilled()) {
        showMessage('success'); // Silently reject spam
        return;
      }

      // Check submission time
      if (isSubmittedTooQuickly()) {
        showMessage('error', 'Please take a moment to fill out the form.');
        return;
      }

      // Validate all fields
      let hasErrors = false;

      const emailError = validateEmail(emailInput?.value || '');
      if (emailError) {
        setFieldError(emailInput, emailError);
        hasErrors = true;
      }

      if (nameInput) {
        const nameError = validateName(nameInput.value);
        if (nameError) {
          setFieldError(nameInput, nameError);
          hasErrors = true;
        }
      }

      if (consentCheckbox) {
        const consentError = validateConsent(consentCheckbox.checked);
        if (consentError) {
          setFieldError(consentCheckbox, consentError);
          hasErrors = true;
        }
      }

      if (hasErrors) {
        const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement;
        firstInvalid?.focus();
        return;
      }

      // Submit form
      setLoadingState(true);

      try {
        const endpoint = form.dataset.endpoint;
        const source = form.dataset.source;

        const formData = {
          email: emailInput?.value.trim(),
          firstName: nameInput?.value.trim() || undefined,
          gdprConsent: consentCheckbox?.checked ?? true,
          consentTimestamp: Date.now(),
          source,
          _subject: 'New Newsletter Subscription',
        };

        if (!endpoint) {
          // Simulated submission for development
          console.log('Newsletter subscription (simulated):', formData);
          await new Promise(resolve => setTimeout(resolve, 1000));
          showMessage('success');
          return;
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(formData),
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));

          if (response.status === 400) {
            throw new Error('Please check your email address and try again.');
          }
          if (response.status === 429) {
            throw new Error('Too many requests. Please try again later.');
          }
          throw new Error(errorData.message || 'Subscription failed. Please try again.');
        }

        showMessage('success');

        // Store subscription status
        localStorage.setItem('newsletter_subscribed', 'true');

        // Dispatch custom event for analytics
        window.dispatchEvent(new CustomEvent('newsletter:subscribed', {
          detail: { source, email: emailInput?.value.trim() }
        }));

      } catch (error) {
        console.error('Newsletter subscription error:', error);
        showMessage('error', error instanceof Error ? error.message : 'Subscription failed. Please try again.');
      } finally {
        setLoadingState(false);
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNewsletterForms);
  } else {
    initNewsletterForms();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
