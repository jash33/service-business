---
/**
 * RelatedPosts Component
 * A grid of related blog posts displayed at the end of an article.
 *
 * Features:
 * - Compact article cards
 * - Category and reading time display
 * - Hover effects
 * - Responsive grid layout
 * - Accessible markup
 *
 * @example
 * ```astro
 * <RelatedPosts
 *   posts={relatedArticles}
 *   title="Related Articles"
 * />
 * ```
 */

import type { BlogArticle } from '../types/blog';

interface Props {
  /** Array of related posts to display */
  posts: BlogArticle[];
  /** Section title */
  title?: string;
  /** Maximum number of posts to show */
  maxPosts?: number;
  /** Additional CSS class names */
  class?: string;
}

const {
  posts = [],
  title = 'Related Articles',
  maxPosts = 3,
  class: className = '',
} = Astro.props;

// Limit posts to maxPosts
const displayPosts = posts.slice(0, maxPosts);

// Don't render if no posts
if (displayPosts.length === 0) {
  return null;
}

// Helper to format category
function formatCategory(category: string): string {
  return category
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

<section class={`related-posts ${className}`} aria-labelledby="related-posts-title">
  <div class="related-posts__header">
    <h2 class="related-posts__title" id="related-posts-title">{title}</h2>
    <div class="related-posts__line" aria-hidden="true"></div>
  </div>

  <div class="related-posts__grid">
    {displayPosts.map((post) => (
      <article class="related-post">
        <a href={`/blog/${post.slug}`} class="related-post__image-link">
          <div class="related-post__image-container">
            <img
              src={post.featuredImage.src}
              alt={post.featuredImage.alt}
              class="related-post__image"
              width={post.featuredImage.width || 400}
              height={post.featuredImage.height || 225}
              loading="lazy"
            />
            <div class="related-post__overlay" aria-hidden="true"></div>
          </div>
        </a>

        <div class="related-post__content">
          <div class="related-post__meta">
            <span class="related-post__category">{formatCategory(post.category)}</span>
            <span class="related-post__separator" aria-hidden="true">·</span>
            <span class="related-post__reading-time">{post.readingTime} min read</span>
          </div>

          <h3 class="related-post__title">
            <a href={`/blog/${post.slug}`} class="related-post__title-link">
              {post.title}
            </a>
          </h3>
        </div>
      </article>
    ))}
  </div>

  <div class="related-posts__footer">
    <a href="/blog" class="related-posts__view-all">
      View All Articles
      <svg class="related-posts__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<style>
  /* =================================================================
   * RELATED POSTS STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention
   */

  .related-posts {
    padding: var(--spacing-12) 0;
  }

  .related-posts__header {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-8);
  }

  .related-posts__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    white-space: nowrap;
  }

  .related-posts__line {
    flex: 1;
    height: 2px;
    background: var(--gradient-border-fade);
    border-radius: var(--radius-full);
  }

  .related-posts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  /* Individual post card */
  .related-post {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      box-shadow var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-out),
      border-color var(--duration-300) var(--ease-out);
  }

  .related-post:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-primary-200);
  }

  .related-post__image-link {
    display: block;
    text-decoration: none;
  }

  .related-post__image-container {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .related-post__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-500) var(--ease-out);
  }

  .related-post:hover .related-post__image {
    transform: scale(1.05);
  }

  .related-post__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.1) 100%
    );
    opacity: 0;
    transition: opacity var(--duration-300) var(--ease-out);
  }

  .related-post:hover .related-post__overlay {
    opacity: 1;
  }

  .related-post__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: var(--spacing-4);
  }

  .related-post__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
  }

  .related-post__category {
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .related-post__separator {
    color: var(--color-border);
  }

  .related-post__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-post__title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .related-post__title-link:hover {
    color: var(--color-primary);
  }

  .related-post__title-link:focus-visible {
    outline: none;
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Footer with view all link */
  .related-posts__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-8);
  }

  .related-posts__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-6);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--duration-150) var(--ease-in-out),
      border-color var(--duration-150) var(--ease-in-out),
      gap var(--duration-150) var(--ease-in-out);
  }

  .related-posts__view-all:hover {
    background-color: var(--color-primary-100);
    border-color: var(--color-primary-300);
    gap: var(--spacing-3);
  }

  .related-posts__view-all:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .related-posts__arrow {
    width: 20px;
    height: 20px;
    transition: transform var(--duration-150) var(--ease-in-out);
  }

  .related-posts__view-all:hover .related-posts__arrow {
    transform: translateX(4px);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */

  @media screen and (min-width: 640px) {
    .related-posts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .related-posts__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .related-post__title {
      font-size: var(--font-size-lg);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .related-post,
    .related-post__image,
    .related-post__overlay,
    .related-post__title-link,
    .related-posts__view-all,
    .related-posts__arrow {
      transition: none;
    }

    .related-post:hover {
      transform: none;
    }

    .related-post:hover .related-post__image {
      transform: none;
    }

    .related-posts__view-all:hover {
      gap: var(--spacing-2);
    }

    .related-posts__view-all:hover .related-posts__arrow {
      transform: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .related-posts {
      page-break-before: always;
    }

    .related-post {
      box-shadow: none;
      border: 1px solid #ccc;
    }

    .related-posts__footer {
      display: none;
    }
  }
</style>
