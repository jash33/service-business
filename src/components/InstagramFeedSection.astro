---
/**
 * Instagram Feed Section Component
 *
 * Displays recent Instagram posts in a responsive grid gallery format.
 * Showcases behind-the-scenes work and builds visual brand presence
 * on the website.
 *
 * Features:
 * - Responsive grid layout (2-4 columns)
 * - Fetches posts from Instagram Basic Display API
 * - Loading, error, and empty states
 * - Fallback mode when not configured
 * - Placeholder posts for development
 * - Call-to-action button to follow on Instagram
 * - Analytics tracking integration
 * - Astro View Transitions support
 *
 * @example
 * ```astro
 * ---
 * import InstagramFeedSection from '../components/InstagramFeedSection.astro';
 * ---
 * <InstagramFeedSection
 *   title="Follow Us on Instagram"
 *   subtitle="See our latest work and inspiration"
 *   postCount={6}
 *   columns={3}
 * />
 * ```
 */

import type { InstagramFeedSectionProps, InstagramPost } from '../types/instagram-feed';
import {
  INSTAGRAM_ACCESS_TOKEN,
  INSTAGRAM_USERNAME,
  isInstagramFeedConfigured,
  instagramFeedContent,
  getInstagramProfileUrl,
  getPlaceholderPosts,
  buildInstagramApiUrl,
  transformApiResponse,
} from '../config/instagram-feed.config';
import InstagramFeedCard from './InstagramFeedCard.astro';

interface Props extends InstagramFeedSectionProps {}

const {
  title = instagramFeedContent.default.title,
  subtitle = instagramFeedContent.default.subtitle,
  postCount = 6,
  columns = 3,
  showVideos = true,
  className = '',
  trackAnalytics = true,
  ctaText,
  profileUrl,
} = Astro.props;

// Check if Instagram Feed is configured
const isConfigured = isInstagramFeedConfigured();

// Get the profile URL
const instagramUrl = profileUrl || getInstagramProfileUrl();

// Get CTA text
const followText = ctaText || instagramFeedContent.cta.text;

// Fetch posts or use placeholders
let posts: InstagramPost[] = [];
let fetchError: string | null = null;

if (isConfigured) {
  try {
    // Fetch from Instagram API at build time
    const apiUrl = buildInstagramApiUrl(INSTAGRAM_ACCESS_TOKEN, postCount);
    const response = await fetch(apiUrl);

    if (!response.ok) {
      throw new Error(`Instagram API error: ${response.status}`);
    }

    const data = await response.json();

    if (data.data && Array.isArray(data.data)) {
      posts = transformApiResponse(data.data);

      // Filter out videos if not showing them
      if (!showVideos) {
        posts = posts.filter(post => post.mediaType !== 'VIDEO');
      }

      // Limit to requested count
      posts = posts.slice(0, postCount);
    }
  } catch (error) {
    console.error('Error fetching Instagram posts:', error);
    fetchError = error instanceof Error ? error.message : 'Failed to load posts';
    // Use placeholders as fallback
    posts = getPlaceholderPosts(postCount);
  }
} else {
  // Use placeholders when not configured (development mode)
  posts = getPlaceholderPosts(postCount);
}

// Fallback content
const fallback = instagramFeedContent.fallback;
const errorContent = instagramFeedContent.error;
const emptyContent = instagramFeedContent.empty;

// Grid columns CSS class
const gridColumnsClass = `instagram-feed__grid--cols-${Math.min(Math.max(columns, 2), 4)}`;
---

<section
  class:list={['instagram-feed', className]}
  aria-labelledby={title ? 'instagram-feed-heading' : undefined}
  data-track-analytics={trackAnalytics}
>
  {/* Section Header */}
  {(title || subtitle) && (
    <div class="instagram-feed__header">
      {title && (
        <h2 id="instagram-feed-heading" class="instagram-feed__title">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="instagram-feed__subtitle">
          {subtitle}
        </p>
      )}
    </div>
  )}

  {/* Feed Container */}
  <div class="instagram-feed__container">
    {isConfigured || posts.length > 0 ? (
      <>
        {/* Posts Grid */}
        {posts.length > 0 ? (
          <div class:list={['instagram-feed__grid', gridColumnsClass]}>
            {posts.map((post, index) => (
              <InstagramFeedCard
                post={post}
                lazyLoad={index > 3}
                trackAnalytics={trackAnalytics}
                index={index}
              />
            ))}
          </div>
        ) : (
          /* Empty State */
          <div class="instagram-feed__empty">
            <div class="instagram-feed__empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <h3 class="instagram-feed__empty-title">{emptyContent.title}</h3>
            <p class="instagram-feed__empty-text">{emptyContent.message}</p>
          </div>
        )}

        {/* CTA Button */}
        <div class="instagram-feed__cta">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="instagram-feed__cta-button"
            data-action="follow"
          >
            <svg
              class="instagram-feed__cta-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>{followText}</span>
          </a>
        </div>

        {/* Error Notice (if fetch failed but showing placeholders) */}
        {fetchError && (
          <p class="instagram-feed__error-notice">
            <small>Note: Showing sample images. {errorContent.message}</small>
          </p>
        )}
      </>
    ) : (
      /* Fallback when not configured */
      <div class="instagram-feed__fallback">
        <div class="instagram-feed__fallback-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <h3 class="instagram-feed__fallback-title">{fallback.title}</h3>
        <p class="instagram-feed__fallback-text">{fallback.message}</p>
        <p class="instagram-feed__fallback-hint">
          Configure <code>PUBLIC_INSTAGRAM_ACCESS_TOKEN</code> in your environment variables to enable this feature.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  /* =================================================================
   * INSTAGRAM FEED SECTION COMPONENT
   * ================================================================= */

  .instagram-feed {
    padding: var(--spacing-12) var(--spacing-4);
    background-color: var(--color-background-subtle);
  }

  /* -----------------------------------------------------------------
   * Header
   * ----------------------------------------------------------------- */
  .instagram-feed__header {
    max-width: var(--container-4xl);
    margin: 0 auto var(--spacing-8);
    text-align: center;
  }

  .instagram-feed__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3);
    letter-spacing: var(--letter-spacing-tight);
  }

  .instagram-feed__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-relaxed);
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* -----------------------------------------------------------------
   * Container
   * ----------------------------------------------------------------- */
  .instagram-feed__container {
    max-width: var(--container-6xl);
    margin: 0 auto;
  }

  /* -----------------------------------------------------------------
   * Grid Layout
   * ----------------------------------------------------------------- */
  .instagram-feed__grid {
    display: grid;
    gap: var(--spacing-4);
  }

  /* 2 columns */
  .instagram-feed__grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  /* 3 columns (default) */
  .instagram-feed__grid--cols-3 {
    grid-template-columns: repeat(2, 1fr);
  }

  /* 4 columns */
  .instagram-feed__grid--cols-4 {
    grid-template-columns: repeat(2, 1fr);
  }

  /* Tablet and up */
  @media (min-width: 640px) {
    .instagram-feed__grid--cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .instagram-feed__grid--cols-4 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .instagram-feed__grid--cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* -----------------------------------------------------------------
   * CTA Button
   * ----------------------------------------------------------------- */
  .instagram-feed__cta {
    margin-top: var(--spacing-8);
    text-align: center;
  }

  .instagram-feed__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-6);

    /* Instagram gradient */
    background: linear-gradient(
      45deg,
      #f09433 0%,
      #e6683c 25%,
      #dc2743 50%,
      #cc2366 75%,
      #bc1888 100%
    );
    background-size: 200% 200%;

    color: #ffffff;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition:
      background-position var(--duration-300) var(--ease-out),
      transform var(--duration-150) var(--ease-out),
      box-shadow var(--duration-300) var(--ease-out);
  }

  .instagram-feed__cta-button:hover {
    background-position: 100% 0;
    transform: var(--transform-hover-lift-sm);
    box-shadow: 0 4px 15px rgba(225, 48, 108, 0.4);
  }

  .instagram-feed__cta-button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(225, 48, 108, 0.4);
  }

  .instagram-feed__cta-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* -----------------------------------------------------------------
   * Error Notice
   * ----------------------------------------------------------------- */
  .instagram-feed__error-notice {
    text-align: center;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-4);
  }

  /* -----------------------------------------------------------------
   * Empty State
   * ----------------------------------------------------------------- */
  .instagram-feed__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-16) var(--spacing-6);
    min-height: 300px;
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .instagram-feed__empty-icon {
    width: 4rem;
    height: 4rem;
    color: var(--color-text-tertiary);
    margin-bottom: var(--spacing-4);
    opacity: 0.5;
  }

  .instagram-feed__empty-icon svg {
    width: 100%;
    height: 100%;
  }

  .instagram-feed__empty-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2);
  }

  .instagram-feed__empty-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 30rem;
  }

  /* -----------------------------------------------------------------
   * Fallback State
   * ----------------------------------------------------------------- */
  .instagram-feed__fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-16) var(--spacing-6);
    min-height: 300px;
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .instagram-feed__fallback-icon {
    width: 5rem;
    height: 5rem;
    margin-bottom: var(--spacing-6);
    opacity: 0.6;

    /* Instagram gradient for icon */
    background: linear-gradient(
      45deg,
      #f09433 0%,
      #e6683c 25%,
      #dc2743 50%,
      #cc2366 75%,
      #bc1888 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .instagram-feed__fallback-icon svg {
    width: 100%;
    height: 100%;
  }

  .instagram-feed__fallback-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3);
  }

  .instagram-feed__fallback-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-4);
    max-width: 30rem;
    line-height: var(--line-height-relaxed);
  }

  .instagram-feed__fallback-hint {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .instagram-feed__fallback-hint code {
    background-color: var(--color-background-muted);
    padding: var(--spacing-1) var(--spacing-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */

  @media (max-width: 767px) {
    .instagram-feed {
      padding: var(--spacing-8) var(--spacing-3);
    }

    .instagram-feed__header {
      margin-bottom: var(--spacing-6);
    }

    .instagram-feed__title {
      font-size: var(--font-size-2xl);
    }

    .instagram-feed__subtitle {
      font-size: var(--font-size-base);
    }

    .instagram-feed__grid {
      gap: var(--spacing-3);
    }

    .instagram-feed__cta {
      margin-top: var(--spacing-6);
    }

    .instagram-feed__fallback {
      padding: var(--spacing-8) var(--spacing-4);
    }

    .instagram-feed__fallback-icon {
      width: 4rem;
      height: 4rem;
    }

    .instagram-feed__fallback-title {
      font-size: var(--font-size-xl);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */

  @media (prefers-reduced-motion: reduce) {
    .instagram-feed__cta-button {
      transition: none;
    }

    .instagram-feed__cta-button:hover {
      transform: none;
    }
  }

  /* =================================================================
   * DARK MODE
   * ================================================================= */

  :global(html[data-theme="dark"]) .instagram-feed {
    background-color: var(--color-background);
  }

  :global(html[data-theme="dark"]) .instagram-feed__fallback,
  :global(html[data-theme="dark"]) .instagram-feed__empty {
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  :global(html[data-theme="dark"]) .instagram-feed__fallback-hint code {
    background-color: var(--color-background-muted);
  }

  :global(html[data-theme="dark"]) .instagram-feed__fallback-icon {
    opacity: 0.8;
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */

  @media (forced-colors: active) {
    .instagram-feed__fallback,
    .instagram-feed__empty {
      border: 2px solid currentColor;
    }

    .instagram-feed__cta-button {
      border: 2px solid currentColor;
      background: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */

  @media print {
    .instagram-feed {
      padding: var(--spacing-6) 0;
      background: none;
    }

    .instagram-feed__grid {
      display: none;
    }

    .instagram-feed__cta {
      display: none;
    }

    .instagram-feed__fallback {
      box-shadow: none;
      border: 1px solid var(--color-border);
    }
  }
</style>

<script>
  /**
   * Track Instagram follow button clicks for analytics
   */
  function initInstagramFeedTracking() {
    const sections = document.querySelectorAll('.instagram-feed[data-track-analytics="true"]');

    sections.forEach((section) => {
      const ctaButton = section.querySelector('.instagram-feed__cta-button[data-action="follow"]');

      if (ctaButton) {
        ctaButton.addEventListener('click', () => {
          // Track with Google Analytics if available
          if (window.gtag) {
            window.gtag('event', 'instagram_profile_clicked', {
              event_category: 'Social',
              event_label: 'Instagram Follow Button',
            });
          }
        });
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstagramFeedTracking);
  } else {
    initInstagramFeedTracking();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initInstagramFeedTracking);
</script>
