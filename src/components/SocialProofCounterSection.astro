---
/**
 * SocialProofCounterSection Component
 * A responsive section displaying key business metrics with animated counting effects.
 * Builds credibility through quantifiable achievements that animate when scrolled into view.
 *
 * Features:
 * - Responsive grid: 2 columns (mobile) -> 4 columns (desktop)
 * - Animated counter cards with Intersection Observer
 * - Section heading and subheading
 * - Configurable column count
 * - Accessible with proper semantic structure
 * - Smooth animations with reduced motion support
 * - Staggered card entrance animations
 *
 * @example Basic usage
 * ```astro
 * <SocialProofCounterSection
 *   heading="Our Track Record"
 *   metrics={[
 *     { id: 'projects', value: 50, suffix: '+', label: 'Projects Completed' },
 *     { id: 'years', value: 10, suffix: '+', label: 'Years Experience' },
 *   ]}
 * />
 * ```
 *
 * @example With configuration object
 * ```astro
 * <SocialProofCounterSection
 *   id={SOCIAL_PROOF_COUNTER_CONFIG.id}
 *   heading={SOCIAL_PROOF_COUNTER_CONFIG.heading}
 *   subheading={SOCIAL_PROOF_COUNTER_CONFIG.subheading}
 *   metrics={SOCIAL_PROOF_METRICS}
 *   columns={SOCIAL_PROOF_COUNTER_CONFIG.columns}
 * />
 * ```
 */

import type { SocialProofCounterSectionProps, CounterMetric } from '../types/social-proof-counter';
import CounterCard from './CounterCard.astro';

interface Props extends SocialProofCounterSectionProps {}

const {
  heading = 'By the Numbers',
  subheading,
  metrics = [],
  id = 'social-proof',
  columns = 4,
  animationDuration = 2000,
  class: className = '',
} = Astro.props;

// Build CSS classes
const sectionClasses = [
  'social-proof-section',
  `social-proof-section--cols-${columns}`,
  className,
].filter(Boolean).join(' ');

// Check if we have metrics to display
const hasMetrics = metrics && metrics.length > 0;
---

<section class={sectionClasses} id={id} aria-labelledby={`${id}-heading`}>
  <div class="social-proof-section__container">
    <!-- Section Header -->
    <header class="social-proof-section__header section-heading--decorated">
      <h2 id={`${id}-heading`} class="social-proof-section__heading">{heading}</h2>
      {subheading && (
        <p class="social-proof-section__subheading">{subheading}</p>
      )}
    </header>

    <!-- Metrics Grid -->
    {hasMetrics ? (
      <div class="social-proof-section__grid" role="list">
        {metrics.map((metric) => (
          <div class="social-proof-section__card-wrapper" role="listitem">
            <CounterCard
              id={metric.id}
              value={metric.value}
              prefix={metric.prefix}
              suffix={metric.suffix}
              label={metric.label}
              icon={metric.icon}
              description={metric.description}
              animationDuration={animationDuration}
            />
          </div>
        ))}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="social-proof-section__empty" role="status" aria-live="polite">
        <p class="social-proof-section__empty-text">Business metrics coming soon.</p>
      </div>
    )}
  </div>
</section>

<style>
  /* =================================================================
   * SOCIAL PROOF COUNTER SECTION STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .social-proof-section {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background-subtle);
    position: relative;
    overflow: hidden;
  }

  /* Subtle decorative background */
  .social-proof-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(
        ellipse at 20% 80%,
        rgba(139, 92, 246, 0.03) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse at 80% 20%,
        rgba(6, 182, 212, 0.03) 0%,
        transparent 50%
      );
    pointer-events: none;
  }

  .social-proof-section__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Section Header */
  .social-proof-section__header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }

  .social-proof-section__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .social-proof-section__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* Metrics Grid */
  .social-proof-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-4);
  }

  /* Card wrapper for grid/list semantics */
  .social-proof-section__card-wrapper {
    display: contents;
  }

  /* Empty State */
  .social-proof-section__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-16) var(--spacing-8);
    background-color: var(--color-background-elevated);
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
  }

  .social-proof-section__empty-text {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-tertiary);
    margin: 0;
    text-align: center;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  /* Small phones (480px) */
  @media screen and (min-width: 480px) {
    .social-proof-section__grid {
      gap: var(--spacing-6);
    }
  }

  /* Tablet (768px) */
  @media screen and (min-width: 768px) {
    .social-proof-section {
      padding: var(--spacing-20) var(--spacing-8);
    }

    .social-proof-section__header {
      margin-bottom: var(--spacing-16);
    }

    .social-proof-section__heading {
      font-size: var(--font-size-4xl);
    }

    /* 2 columns on tablet by default */
    .social-proof-section__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-8);
    }

    /* 3 columns if specified */
    .social-proof-section--cols-3 .social-proof-section__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Desktop (1024px) */
  @media screen and (min-width: 1024px) {
    /* Full column count based on props */
    .social-proof-section--cols-3 .social-proof-section__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .social-proof-section--cols-4 .social-proof-section__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Large Desktop (1280px) */
  @media screen and (min-width: 1280px) {
    .social-proof-section {
      padding: var(--spacing-24) var(--spacing-8);
    }
  }

  /* =================================================================
   * ANIMATION - Staggered card appearance
   * =================================================================
   */
  .social-proof-section__grid > :global(*) {
    animation: fadeSlideUp 0.5s ease-out backwards;
  }

  .social-proof-section__grid > :global(*:nth-child(1)) {
    animation-delay: 0.1s;
  }

  .social-proof-section__grid > :global(*:nth-child(2)) {
    animation-delay: 0.2s;
  }

  .social-proof-section__grid > :global(*:nth-child(3)) {
    animation-delay: 0.3s;
  }

  .social-proof-section__grid > :global(*:nth-child(4)) {
    animation-delay: 0.4s;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * Respect user preferences for reduced motion
   * =================================================================
   */
  @media (prefers-reduced-motion: reduce) {
    .social-proof-section__grid > :global(*) {
      animation: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */
  @media print {
    .social-proof-section {
      padding: var(--spacing-8) 0;
      background-color: transparent;
    }

    .social-proof-section::before {
      display: none;
    }

    .social-proof-section__grid {
      gap: var(--spacing-4);
    }

    .social-proof-section__grid > :global(*) {
      animation: none;
    }
  }
</style>
