---
/**
 * BlogArticleCard Component
 * A card component for displaying a single blog article with image,
 * title, excerpt, category, tags, author, and publication date.
 *
 * Features:
 * - Optimized featured image with WebP support and lazy loading
 * - Hover effects with image zoom and overlay transitions
 * - Category badge and tag display
 * - Author information with avatar
 * - Reading time indicator
 * - Featured article highlighting
 * - Accessible with proper heading hierarchy
 * - Touch-friendly target sizes on mobile (44x44px minimum)
 * - Reduced motion support
 *
 * @example Basic usage
 * ```astro
 * <BlogArticleCard
 *   id="article-1"
 *   title="Web Design Trends 2024"
 *   excerpt="Discover the latest trends..."
 *   featuredImage={{ src: '/blog/trends.jpg', alt: 'Trends' }}
 *   category="web-design"
 *   tags={[{ slug: 'design', name: 'Design' }]}
 *   author={{ name: 'Team' }}
 *   publishedDate="2024-01-15"
 *   readingTime={8}
 *   slug="web-design-trends-2024"
 * />
 * ```
 */

import type { BlogArticleCardProps } from '../types/blog';
import OptimizedImage from './OptimizedImage.astro';

interface Props extends BlogArticleCardProps {}

const {
  id,
  title,
  excerpt,
  featuredImage,
  category,
  tags = [],
  author,
  publishedDate,
  readingTime,
  featured = false,
  slug,
  class: className = '',
  showLoadingState = true,
  displayAsFeatured = false,
} = Astro.props;

// Build CSS classes
const cardClasses = [
  'blog-card',
  featured && 'blog-card--featured',
  displayAsFeatured && 'blog-card--display-featured',
  className,
].filter(Boolean).join(' ');

// Format the publication date
const formattedDate = new Date(publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Format category for display
const categoryLabel = category
  .split('-')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

// Article URL
const articleUrl = `/blog/${slug}`;
---

<article class={cardClasses} id={`article-${id}`}>
  <!-- Image Container with hover effects -->
  <a href={articleUrl} class="blog-card__image-link" tabindex="-1" aria-hidden="true">
    <div class="blog-card__image-container">
      <div class="blog-card__image-wrapper">
        <OptimizedImage
          src={featuredImage.src}
          srcWebP={featuredImage.srcWebP}
          alt={featuredImage.alt}
          width={featuredImage.width || 600}
          height={featuredImage.height || 400}
          loading="lazy"
          decoding="async"
          class="blog-card__image"
          wrapperClass="blog-card__optimized-image-wrapper"
          placeholder={showLoadingState}
          placeholderSrc={featuredImage.placeholder}
          responsive
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          objectFit="cover"
        />
      </div>

      <!-- Hover overlay -->
      <div class="blog-card__overlay" aria-hidden="true">
        <span class="blog-card__overlay-text">Read Article</span>
      </div>

      <!-- Featured badge -->
      {featured && (
        <span class="blog-card__badge blog-card__badge--featured" aria-label="Featured article">Featured</span>
      )}

      <!-- Category badge -->
      <span class="blog-card__badge blog-card__badge--category">{categoryLabel}</span>
    </div>
  </a>

  <!-- Content -->
  <div class="blog-card__content">
    <!-- Meta info -->
    <div class="blog-card__meta">
      <time class="blog-card__date" datetime={publishedDate}>
        {formattedDate}
      </time>
      <span class="blog-card__meta-separator" aria-hidden="true">·</span>
      <span class="blog-card__reading-time">
        {readingTime} min read
      </span>
    </div>

    <h3 class="blog-card__title">
      <a href={articleUrl} class="blog-card__title-link">{title}</a>
    </h3>

    <p class="blog-card__excerpt">{excerpt}</p>

    <!-- Tags -->
    {tags.length > 0 && (
      <ul class="blog-card__tags" aria-label="Article tags">
        {tags.slice(0, 3).map((tag) => (
          <li class="blog-card__tag">
            <a href={`/blog?tag=${tag.slug}`} class="blog-card__tag-link">
              {tag.name}
            </a>
          </li>
        ))}
        {tags.length > 3 && (
          <li class="blog-card__tag blog-card__tag--more">
            +{tags.length - 3} more
          </li>
        )}
      </ul>
    )}
  </div>

  <!-- Footer with author info -->
  <div class="blog-card__footer">
    <div class="blog-card__author">
      {author.avatar && (
        <img
          src={author.avatar}
          alt={`${author.name}'s avatar`}
          class="blog-card__author-avatar"
          width="32"
          height="32"
          loading="lazy"
        />
      )}
      <span class="blog-card__author-name">{author.name}</span>
    </div>
    <a href={articleUrl} class="blog-card__read-more" aria-label={`Read more about ${title}`}>
      Read More
      <svg class="blog-card__arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  /* =================================================================
   * BLOG CARD COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .blog-card {
    /* Layout */
    display: flex;
    flex-direction: column;
    height: 100%;

    /* Positioning for pseudo-elements */
    position: relative;

    /* Visual */
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;

    /* Animation */
    transition:
      box-shadow var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-out),
      border-color var(--duration-300) var(--ease-out);
  }

  /* Shine sweep effect */
  .blog-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
    transition: left var(--duration-700) var(--ease-out);
    pointer-events: none;
    z-index: 10;
  }

  .blog-card:hover {
    box-shadow: var(--shadow-lg), var(--glow-card-hover);
    transform: translateY(-6px);
    border-color: var(--color-primary-200);
  }

  .blog-card:hover::after {
    left: 150%;
  }

  .blog-card--featured {
    border-color: var(--color-primary-300);
  }

  .blog-card--featured:hover {
    border-color: var(--color-primary-400);
    box-shadow: var(--shadow-xl), var(--shadow-primary), var(--glow-primary-sm);
  }

  /* Featured display variant - larger card for hero position */
  .blog-card--display-featured {
    grid-column: 1 / -1;
  }

  @media screen and (min-width: 768px) {
    .blog-card--display-featured {
      flex-direction: row;
    }

    .blog-card--display-featured .blog-card__image-link {
      flex: 0 0 50%;
    }

    .blog-card--display-featured .blog-card__image-container {
      aspect-ratio: 16 / 10;
      height: 100%;
    }

    .blog-card--display-featured .blog-card__content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .blog-card--display-featured .blog-card__title {
      font-size: var(--font-size-2xl);
    }

    .blog-card--display-featured .blog-card__excerpt {
      -webkit-line-clamp: 4;
    }
  }

  /* =================================================================
   * IMAGE CONTAINER
   * ================================================================= */
  .blog-card__image-link {
    display: block;
    text-decoration: none;
  }

  .blog-card__image-container {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-background-muted);
  }

  /* OptimizedImage wrapper integration */
  .blog-card__optimized-image-wrapper {
    width: 100%;
    height: 100%;
  }

  :global(.blog-card__optimized-image-wrapper .optimized-image-wrapper) {
    height: 100%;
  }

  .blog-card__image-wrapper {
    position: absolute;
    inset: 0;
    transition: transform var(--duration-300) var(--ease-out);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-500) var(--ease-out);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.08);
  }

  /* =================================================================
   * HOVER OVERLAY
   * ================================================================= */
  .blog-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    background:
      radial-gradient(
        ellipse at center,
        rgba(19, 37, 100, 0.75) 0%,
        rgba(10, 22, 64, 0.9) 100%
      );
    backdrop-filter: blur(2px);
    opacity: 0;
    transition:
      opacity var(--duration-300) var(--ease-out),
      backdrop-filter var(--duration-300) var(--ease-out);
  }

  .blog-card:hover .blog-card__overlay {
    opacity: 1;
  }

  .blog-card__overlay-text {
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    padding: var(--spacing-2) var(--spacing-5);
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(19, 37, 100, 0.8), rgba(19, 37, 100, 0.8)) padding-box,
      linear-gradient(
        135deg,
        var(--color-primary-300) 0%,
        var(--color-accent-light) 50%,
        var(--color-accent-alt-light) 100%
      ) border-box;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
    transform: translateY(15px) scale(0.95);
    opacity: 0;
    transition:
      transform var(--duration-300) var(--ease-spring-soft),
      opacity var(--duration-300) var(--ease-out),
      box-shadow var(--duration-300) var(--ease-out);
  }

  .blog-card:hover .blog-card__overlay-text {
    transform: translateY(0) scale(1);
    opacity: 1;
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.5), 0 0 60px rgba(6, 182, 212, 0.2);
  }

  /* =================================================================
   * BADGES
   * ================================================================= */
  .blog-card__badge {
    position: absolute;
    padding: var(--spacing-1) var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    border-radius: var(--radius-md);
    z-index: 3;
  }

  .blog-card__badge--featured {
    top: var(--spacing-3);
    left: var(--spacing-3);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .blog-card__badge--category {
    bottom: var(--spacing-3);
    left: var(--spacing-3);
    background-color: var(--color-background-elevated);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  /* =================================================================
   * CONTENT AREA
   * ================================================================= */
  .blog-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-5);
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .blog-card__date {
    display: inline;
  }

  .blog-card__meta-separator {
    color: var(--color-border);
  }

  .blog-card__reading-time {
    display: inline;
  }

  .blog-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .blog-card__title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-150) var(--ease-in-out);
  }

  .blog-card__title-link:hover {
    color: var(--color-primary);
  }

  .blog-card__title-link:focus-visible {
    outline: none;
    color: var(--color-primary);
    text-decoration: underline;
  }

  .blog-card__excerpt {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* =================================================================
   * TAGS
   * ================================================================= */
  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-card__tag {
    display: inline-block;
  }

  .blog-card__tag-link {
    display: inline-block;
    padding: var(--spacing-1) var(--spacing-2);
    background-color: var(--color-primary-50);
    color: var(--color-primary-700);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-primary-100);
    transition:
      background-color var(--duration-150) var(--ease-in-out),
      border-color var(--duration-150) var(--ease-in-out),
      color var(--duration-150) var(--ease-in-out);
  }

  .blog-card__tag-link:hover {
    background-color: var(--color-primary-100);
    border-color: var(--color-primary-200);
    color: var(--color-primary-800);
  }

  .blog-card__tag-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .blog-card__tag--more {
    padding: var(--spacing-1) var(--spacing-2);
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
  }

  /* =================================================================
   * FOOTER
   * ================================================================= */
  .blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-5);
    border-top: 1px solid var(--color-border-light);
    margin-top: auto;
  }

  .blog-card__author {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .blog-card__author-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--color-border-light);
  }

  .blog-card__author-name {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    transition: gap var(--duration-150) var(--ease-in-out);
  }

  .blog-card__read-more:hover {
    gap: var(--spacing-2);
  }

  .blog-card__read-more:focus-visible {
    outline: none;
    text-decoration: underline;
  }

  .blog-card__arrow {
    width: var(--spacing-4);
    height: var(--spacing-4);
    transition: transform var(--duration-150) var(--ease-in-out);
  }

  .blog-card__read-more:hover .blog-card__arrow {
    transform: translateX(4px);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * ================================================================= */
  @media screen and (max-width: 767px) {
    .blog-card__content {
      padding: var(--spacing-4);
    }

    .blog-card__footer {
      padding: var(--spacing-3) var(--spacing-4);
    }

    .blog-card__read-more {
      min-width: 44px;
      min-height: 44px;
    }
  }

  @media screen and (min-width: 768px) {
    .blog-card__content {
      padding: var(--spacing-6);
    }

    .blog-card__title {
      font-size: var(--font-size-xl);
    }

    .blog-card__footer {
      padding: var(--spacing-4) var(--spacing-6);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card__image,
    .blog-card__image-wrapper,
    .blog-card__overlay,
    .blog-card__overlay-text,
    .blog-card__tag-link,
    .blog-card__read-more,
    .blog-card__arrow {
      transition: none;
    }

    .blog-card::after {
      display: none;
    }

    .blog-card:hover {
      transform: none;
      box-shadow: var(--shadow-lg);
    }

    .blog-card:hover .blog-card__image {
      transform: none;
    }

    .blog-card:hover .blog-card__overlay-text {
      transform: none;
      opacity: 1;
    }

    .blog-card__read-more:hover {
      gap: var(--spacing-1);
    }

    .blog-card__read-more:hover .blog-card__arrow {
      transform: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */
  @media print {
    .blog-card {
      box-shadow: none;
      border: 1px solid var(--color-border);
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .blog-card::after {
      display: none;
    }

    .blog-card:hover {
      transform: none;
      box-shadow: none;
    }

    .blog-card__overlay {
      display: none;
    }

    .blog-card__image-wrapper {
      position: static;
      inset: auto;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * ================================================================= */
  @media (forced-colors: active) {
    .blog-card {
      border: 2px solid currentColor;
    }

    .blog-card__badge {
      border: 1px solid currentColor;
    }

    .blog-card__tag-link {
      border: 1px solid currentColor;
    }
  }
</style>
