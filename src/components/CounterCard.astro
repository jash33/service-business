---
/**
 * CounterCard Component
 * A card component for displaying a single metric with an animated counting effect.
 * The counter animates from 0 to the target value when the card enters the viewport.
 *
 * Features:
 * - Animated counter using Intersection Observer
 * - Icon display with accent background
 * - Prefix/suffix support (e.g., "$", "+", "%")
 * - Smooth easing animation
 * - Accessible with proper ARIA attributes
 * - Respects prefers-reduced-motion
 *
 * @example Basic usage
 * ```astro
 * <CounterCard
 *   id="projects"
 *   value={50}
 *   suffix="+"
 *   label="Projects Completed"
 * />
 * ```
 *
 * @example With icon and description
 * ```astro
 * <CounterCard
 *   id="years"
 *   value={10}
 *   suffix="+"
 *   label="Years Experience"
 *   icon="<svg>...</svg>"
 *   description="Years of professional expertise"
 * />
 * ```
 */

import type { CounterCardProps } from '../types/social-proof-counter';

interface Props extends CounterCardProps {}

const {
  id,
  value,
  prefix = '',
  suffix = '',
  label,
  icon,
  description,
  animationDuration = 2000,
  class: className = '',
} = Astro.props;

// Build CSS classes
const cardClasses = [
  'counter-card',
  className,
].filter(Boolean).join(' ');
---

<article
  class={cardClasses}
  id={`counter-${id}`}
  data-counter-value={value}
  data-counter-prefix={prefix}
  data-counter-suffix={suffix}
  data-animation-duration={animationDuration}
>
  {icon && (
    <div class="counter-card__icon" aria-hidden="true">
      <Fragment set:html={icon} />
    </div>
  )}

  <div class="counter-card__content">
    <div class="counter-card__value-container">
      {prefix && <span class="counter-card__prefix">{prefix}</span>}
      <span
        class="counter-card__value"
        aria-live="polite"
        aria-atomic="true"
      >
        0
      </span>
      {suffix && <span class="counter-card__suffix">{suffix}</span>}
    </div>
    <h3 class="counter-card__label">{label}</h3>
    {description && (
      <p class="counter-card__description">{description}</p>
    )}
  </div>

  <!-- Screen reader accessible version with actual value -->
  <span class="sr-only">
    {prefix}{value}{suffix} {label}
  </span>
</article>

<style>
  /* =================================================================
   * COUNTER CARD COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .counter-card {
    /* Layout */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-4);

    /* Box model */
    padding: var(--spacing-6);

    /* Positioning for pseudo-elements */
    position: relative;

    /* Visual */
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);

    /* Overflow for effects */
    overflow: hidden;

    /* Animation */
    transition:
      box-shadow var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-out),
      border-color var(--duration-300) var(--ease-out);
  }

  /* Subtle gradient overlay */
  .counter-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-primary-50) 100%
    );
    opacity: 0;
    transition: opacity var(--duration-300) var(--ease-out);
    pointer-events: none;
    z-index: 0;
  }

  .counter-card:hover {
    box-shadow: var(--shadow-lg), var(--glow-card-hover);
    transform: translateY(-4px);
    border-color: var(--color-primary-300);
  }

  .counter-card:hover::before {
    opacity: 0.5;
  }

  /* Icon Container */
  .counter-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-14);
    height: var(--spacing-14);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-primary-100) 100%
    );
    border-radius: var(--radius-full);
    color: var(--color-primary);
    position: relative;
    z-index: 2;
    transition:
      background var(--duration-300) var(--ease-out),
      transform var(--duration-300) var(--ease-spring-soft),
      box-shadow var(--duration-300) var(--ease-out);
  }

  .counter-card:hover .counter-card__icon {
    background: linear-gradient(
      135deg,
      var(--color-primary-100) 0%,
      var(--color-primary-200) 100%
    );
    transform: scale(1.1);
    box-shadow: var(--glow-primary-sm);
  }

  .counter-card__icon :global(svg) {
    width: var(--spacing-7);
    height: var(--spacing-7);
    transition: transform var(--duration-300) var(--ease-spring-soft);
  }

  .counter-card:hover .counter-card__icon :global(svg) {
    transform: scale(1.1);
  }

  /* Content Area */
  .counter-card__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
    position: relative;
    z-index: 2;
  }

  /* Value Container */
  .counter-card__value-container {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--spacing-0-5);
    line-height: 1;
  }

  .counter-card__prefix,
  .counter-card__suffix {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .counter-card__value {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
    line-height: 1;
    transition: color var(--duration-200) var(--ease-out);
    /* Font feature for tabular numbers */
    font-variant-numeric: tabular-nums;
  }

  .counter-card:hover .counter-card__value {
    color: var(--color-primary-700);
  }

  /* Label */
  .counter-card__label {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    margin-top: var(--spacing-2);
    line-height: var(--line-height-tight);
    transition: color var(--duration-200) var(--ease-out);
  }

  .counter-card:hover .counter-card__label {
    color: var(--color-primary);
  }

  /* Description */
  .counter-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    max-width: 20ch;
    display: none; /* Hidden by default, shown on larger screens if needed */
  }

  /* Screen reader only text */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  /* Tablet and up (768px) */
  @media screen and (min-width: 768px) {
    .counter-card {
      padding: var(--spacing-8);
      gap: var(--spacing-5);
    }

    .counter-card__icon {
      width: var(--spacing-16);
      height: var(--spacing-16);
    }

    .counter-card__icon :global(svg) {
      width: var(--spacing-8);
      height: var(--spacing-8);
    }

    .counter-card__value {
      font-size: var(--font-size-5xl);
    }

    .counter-card__prefix,
    .counter-card__suffix {
      font-size: var(--font-size-3xl);
    }

    .counter-card__label {
      font-size: var(--font-size-lg);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * Respect user preferences for reduced motion
   * =================================================================
   */
  @media (prefers-reduced-motion: reduce) {
    .counter-card,
    .counter-card__icon,
    .counter-card__value,
    .counter-card__label,
    .counter-card__icon :global(svg) {
      transition: none;
    }

    .counter-card:hover {
      transform: none;
      box-shadow: var(--shadow-lg);
    }

    .counter-card:hover .counter-card__icon {
      transform: none;
      box-shadow: none;
    }

    .counter-card:hover .counter-card__icon :global(svg) {
      transform: none;
    }
  }

  /* =================================================================
   * HIGH CONTRAST MODE
   * =================================================================
   */
  @media (forced-colors: active) {
    .counter-card {
      border: 2px solid CanvasText;
    }

    .counter-card__icon {
      border: 1px solid CanvasText;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */
  @media print {
    .counter-card {
      box-shadow: none;
      border: 1px solid var(--color-border);
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .counter-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>

<script>
  // Counter animation script using Intersection Observer
  function initCounterCards() {
    const counterCards = document.querySelectorAll('[data-counter-value]');

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: '0px',
      threshold: 0.2, // Trigger when 20% of the element is visible
    };

    const animateCounter = (element: Element) => {
      const valueElement = element.querySelector('.counter-card__value');
      if (!valueElement) return;

      const targetValue = parseInt(element.getAttribute('data-counter-value') || '0', 10);
      const duration = parseInt(element.getAttribute('data-animation-duration') || '2000', 10);

      // If reduced motion is preferred, show the final value immediately
      if (prefersReducedMotion) {
        valueElement.textContent = targetValue.toLocaleString();
        return;
      }

      const startTime = performance.now();
      const startValue = 0;

      const updateCounter = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);

        // Easing function (ease-out-quart for smooth deceleration)
        const easeOutQuart = 1 - Math.pow(1 - progress, 4);

        const currentValue = Math.floor(startValue + (targetValue - startValue) * easeOutQuart);
        valueElement.textContent = currentValue.toLocaleString();

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        } else {
          // Ensure we end on the exact target value
          valueElement.textContent = targetValue.toLocaleString();
        }
      };

      requestAnimationFrame(updateCounter);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          // Unobserve after animation starts to prevent re-triggering
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    counterCards.forEach((card) => {
      observer.observe(card);
    });
  }

  // Initialize on DOM ready and after view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounterCards);
  } else {
    initCounterCards();
  }

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:after-swap', initCounterCards);
</script>
