---
/**
 * LicenseInsuranceSection Component
 * A responsive section displaying business licenses, insurance certificates,
 * and bonding information in a grid layout. Critical trust-building element
 * for service businesses that demonstrates compliance and protection.
 *
 * Features:
 * - Responsive grid: 1 column (mobile) -> 2-3 columns (tablet/desktop)
 * - Section heading with trust-focused messaging
 * - Category filtering support (future enhancement)
 * - Consistent card sizing and spacing
 * - Accessible with proper semantic structure
 * - Empty state handling
 * - Smooth staggered animations
 *
 * @example Basic usage
 * ```astro
 * <LicenseInsuranceSection
 *   heading="Licensed, Insured & Bonded"
 *   subheading="Your protection is our priority"
 *   credentials={[
 *     { id: 'license-1', title: 'Contractor License', type: 'license', ... },
 *     { id: 'insurance-1', title: 'Liability Insurance', type: 'insurance', ... },
 *   ]}
 * />
 * ```
 *
 * @example With custom columns
 * ```astro
 * <LicenseInsuranceSection
 *   heading="Our Credentials"
 *   credentials={credentials}
 *   columns={2}
 * />
 * ```
 */

import type { LicenseInsuranceSectionProps, LicenseInsuranceCredential } from '../types/trust-badge';
import LicenseInsuranceCard from './LicenseInsuranceCard.astro';

interface Props extends LicenseInsuranceSectionProps {}

const {
  heading = 'Licensed, Insured & Bonded',
  subheading,
  credentials = [],
  id = 'license-insurance',
  columns = 3,
  class: className = '',
} = Astro.props;

// Build CSS classes
const sectionClasses = [
  'license-insurance-section',
  `license-insurance-section--cols-${columns}`,
  className,
].filter(Boolean).join(' ');

// Check if we have credentials to display
const hasCredentials = credentials && credentials.length > 0;

// Group credentials by type for potential filtering/organization
const licenseCount = credentials.filter(c => c.type === 'license').length;
const insuranceCount = credentials.filter(c => c.type === 'insurance').length;
const bondingCount = credentials.filter(c => c.type === 'bonding').length;
---

<section class={sectionClasses} id={id} aria-labelledby={`${id}-heading`}>
  <div class="license-insurance-section__container">
    <!-- Section Header -->
    <header class="license-insurance-section__header section-heading--decorated">
      <div class="license-insurance-section__header-content">
        <!-- Trust Icon -->
        <div class="license-insurance-section__trust-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
          </svg>
        </div>

        <h2 id={`${id}-heading`} class="license-insurance-section__heading">{heading}</h2>

        {subheading && (
          <p class="license-insurance-section__subheading">{subheading}</p>
        )}
      </div>

      <!-- Credential Type Summary -->
      {hasCredentials && (
        <div class="license-insurance-section__summary" role="list" aria-label="Credential summary">
          {licenseCount > 0 && (
            <div class="license-insurance-section__summary-item license-insurance-section__summary-item--license" role="listitem">
              <span class="license-insurance-section__summary-count">{licenseCount}</span>
              <span class="license-insurance-section__summary-label">{licenseCount === 1 ? 'License' : 'Licenses'}</span>
            </div>
          )}
          {insuranceCount > 0 && (
            <div class="license-insurance-section__summary-item license-insurance-section__summary-item--insurance" role="listitem">
              <span class="license-insurance-section__summary-count">{insuranceCount}</span>
              <span class="license-insurance-section__summary-label">{insuranceCount === 1 ? 'Insurance Policy' : 'Insurance Policies'}</span>
            </div>
          )}
          {bondingCount > 0 && (
            <div class="license-insurance-section__summary-item license-insurance-section__summary-item--bonding" role="listitem">
              <span class="license-insurance-section__summary-count">{bondingCount}</span>
              <span class="license-insurance-section__summary-label">{bondingCount === 1 ? 'Bond' : 'Bonds'}</span>
            </div>
          )}
        </div>
      )}
    </header>

    <!-- Credentials Grid -->
    {hasCredentials ? (
      <div class="license-insurance-section__grid" role="list">
        {credentials.map((credential) => (
          <div class="license-insurance-section__card-wrapper" role="listitem">
            <LicenseInsuranceCard
              id={credential.id}
              title={credential.title}
              type={credential.type}
              description={credential.description}
              icon={credential.icon}
              credentialNumber={credential.credentialNumber}
              issuer={credential.issuer}
              jurisdiction={credential.jurisdiction}
              issueDate={credential.issueDate}
              expirationDate={credential.expirationDate}
              coverageAmount={credential.coverageAmount}
              verificationStatus={credential.verificationStatus}
              verificationUrl={credential.verificationUrl}
              notes={credential.notes}
            />
          </div>
        ))}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="license-insurance-section__empty" role="status" aria-live="polite">
        <div class="license-insurance-section__empty-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
          </svg>
        </div>
        <p class="license-insurance-section__empty-text">License and insurance information coming soon.</p>
      </div>
    )}

    <!-- Trust Statement -->
    {hasCredentials && (
      <div class="license-insurance-section__trust-statement">
        <p>
          <strong>Your Protection Matters:</strong> We maintain current licenses, comprehensive insurance coverage,
          and bonding to ensure your project is protected. Click any credential above to verify directly with the issuing authority.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  /* =================================================================
   * LICENSE INSURANCE SECTION COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention for maintainability
   */

  .license-insurance-section {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background);
  }

  .license-insurance-section__container {
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  /* Section Header */
  .license-insurance-section__header {
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .license-insurance-section__header-content {
    margin-bottom: var(--spacing-6);
  }

  .license-insurance-section__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-16);
    height: var(--spacing-16);
    margin-bottom: var(--spacing-4);
    background: linear-gradient(
      135deg,
      var(--color-success-light) 0%,
      #bbf7d0 100%
    );
    border-radius: var(--radius-full);
    color: var(--color-success-dark);
  }

  .license-insurance-section__trust-icon svg {
    width: var(--spacing-8);
    height: var(--spacing-8);
  }

  .license-insurance-section__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-3);
    line-height: var(--line-height-tight);
  }

  .license-insurance-section__subheading {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 45rem;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--line-height-relaxed);
  }

  /* Credential Summary Pills */
  .license-insurance-section__summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-3);
    margin-top: var(--spacing-6);
  }

  .license-insurance-section__summary-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
  }

  .license-insurance-section__summary-count {
    font-weight: var(--font-weight-bold);
  }

  .license-insurance-section__summary-label {
    color: inherit;
    opacity: 0.9;
  }

  .license-insurance-section__summary-item--license {
    background-color: #dbeafe;
    color: #1d4ed8;
  }

  .license-insurance-section__summary-item--insurance {
    background-color: #dcfce7;
    color: #15803d;
  }

  .license-insurance-section__summary-item--bonding {
    background-color: #fef3c7;
    color: #b45309;
  }

  /* Credentials Grid */
  .license-insurance-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  .license-insurance-section__card-wrapper {
    display: contents;
  }

  /* Empty State */
  .license-insurance-section__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-16) var(--spacing-8);
    background-color: var(--color-background-subtle);
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
  }

  .license-insurance-section__empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-16);
    height: var(--spacing-16);
    margin-bottom: var(--spacing-4);
    background-color: var(--color-background-muted);
    border-radius: var(--radius-full);
    color: var(--color-text-tertiary);
  }

  .license-insurance-section__empty-icon svg {
    width: var(--spacing-8);
    height: var(--spacing-8);
  }

  .license-insurance-section__empty-text {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: var(--color-text-tertiary);
    margin: 0;
    text-align: center;
  }

  /* Trust Statement */
  .license-insurance-section__trust-statement {
    margin-top: var(--spacing-10);
    padding: var(--spacing-6);
    background: linear-gradient(
      135deg,
      var(--color-primary-50) 0%,
      var(--color-background-subtle) 100%
    );
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--color-primary);
  }

  .license-insurance-section__trust-statement p {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
    text-align: center;
  }

  .license-insurance-section__trust-statement strong {
    color: var(--color-text-primary);
  }

  /* =================================================================
   * RESPONSIVE STYLES
   * =================================================================
   */

  /* Tablet (768px) */
  @media screen and (min-width: 768px) {
    .license-insurance-section {
      padding: var(--spacing-20) var(--spacing-8);
    }

    .license-insurance-section__header {
      margin-bottom: var(--spacing-12);
    }

    .license-insurance-section__heading {
      font-size: var(--font-size-4xl);
    }

    .license-insurance-section__trust-icon {
      width: var(--spacing-20);
      height: var(--spacing-20);
    }

    .license-insurance-section__trust-icon svg {
      width: var(--spacing-10);
      height: var(--spacing-10);
    }

    /* Grid columns based on props - 2 columns on tablet */
    .license-insurance-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop (1024px) */
  @media screen and (min-width: 1024px) {
    .license-insurance-section--cols-2 .license-insurance-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .license-insurance-section--cols-3 .license-insurance-section__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .license-insurance-section--cols-4 .license-insurance-section__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Large Desktop (1280px) */
  @media screen and (min-width: 1280px) {
    .license-insurance-section {
      padding: var(--spacing-24) var(--spacing-8);
    }
  }

  /* =================================================================
   * ANIMATION - Staggered card appearance
   * =================================================================
   */
  .license-insurance-section__grid > :global(*) {
    animation: fadeSlideUp 0.4s ease-out backwards;
  }

  .license-insurance-section__grid > :global(*:nth-child(1)) { animation-delay: 0.05s; }
  .license-insurance-section__grid > :global(*:nth-child(2)) { animation-delay: 0.1s; }
  .license-insurance-section__grid > :global(*:nth-child(3)) { animation-delay: 0.15s; }
  .license-insurance-section__grid > :global(*:nth-child(4)) { animation-delay: 0.2s; }
  .license-insurance-section__grid > :global(*:nth-child(5)) { animation-delay: 0.25s; }
  .license-insurance-section__grid > :global(*:nth-child(6)) { animation-delay: 0.3s; }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =================================================================
   * REDUCED MOTION
   * =================================================================
   */
  @media (prefers-reduced-motion: reduce) {
    .license-insurance-section__grid > :global(*) {
      animation: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * =================================================================
   */
  @media print {
    .license-insurance-section {
      padding: var(--spacing-8) 0;
      background-color: transparent;
    }

    .license-insurance-section__grid > :global(*) {
      animation: none;
    }

    .license-insurance-section__trust-statement {
      border-left: 2px solid var(--color-primary);
    }
  }
</style>
