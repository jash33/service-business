---
/**
 * Service Request Form Component
 * A multi-step service request form with service selection, scheduling preferences,
 * project details, and file upload functionality.
 *
 * Features:
 * - 3-step wizard with progress indicator
 * - Service type and property selection
 * - Scheduling preferences with date picker
 * - File upload for project photos
 * - Real-time client-side validation
 * - Honeypot spam prevention
 * - WCAG 2.1 AA compliant accessibility
 * - Formspree API integration
 *
 * @example
 * ```astro
 * <ServiceRequestForm />
 * ```
 */

import {
  SERVICE_TYPE_OPTIONS,
  PROPERTY_TYPE_OPTIONS,
  PROPERTY_SIZE_OPTIONS,
  FREQUENCY_OPTIONS,
  TIME_SLOT_OPTIONS,
  BUDGET_RANGE_OPTIONS,
  URGENCY_OPTIONS,
  ADDITIONAL_SERVICES_OPTIONS,
  FORM_STEPS,
  DEFAULT_SERVICE_FORM_VALIDATION_CONFIG,
} from '../types/service-request-form';

const serviceOptions = SERVICE_TYPE_OPTIONS;
const propertyOptions = PROPERTY_TYPE_OPTIONS;
const sizeOptions = PROPERTY_SIZE_OPTIONS;
const frequencyOptions = FREQUENCY_OPTIONS;
const timeSlotOptions = TIME_SLOT_OPTIONS;
const budgetOptions = BUDGET_RANGE_OPTIONS;
const urgencyOptions = URGENCY_OPTIONS;
const additionalServices = ADDITIONAL_SERVICES_OPTIONS;
const steps = FORM_STEPS;
const config = DEFAULT_SERVICE_FORM_VALIDATION_CONFIG;

// Get Formspree endpoint from environment variable
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
---

<section class="service-request-section" aria-labelledby="service-request-heading">
  <div class="service-request-container">
    <div class="service-request-header">
      <h2 id="service-request-heading" class="service-request-title">Request a Quote</h2>
      <p class="service-request-description">
        Tell us about your project and we'll provide a detailed quote within 24 hours.
      </p>
    </div>

    <!-- Progress Steps -->
    <div class="progress-steps" role="navigation" aria-label="Form progress">
      {steps.map((step, index) => (
        <div
          class="progress-step"
          data-step={step.id}
          data-active={index === 0 ? "true" : "false"}
          data-completed="false"
        >
          <div class="progress-step__indicator">
            <span class="progress-step__number">{step.id}</span>
            <svg class="progress-step__check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="progress-step__content">
            <span class="progress-step__title">{step.title}</span>
            <span class="progress-step__description">{step.description}</span>
          </div>
          {index < steps.length - 1 && (
            <div class="progress-step__connector" aria-hidden="true"></div>
          )}
        </div>
      ))}
    </div>

    <form
      id="service-request-form"
      class="service-request-form"
      novalidate
      aria-describedby="form-description"
      data-formspree-endpoint={formspreeEndpoint}
      data-max-files={config.maxFiles}
      data-max-file-size={config.maxFileSize}
      data-allowed-types={config.allowedFileTypes.join(',')}
    >
      <!-- Hidden field for spam prevention timing -->
      <input type="hidden" id="form-start-time" name="formStartTime" value="" />

      <!-- Honeypot field - hidden from real users -->
      <div class="service-request-form__honeypot" aria-hidden="true" tabindex="-1">
        <label for="website-url">Website URL</label>
        <input
          type="text"
          id="website-url"
          name="websiteUrl"
          autocomplete="off"
          tabindex="-1"
        />
      </div>

      <p id="form-description" class="sr-only">
        This is a 3-step form. Required fields are marked with an asterisk (*).
      </p>

      <!-- Step 1: Service Selection -->
      <div class="form-step" data-step="1" data-visible="true">
        <h3 class="form-step__title">Select Your Service</h3>

        <!-- Service Type -->
        <div class="service-request-form__field">
          <label for="service-type" class="service-request-form__label">
            Service Type <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="service-type"
            name="serviceType"
            class="service-request-form__select"
            required
            aria-describedby="service-type-error"
            aria-invalid="false"
          >
            {serviceOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="service-type-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Property Type -->
        <div class="service-request-form__field">
          <label for="property-type" class="service-request-form__label">
            Property Type <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="property-type"
            name="propertyType"
            class="service-request-form__select"
            required
            aria-describedby="property-type-error"
            aria-invalid="false"
          >
            {propertyOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="property-type-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Property Size -->
        <div class="service-request-form__field">
          <label for="property-size" class="service-request-form__label">
            Property Size <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="property-size"
            name="propertySize"
            class="service-request-form__select"
            required
            aria-describedby="property-size-error"
            aria-invalid="false"
          >
            {sizeOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="property-size-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Additional Services (Checkboxes) -->
        <fieldset class="service-request-form__fieldset">
          <legend class="service-request-form__legend">
            Additional Services <span class="service-request-form__optional">(optional)</span>
          </legend>
          <div class="service-request-form__checkbox-group">
            {additionalServices.map((service) => (
              <div class="service-request-form__checkbox-item">
                <input
                  type="checkbox"
                  id={`additional-${service.id}`}
                  name="additionalServices"
                  value={service.id}
                  class="service-request-form__checkbox"
                />
                <label for={`additional-${service.id}`} class="service-request-form__checkbox-label">
                  <span class="service-request-form__checkbox-text">{service.label}</span>
                  {service.description && (
                    <span class="service-request-form__checkbox-description">{service.description}</span>
                  )}
                </label>
              </div>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Step 2: Scheduling -->
      <div class="form-step" data-step="2" data-visible="false">
        <h3 class="form-step__title">Schedule Your Service</h3>

        <!-- Service Frequency -->
        <div class="service-request-form__field">
          <label for="frequency" class="service-request-form__label">
            Service Frequency <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="frequency"
            name="frequency"
            class="service-request-form__select"
            required
            aria-describedby="frequency-error"
            aria-invalid="false"
          >
            {frequencyOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="frequency-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Preferred Date -->
        <div class="service-request-form__field">
          <label for="preferred-date" class="service-request-form__label">
            Preferred Date <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <input
            type="date"
            id="preferred-date"
            name="preferredDate"
            class="service-request-form__input"
            required
            aria-describedby="preferred-date-error"
            aria-invalid="false"
          />
          <span id="preferred-date-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Preferred Time Slot -->
        <div class="service-request-form__field">
          <label for="time-slot" class="service-request-form__label">
            Preferred Time <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="time-slot"
            name="preferredTimeSlot"
            class="service-request-form__select"
            required
            aria-describedby="time-slot-error"
            aria-invalid="false"
          >
            {timeSlotOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}{option.timeRange ? ` (${option.timeRange})` : ''}
              </option>
            ))}
          </select>
          <span id="time-slot-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Alternate Date -->
        <div class="service-request-form__field">
          <label for="alternate-date" class="service-request-form__label">
            Alternate Date <span class="service-request-form__optional">(optional)</span>
          </label>
          <input
            type="date"
            id="alternate-date"
            name="alternateDate"
            class="service-request-form__input"
            aria-describedby="alternate-date-hint"
          />
          <span id="alternate-date-hint" class="service-request-form__hint">Provide a backup date if available</span>
        </div>

        <!-- Urgency -->
        <div class="service-request-form__field">
          <label for="urgency" class="service-request-form__label">
            How Urgent? <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <select
            id="urgency"
            name="urgency"
            class="service-request-form__select"
            required
            aria-describedby="urgency-error"
            aria-invalid="false"
          >
            {urgencyOptions.map((option) => (
              <option value={option.value} disabled={option.value === ''} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="urgency-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>
      </div>

      <!-- Step 3: Project Details -->
      <div class="form-step" data-step="3" data-visible="false">
        <h3 class="form-step__title">Your Details</h3>

        <!-- Name -->
        <div class="service-request-form__field">
          <label for="name" class="service-request-form__label">
            Full Name <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            class="service-request-form__input"
            required
            autocomplete="name"
            maxlength={config.maxNameLength}
            aria-describedby="name-error"
            aria-invalid="false"
            placeholder="Your full name"
          />
          <span id="name-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Email -->
        <div class="service-request-form__field">
          <label for="email" class="service-request-form__label">
            Email <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="service-request-form__input"
            required
            autocomplete="email"
            maxlength={config.maxEmailLength}
            aria-describedby="email-error"
            aria-invalid="false"
            placeholder="your@email.com"
          />
          <span id="email-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Phone -->
        <div class="service-request-form__field">
          <label for="phone" class="service-request-form__label">
            Phone <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="service-request-form__input"
            required
            autocomplete="tel"
            maxlength={config.maxPhoneLength}
            aria-describedby="phone-hint phone-error"
            aria-invalid="false"
            placeholder="(123) 456-7890"
          />
          <span id="phone-hint" class="service-request-form__hint">US format: (123) 456-7890</span>
          <span id="phone-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Address -->
        <div class="service-request-form__field">
          <label for="address" class="service-request-form__label">
            Service Address <span class="service-request-form__required" aria-label="required">*</span>
          </label>
          <input
            type="text"
            id="address"
            name="address"
            class="service-request-form__input"
            required
            autocomplete="street-address"
            maxlength={config.maxAddressLength}
            aria-describedby="address-error"
            aria-invalid="false"
            placeholder="123 Main St"
          />
          <span id="address-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
        </div>

        <!-- City & Zip Row -->
        <div class="service-request-form__row">
          <div class="service-request-form__field">
            <label for="city" class="service-request-form__label">
              City <span class="service-request-form__required" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="city"
              name="city"
              class="service-request-form__input"
              required
              autocomplete="address-level2"
              aria-describedby="city-error"
              aria-invalid="false"
              placeholder="Your City"
            />
            <span id="city-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
          </div>
          <div class="service-request-form__field">
            <label for="zip-code" class="service-request-form__label">
              ZIP Code <span class="service-request-form__required" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="zip-code"
              name="zipCode"
              class="service-request-form__input"
              required
              autocomplete="postal-code"
              pattern="[0-9]{5}"
              maxlength="5"
              aria-describedby="zip-code-error"
              aria-invalid="false"
              placeholder="77001"
            />
            <span id="zip-code-error" class="service-request-form__error" role="alert" aria-live="polite"></span>
          </div>
        </div>

        <!-- Budget Range -->
        <div class="service-request-form__field">
          <label for="budget-range" class="service-request-form__label">
            Budget Range <span class="service-request-form__optional">(optional)</span>
          </label>
          <select
            id="budget-range"
            name="budgetRange"
            class="service-request-form__select"
            aria-describedby="budget-range-hint"
          >
            {budgetOptions.map((option) => (
              <option value={option.value} selected={option.value === ''}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="budget-range-hint" class="service-request-form__hint">Helps us provide accurate quotes</span>
        </div>

        <!-- Special Instructions -->
        <div class="service-request-form__field service-request-form__field--full">
          <label for="special-instructions" class="service-request-form__label">
            Special Instructions <span class="service-request-form__optional">(optional)</span>
          </label>
          <textarea
            id="special-instructions"
            name="specialInstructions"
            class="service-request-form__textarea"
            rows="4"
            maxlength={config.maxMessageLength}
            aria-describedby="instructions-hint instructions-count"
            placeholder="Any specific areas of concern, access instructions, pets, etc."
          ></textarea>
          <div class="service-request-form__textarea-footer">
            <span id="instructions-hint" class="service-request-form__hint">Tell us about any special requirements</span>
            <span id="instructions-count" class="service-request-form__char-count">
              <span class="service-request-form__char-current">0</span>/{config.maxMessageLength}
            </span>
          </div>
        </div>

        <!-- File Upload -->
        <div class="service-request-form__field service-request-form__field--full">
          <label for="file-upload" class="service-request-form__label">
            Project Photos <span class="service-request-form__optional">(optional)</span>
          </label>
          <div class="file-upload-zone" id="file-upload-zone">
            <input
              type="file"
              id="file-upload"
              name="projectPhotos"
              class="file-upload-input"
              multiple
              accept={config.allowedFileTypes.join(',')}
              aria-describedby="file-upload-hint file-upload-error"
            />
            <div class="file-upload-content">
              <svg class="file-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <p class="file-upload-text">
                <span class="file-upload-link">Click to upload</span> or drag and drop
              </p>
              <p class="file-upload-hint-text">PNG, JPG, GIF, WebP, or PDF (max {config.maxFiles} files, {Math.round(config.maxFileSize / 1024 / 1024)}MB each)</p>
            </div>
          </div>
          <span id="file-upload-hint" class="service-request-form__hint">Upload photos of the space for a more accurate quote</span>
          <span id="file-upload-error" class="service-request-form__error" role="alert" aria-live="polite"></span>

          <!-- File Preview List -->
          <div class="file-preview-list" id="file-preview-list" hidden></div>
        </div>
      </div>

      <!-- Form Messages -->
      <div id="form-error" class="service-request-form__message service-request-form__message--error" role="alert" hidden>
        <svg class="service-request-form__message-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <span id="form-error-text">An error occurred. Please try again.</span>
      </div>

      <div id="form-success" class="service-request-form__message service-request-form__message--success" role="status" hidden>
        <svg class="service-request-form__message-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <div class="service-request-form__success-content">
          <strong>Request Submitted Successfully!</strong>
          <p>We'll review your request and send you a detailed quote within 24 hours.</p>
        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="service-request-form__actions">
        <button
          type="button"
          id="prev-button"
          class="service-request-form__nav-btn service-request-form__nav-btn--prev"
          hidden
        >
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
          </svg>
          Previous
        </button>

        <button
          type="button"
          id="next-button"
          class="service-request-form__nav-btn service-request-form__nav-btn--next"
        >
          Next Step
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
          </svg>
        </button>

        <button
          type="submit"
          id="submit-button"
          class="service-request-form__submit"
          hidden
        >
          <span class="service-request-form__submit-text">Submit Quote Request</span>
          <span class="service-request-form__submit-loading">
            <svg class="service-request-form__spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Submitting...
          </span>
        </button>
      </div>

      <!-- Privacy Notice -->
      <div class="service-request-form__privacy">
        <p>
          By submitting this form, you agree to our
          <a href="/service-business/privacy" class="service-request-form__link">Privacy Policy</a>.
          We'll never share your information with third parties.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  /* =================================================================
   * SERVICE REQUEST FORM SECTION
   * ================================================================= */
  .service-request-section {
    padding: var(--spacing-16) var(--spacing-4);
    background-color: var(--color-background-subtle);
  }

  .service-request-container {
    max-width: var(--container-4xl);
    margin: 0 auto;
  }

  .service-request-header {
    text-align: center;
    margin-bottom: var(--spacing-10);
  }

  .service-request-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
    line-height: var(--line-height-tight);
  }

  .service-request-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin: 0 auto;
  }

  /* =================================================================
   * PROGRESS STEPS
   * ================================================================= */
  .progress-steps {
    display: flex;
    justify-content: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-10);
    padding: 0 var(--spacing-4);
  }

  .progress-step {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    position: relative;
  }

  .progress-step__indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-background);
    border: 2px solid var(--color-border);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-semibold);
    transition: all var(--duration-200) var(--ease-in-out);
    flex-shrink: 0;
  }

  .progress-step__check {
    display: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .progress-step__content {
    display: none;
  }

  .progress-step__title {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .progress-step__description {
    display: block;
