</style>

<script>
  /**
   * Service Request Form Client-Side Logic
   * Handles multi-step navigation, validation, file uploads, and form submission
   */

  // Validation config
  const VALIDATION_CONFIG = {
    minMessageLength: 10,
    maxMessageLength: 2000,
    maxNameLength: 100,
    maxAddressLength: 200,
    maxEmailLength: 254,
    maxPhoneLength: 20,
    minSubmitTime: 3000,
    maxFileSize: 10 * 1024 * 1024,
    maxFiles: 5,
  };

  // Regex patterns
  const EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
  const US_PHONE_REGEX = /^(\+1\s?)?(\([0-9]{3}\)|[0-9]{3})[\s.\-]?[0-9]{3}[\s.\-]?[0-9]{4}$/;
  const ZIP_REGEX = /^[0-9]{5}$/;

  // Form elements
  const form = document.getElementById('service-request-form') as HTMLFormElement;
  const formStartTimeInput = document.getElementById('form-start-time') as HTMLInputElement;
  const honeypotInput = document.getElementById('website-url') as HTMLInputElement;
  const prevButton = document.getElementById('prev-button') as HTMLButtonElement;
  const nextButton = document.getElementById('next-button') as HTMLButtonElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const formError = document.getElementById('form-error') as HTMLDivElement;
  const formErrorText = document.getElementById('form-error-text') as HTMLSpanElement;
  const formSuccess = document.getElementById('form-success') as HTMLDivElement;

  // File upload elements
  const fileUploadZone = document.getElementById('file-upload-zone') as HTMLDivElement;
  const fileUploadInput = document.getElementById('file-upload') as HTMLInputElement;
  const filePreviewList = document.getElementById('file-preview-list') as HTMLDivElement;
  const fileUploadError = document.getElementById('file-upload-error') as HTMLSpanElement;

  // Textarea elements
  const specialInstructionsTextarea = document.getElementById('special-instructions') as HTMLTextAreaElement;
  const charCurrentSpan = document.querySelector('.service-request-form__char-current') as HTMLSpanElement;

  // Progress step elements
  const progressSteps = document.querySelectorAll('.progress-step');
  const formSteps = document.querySelectorAll('.form-step');

  // State
  let currentStep = 1;
  const totalSteps = 3;
  let uploadedFiles: File[] = [];

  // Initialize
  function init() {
    formStartTimeInput.value = Date.now().toString();
    setMinDate();
    setupEventListeners();
    updateNavButtons();
  }

  // Set minimum date to today
  function setMinDate() {
    const today = new Date().toISOString().split('T')[0];
    const preferredDateInput = document.getElementById('preferred-date') as HTMLInputElement;
    const alternateDateInput = document.getElementById('alternate-date') as HTMLInputElement;
    if (preferredDateInput) preferredDateInput.min = today;
    if (alternateDateInput) alternateDateInput.min = today;
  }

  // Setup event listeners
  function setupEventListeners() {
    // Navigation buttons
    prevButton?.addEventListener('click', goToPrevStep);
    nextButton?.addEventListener('click', goToNextStep);
    form?.addEventListener('submit', handleSubmit);

    // Character count for textarea
    specialInstructionsTextarea?.addEventListener('input', updateCharCount);

    // File upload
    fileUploadInput?.addEventListener('change', handleFileSelect);
    fileUploadZone?.addEventListener('dragover', handleDragOver);
    fileUploadZone?.addEventListener('dragleave', handleDragLeave);
    fileUploadZone?.addEventListener('drop', handleDrop);

    // Field validation on blur
    const requiredFields = form.querySelectorAll('[required]');
    requiredFields.forEach(field => {
      field.addEventListener('blur', () => validateField(field as HTMLInputElement | HTMLSelectElement));
    });
  }

  // Update character count
  function updateCharCount() {
    if (!charCurrentSpan || !specialInstructionsTextarea) return;
    const count = specialInstructionsTextarea.value.length;
    charCurrentSpan.textContent = count.toString();
  }

  // Navigation functions
  function goToNextStep() {
    if (validateCurrentStep()) {
      if (currentStep < totalSteps) {
        updateStep(currentStep + 1);
      }
    }
  }

  function goToPrevStep() {
    if (currentStep > 1) {
      updateStep(currentStep - 1);
    }
  }

  function updateStep(newStep: number) {
    // Update progress steps
    progressSteps.forEach((step, index) => {
      const stepNum = index + 1;
      step.setAttribute('data-active', stepNum === newStep ? 'true' : 'false');
      step.setAttribute('data-completed', stepNum < newStep ? 'true' : 'false');
    });

    // Update form steps visibility
    formSteps.forEach((step) => {
      const stepAttr = step.getAttribute('data-step');
      step.setAttribute('data-visible', stepAttr === newStep.toString() ? 'true' : 'false');
    });

    currentStep = newStep;
    updateNavButtons();

    // Scroll to top of form
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function updateNavButtons() {
    // Show/hide prev button
    if (prevButton) {
      prevButton.hidden = currentStep === 1;
    }

    // Show/hide next button
    if (nextButton) {
      nextButton.hidden = currentStep === totalSteps;
    }

    // Show/hide submit button
    if (submitButton) {
      submitButton.hidden = currentStep !== totalSteps;
    }
  }

  // Validation functions
  function validateCurrentStep(): boolean {
    let isValid = true;
    const currentFormStep = document.querySelector(`.form-step[data-step="${currentStep}"]`);
    if (!currentFormStep) return false;

    const requiredFields = currentFormStep.querySelectorAll('[required]');
    requiredFields.forEach((field) => {
      if (!validateField(field as HTMLInputElement | HTMLSelectElement)) {
        isValid = false;
      }
    });

    return isValid;
  }

  function validateField(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): boolean {
    const value = field.value.trim();
    const fieldName = field.name;
    let errorMessage = '';
    let isValid = true;

    // Check if required and empty
    if (field.hasAttribute('required') && !value) {
      errorMessage = 'This field is required';
      isValid = false;
    }
    // Email validation
    else if (fieldName === 'email' && value && !EMAIL_REGEX.test(value)) {
      errorMessage = 'Please enter a valid email address';
      isValid = false;
    }
    // Phone validation
    else if (fieldName === 'phone' && value && !US_PHONE_REGEX.test(value)) {
      errorMessage = 'Please enter a valid US phone number';
      isValid = false;
    }
    // ZIP code validation
    else if (fieldName === 'zipCode' && value && !ZIP_REGEX.test(value)) {
      errorMessage = 'Please enter a valid 5-digit ZIP code';
      isValid = false;
    }
    // Date validation (must be in the future)
    else if ((fieldName === 'preferredDate' || fieldName === 'alternateDate') && value) {
      const selectedDate = new Date(value);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      if (selectedDate < today) {
        errorMessage = 'Please select a future date';
        isValid = false;
      }
    }

    // Update field state
    field.setAttribute('aria-invalid', (!isValid).toString());

    // Update error message
    const errorElement = document.getElementById(`${field.id}-error`);
    if (errorElement) {
      errorElement.textContent = errorMessage;
    }

    return isValid;
  }

  // File upload functions
  function handleFileSelect(event: Event) {
    const input = event.target as HTMLInputElement;
    if (input.files) {
      addFiles(Array.from(input.files));
    }
  }

  function handleDragOver(event: DragEvent) {
    event.preventDefault();
    fileUploadZone?.classList.add('drag-over');
  }

  function handleDragLeave(event: DragEvent) {
    event.preventDefault();
    fileUploadZone?.classList.remove('drag-over');
  }

  function handleDrop(event: DragEvent) {
    event.preventDefault();
    fileUploadZone?.classList.remove('drag-over');
    if (event.dataTransfer?.files) {
      addFiles(Array.from(event.dataTransfer.files));
    }
  }

  function addFiles(files: File[]) {
    fileUploadError.textContent = '';

    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'application/pdf'];

    for (const file of files) {
      // Check max files
      if (uploadedFiles.length >= VALIDATION_CONFIG.maxFiles) {
        fileUploadError.textContent = `Maximum ${VALIDATION_CONFIG.maxFiles} files allowed`;
        break;
      }

      // Check file type
      if (!allowedTypes.includes(file.type)) {
        fileUploadError.textContent = `Invalid file type: ${file.name}. Allowed: JPG, PNG, GIF, WebP, PDF`;
        continue;
      }

      // Check file size
      if (file.size > VALIDATION_CONFIG.maxFileSize) {
        fileUploadError.textContent = `File too large: ${file.name}. Max size: 10MB`;
        continue;
      }

      // Add file if not already added
      if (!uploadedFiles.some(f => f.name === file.name && f.size === file.size)) {
        uploadedFiles.push(file);
      }
    }

    updateFilePreview();
  }

  function removeFile(index: number) {
    uploadedFiles.splice(index, 1);
    updateFilePreview();
  }

  function updateFilePreview() {
    if (!filePreviewList) return;

    filePreviewList.innerHTML = '';
    filePreviewList.hidden = uploadedFiles.length === 0;

    uploadedFiles.forEach((file, index) => {
      const item = document.createElement('div');
      item.className = 'file-preview-item';

      const isImage = file.type.startsWith('image/');

      if (isImage) {
        const img = document.createElement('img');
        img.className = 'file-preview-image';
        img.src = URL.createObjectURL(file);
        img.alt = file.name;
        item.appendChild(img);
      } else {
        const iconDiv = document.createElement('div');
        iconDiv.className = 'file-preview-icon';
        iconDiv.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>`;
        item.appendChild(iconDiv);
      }

      const info = document.createElement('div');
      info.className = 'file-preview-info';
      info.innerHTML = `
        <span class="file-preview-name">${file.name}</span>
        <span class="file-preview-size">${formatFileSize(file.size)}</span>
      `;
      item.appendChild(info);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'file-preview-remove';
      removeBtn.setAttribute('aria-label', `Remove ${file.name}`);
      removeBtn.innerHTML = `<svg viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>`;
      removeBtn.addEventListener('click', () => removeFile(index));
      item.appendChild(removeBtn);

      filePreviewList.appendChild(item);
    });
  }

  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  // Form submission
  async function handleSubmit(event: Event) {
    event.preventDefault();

    // Validate all steps
    for (let step = 1; step <= totalSteps; step++) {
      const stepElement = document.querySelector(`.form-step[data-step="${step}"]`);
      if (stepElement) {
        const requiredFields = stepElement.querySelectorAll('[required]');
        let stepValid = true;
        requiredFields.forEach((field) => {
          if (!validateField(field as HTMLInputElement | HTMLSelectElement)) {
            stepValid = false;
          }
        });
        if (!stepValid) {
          updateStep(step);
          return;
        }
      }
    }

    // Check honeypot
    if (honeypotInput?.value) {
      console.warn('Spam submission detected');
      return;
    }

    // Check minimum time
    const startTime = parseInt(formStartTimeInput?.value || '0');
    if (Date.now() - startTime < VALIDATION_CONFIG.minSubmitTime) {
      showError('Please take your time filling out the form');
      return;
    }

    // Get form data
    const formData = new FormData(form);

    // Add files to form data
    uploadedFiles.forEach((file, index) => {
      formData.append(`projectPhoto${index + 1}`, file);
    });

    // Get endpoint
    const endpoint = form.dataset.formspreeEndpoint;
    if (!endpoint) {
      showError('Form configuration error. Please contact us directly.');
      return;
    }

    // Set loading state
    submitButton.disabled = true;
    submitButton.setAttribute('data-loading', 'true');
    formError.hidden = true;

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json',
        },
      });

      if (response.ok) {
        showSuccess();
      } else {
        const data = await response.json();
        throw new Error(data.error || 'Submission failed');
      }
    } catch (error) {
      showError('An error occurred. Please try again or contact us directly.');
      console.error('Form submission error:', error);
    } finally {
      submitButton.disabled = false;
      submitButton.setAttribute('data-loading', 'false');
    }
  }

  function showError(message: string) {
    formErrorText.textContent = message;
    formError.hidden = false;
    formSuccess.hidden = true;
    formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function showSuccess() {
    formSuccess.hidden = false;
    formError.hidden = true;
    form.reset();
    uploadedFiles = [];
    updateFilePreview();
    updateStep(1);
    formSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Initialize on DOM ready
  init();
</script>
