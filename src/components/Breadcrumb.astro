---
/**
 * Breadcrumb Navigation Component
 * Provides visual breadcrumb navigation and BreadcrumbList schema markup for SEO.
 *
 * Features:
 * - Semantic navigation with proper ARIA labels
 * - BreadcrumbList JSON-LD schema for search engines
 * - Microdata markup for additional SEO support
 * - Responsive design with truncation for long titles
 * - Accessible keyboard navigation
 * - Support for custom breadcrumb items or auto-generation from path
 *
 * @example Basic usage with auto-generated breadcrumbs:
 * ```astro
 * <Breadcrumb currentPath="/services" currentTitle="Services" />
 * ```
 *
 * @example With custom items:
 * ```astro
 * <Breadcrumb
 *   items={[
 *     { name: 'Home', url: '/' },
 *     { name: 'Blog', url: '/blog' },
 *     { name: 'Article Title' }
 *   ]}
 * />
 * ```
 */

import { seoConfig, toAbsoluteUrl, escapeHtml } from '../config/seo.config';

export interface BreadcrumbItem {
  /** Display name of the breadcrumb */
  name: string;
  /** URL of the breadcrumb (optional for the last/current item) */
  url?: string;
}

interface Props {
  /** Custom breadcrumb items (overrides auto-generation) */
  items?: BreadcrumbItem[];
  /** Current page path for auto-generation (e.g., '/services/service-one') */
  currentPath?: string;
  /** Current page title (used as the last breadcrumb item when auto-generating) */
  currentTitle?: string;
  /** Whether to show the home breadcrumb (default: true) */
  showHome?: boolean;
  /** Additional CSS class for the breadcrumb container */
  class?: string;
}

const {
  items,
  currentPath,
  currentTitle,
  showHome = true,
  class: className = '',
} = Astro.props;

/**
 * Path segment to display name mapping for common routes
 */
const pathNameMap: Record<string, string> = {
  'services': 'Services',
  'service-one': 'Service One',
  'service-two': 'Service Two',
  'service-three': 'Service Three',
  'about': 'About',
  'contact': 'Contact',
  'portfolio': 'Portfolio',
  'blog': 'Blog',
  'service-areas': 'Service Areas',
  'service-request': 'Service Request',
  'booking': 'Booking',
  '404': 'Page Not Found',
};

/**
 * Generates breadcrumb items from a URL path
 */
function generateBreadcrumbsFromPath(path: string, pageTitle?: string): BreadcrumbItem[] {
  const breadcrumbs: BreadcrumbItem[] = [];

  // Always start with Home if showHome is true
  if (showHome) {
    breadcrumbs.push({ name: 'Home', url: '/' });
  }

  // If we're on the home page, just return Home
  if (path === '/' || path === '') {
    return breadcrumbs;
  }

  // Split path into segments and filter out empty strings
  const segments = path.split('/').filter(Boolean);

  // Build breadcrumb for each segment
  let currentUrl = '';
  segments.forEach((segment, index) => {
    currentUrl += `/${segment}`;
    const isLast = index === segments.length - 1;

    // Get display name from map or format the segment
    let displayName = pathNameMap[segment.toLowerCase()];
    if (!displayName) {
      // Convert slug to title case (e.g., 'my-page' -> 'My Page')
      displayName = segment
        .split('-')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    }

    // Use provided title for the last item if available
    if (isLast && pageTitle) {
      displayName = pageTitle;
    }

    breadcrumbs.push({
      name: displayName,
      url: isLast ? undefined : currentUrl,
    });
  });

  return breadcrumbs;
}

// Determine the breadcrumb items to use
const breadcrumbItems: BreadcrumbItem[] = items
  ? items
  : generateBreadcrumbsFromPath(currentPath || Astro.url.pathname, currentTitle);

// Generate JSON-LD schema for BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url ? toAbsoluteUrl(item.url, seoConfig.siteUrl) : undefined,
  })),
};

// Don't render if there's only one item (home page)
const shouldRender = breadcrumbItems.length > 1;
---

{shouldRender && (
  <>
    <!-- JSON-LD Schema for BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema, null, 0)} />

    <!-- Visual Breadcrumb Navigation -->
    <nav
      class:list={['breadcrumb', className]}
      aria-label="Breadcrumb navigation"
    >
      <ol
        class="breadcrumb__list"
        itemscope
        itemtype="https://schema.org/BreadcrumbList"
      >
        {breadcrumbItems.map((item, index) => {
          const isLast = index === breadcrumbItems.length - 1;
          const position = index + 1;

          return (
            <>
              <li
                class:list={['breadcrumb__item', { 'breadcrumb__item--current': isLast }]}
                itemprop="itemListElement"
                itemscope
                itemtype="https://schema.org/ListItem"
              >
                {item.url ? (
                  <a
                    href={item.url}
                    class="breadcrumb__link"
                    itemprop="item"
                  >
                    {index === 0 && showHome ? (
                      <>
                        <svg
                          class="breadcrumb__home-icon"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                          width="16"
                          height="16"
                        >
                          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                        </svg>
                        <span class="sr-only" itemprop="name">{item.name}</span>
                      </>
                    ) : (
                      <span itemprop="name">{item.name}</span>
                    )}
                  </a>
                ) : (
                  <span itemprop="name" aria-current="page">{item.name}</span>
                )}
                <meta itemprop="position" content={String(position)} />
              </li>
              {!isLast && (
                <li class="breadcrumb__separator" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    width="16"
                    height="16"
                  >
                    <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                  </svg>
                </li>
              )}
            </>
          );
        })}
      </ol>
    </nav>
  </>
)}

<style>
  /* =================================================================
   * BREADCRUMB COMPONENT STYLES
   * =================================================================
   * Uses design system variables from variables.css
   * Follows BEM naming convention
   */

  .breadcrumb {
    padding: var(--spacing-3) var(--spacing-4);
    background-color: var(--color-background-subtle);
    border-bottom: 1px solid var(--color-border-light);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    max-width: var(--container-7xl);
    margin: 0 auto;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
  }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--spacing-1) var(--spacing-0-5);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-150) var(--ease-in-out),
      background-color var(--duration-150) var(--ease-in-out);
  }

  .breadcrumb__link:hover {
    color: var(--color-primary);
    background-color: var(--color-primary-50);
  }

  .breadcrumb__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    color: var(--color-primary);
  }

  .breadcrumb__home-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .breadcrumb__separator {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
    user-select: none;
  }

  .breadcrumb__separator svg {
    width: 1rem;
    height: 1rem;
  }

  .breadcrumb__item--current {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-medium);
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Screen reader only text */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* =================================================================
   * RESPONSIVE ADJUSTMENTS
   * ================================================================= */

  @media screen and (min-width: 640px) {
    .breadcrumb {
      padding: var(--spacing-3) var(--spacing-6);
    }

    .breadcrumb__list {
      font-size: var(--font-size-base);
    }

    .breadcrumb__item--current {
      max-width: 400px;
    }
  }

  @media screen and (min-width: 1024px) {
    .breadcrumb {
      padding: var(--spacing-4) var(--spacing-8);
    }

    .breadcrumb__item--current {
      max-width: 500px;
    }
  }

  /* =================================================================
   * DARK MODE
   * ================================================================= */

  :global(html[data-theme="dark"]) .breadcrumb {
    background-color: var(--color-background-elevated);
    border-bottom-color: var(--color-border);
  }

  :global(html[data-theme="dark"]) .breadcrumb__link:hover {
    background-color: var(--color-primary-900);
  }

  /* =================================================================
   * REDUCED MOTION
   * ================================================================= */

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb__link {
      transition: none;
    }
  }

  /* =================================================================
   * PRINT STYLES
   * ================================================================= */

  @media print {
    .breadcrumb {
      background: none;
      border: none;
      padding: var(--spacing-2) 0;
    }

    .breadcrumb__link {
      color: var(--color-text-primary);
    }

    .breadcrumb__separator svg {
      display: none;
    }

    .breadcrumb__separator::before {
      content: ' / ';
    }
  }
</style>
